---
import '@/styles/global.css';
import { ClientRouter } from 'astro:transitions';
import { Font } from 'astro:assets';
import {
  DEFAULT_OG_IMAGE,
  DEFAULT_TWITTER_IMAGE,
  getSocialImageType,
  OG_IMAGE_HEIGHT,
  OG_IMAGE_WIDTH,
  SITE_AUTHOR,
  SITE_DESCRIPTION,
  SITE_LOCALE,
  SITE_NAME,
  SITE_URL,
  TWITTER_IMAGE_HEIGHT,
  TWITTER_IMAGE_WIDTH,
} from '@/lib/seo';

interface StructuredData {
  [key: string]: unknown;
}

interface Props {
  title: string;
  description?: string;
  image?: string;
  imageAlt?: string;
  twitterImage?: string;
  twitterImageAlt?: string;
  canonical?: string;
  type?: 'website' | 'article' | 'profile';
  noindex?: boolean;
  publishedTime?: string;
  modifiedTime?: string;
  structuredData?: StructuredData | StructuredData[];
}

const {
  title,
  description = SITE_DESCRIPTION,
  image = DEFAULT_OG_IMAGE,
  imageAlt = title,
  twitterImage = DEFAULT_TWITTER_IMAGE,
  twitterImageAlt = imageAlt,
  canonical,
  type = 'website',
  noindex = false,
  publishedTime,
  modifiedTime,
  structuredData,
} = Astro.props;

const siteBase = Astro.site ?? new URL(SITE_URL);
const canonicalUrl = new URL(canonical || Astro.url.pathname, siteBase).toString();
const ogImageUrl = new URL(image, siteBase).toString();
const ogImageType = getSocialImageType(image);
const twitterImageUrl = new URL(twitterImage, siteBase).toString();
const twitterImageType = getSocialImageType(twitterImage);
const robotsContent = noindex
  ? 'noindex, nofollow'
  : 'index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1';
const schemas = structuredData ? (Array.isArray(structuredData) ? structuredData : [structuredData]) : [];
---

<!doctype html>
<html lang="es" class="scroll-smooth">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="author" content={SITE_AUTHOR} />
    <meta name="robots" content={robotsContent} />
    <meta name="googlebot" content={robotsContent} />
    <meta name="image" content={ogImageUrl} />
    <meta itemprop="name" content={title} />
    <meta itemprop="description" content={description} />
    <meta itemprop="image" content={ogImageUrl} />
    <link rel="canonical" href={canonicalUrl} />
    <link rel="image_src" href={ogImageUrl} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />
    <meta property="og:site_name" content={SITE_NAME} />
    <meta property="og:locale" content={SITE_LOCALE} />
    <meta property="og:type" content={type} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:image:url" content={ogImageUrl} />
    <meta property="og:image:secure_url" content={ogImageUrl} />
    <meta property="og:image:type" content={ogImageType} />
    <meta property="og:image:width" content={String(OG_IMAGE_WIDTH)} />
    <meta property="og:image:height" content={String(OG_IMAGE_HEIGHT)} />
    <meta property="og:image:alt" content={imageAlt} />
    {type === 'article' && <meta property="article:author" content={SITE_AUTHOR} />}
    {type === 'article' && publishedTime && <meta property="article:published_time" content={publishedTime} />}
    {type === 'article' && modifiedTime && <meta property="article:modified_time" content={modifiedTime} />}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:url" content={canonicalUrl} />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={twitterImageUrl} />
    <meta name="twitter:image:src" content={twitterImageUrl} />
    <meta name="twitter:image:alt" content={twitterImageAlt} />
    <meta name="twitter:image:type" content={twitterImageType} />
    <meta name="twitter:image:width" content={String(TWITTER_IMAGE_WIDTH)} />
    <meta name="twitter:image:height" content={String(TWITTER_IMAGE_HEIGHT)} />
    <meta name="theme-color" content="#f4f1eb" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#0f0f0e" media="(prefers-color-scheme: dark)" />
    {schemas.map((schema) => (
      <script type="application/ld+json" set:html={JSON.stringify(schema)}></script>
    ))}
    <!-- Prevent FOUC: apply theme before render -->
    <script is:inline>
      (function() {
        var saved = localStorage.getItem('theme');
        var prefersDark = window.matchMedia('(prefers-color-scheme: dark)').matches;
        if (saved === 'dark' || (!saved && prefersDark)) {
          document.documentElement.classList.add('dark');
        }
      })();
    </script>
    <!-- Critical CSS: inline for fast first paint with font fallback -->
    <style>:root{--color-bg:#f4f1eb;--color-text:#1f1c18;--color-muted:#4a4742;--color-border:#c8c3ba;--theme-colorful:#f4f1eb;--theme-contrasty:#3d3832}*,::before,::after{box-sizing:border-box;margin:0;padding:0}body{background-color:var(--color-bg);color:var(--color-text);line-height:1.5;min-height:100vh;-webkit-font-smoothing:antialiased}h1,h2{line-height:1.05;font-weight:400;letter-spacing:-0.025em}.hero-heading{font-size:clamp(2.5rem,5vw,5.5rem);line-height:1.05}.font-display{font-family:var(--font-display)}.font-mono{font-family:var(--font-mono)}.font-sans{font-family:var(--font-sans)}.text-muted{color:var(--color-muted)}.text-text{color:var(--color-text)}.antialiased{-webkit-font-smoothing:antialiased;-moz-osx-font-smoothing:grayscale}img,video,svg{vertical-align:middle;max-width:100%;height:auto}.avatar{--avatar-black:var(--theme-contrasty);--avatar-white:var(--theme-colorful);--avatar-gray:color-mix(in srgb,var(--theme-colorful) 82%,var(--theme-contrasty) 18%);contain:layout paint style;content-visibility:auto;contain-intrinsic-size:150px 150px;display:block;position:relative;width:100%;height:100%}.avatar__button{display:flex;align-items:center;justify-content:center;border:0;padding:0;background:var(--theme-colorful);overflow:hidden;width:100%;height:100%;cursor:pointer}.avatar__grid{position:absolute;display:grid;gap:0;top:-8px;left:50%;transform:translateX(-50%)}.avatar__tile{width:32px;height:32px;display:block;user-select:none;pointer-events:none;shape-rendering:crispEdges}.avatar svg{image-rendering:pixelated;image-rendering:crisp-edges}@media(max-width:47.999rem){#nav-links a{display:none!important}}</style>
    <!-- Load fonts -->
    <Font cssVariable="--font-display" />
    <Font cssVariable="--font-sans" />
    <Font cssVariable="--font-mono" />
    <ClientRouter />
  </head>
  <body class="text-text antialiased min-h-screen bg-bg relative z-0">
    <!-- Skip to main content link for keyboard users -->
    <a href="#main-content" class="sr-only focus:not-sr-only focus:fixed focus:top-4 focus:left-4 focus:z-[9999] focus:bg-bg focus:text-text focus:px-4 focus:py-2 focus:outline-none focus:ring-2 focus:ring-border">
      Saltar al contenido principal
    </a>

    <!-- Luz tenue desde arriba a la derecha -->
    <div id="light-overlay" class="pointer-events-none fixed inset-0 z-50" style="background: radial-gradient(ellipse 100vw 100vh at 100% 0%, oklab(0.92 0.05 0.08 / 0.45), transparent 60%);"></div>
    <!-- Velo vertical sobre el contenido, debajo del navbar y de la luz -->
    <div id="viewport-gradient" class="pointer-events-none fixed inset-x-0 top-0 h-[100dvh] z-40" style="background: linear-gradient(to bottom, color-mix(in srgb, var(--color-bg) 97%, transparent) 0%, color-mix(in srgb, var(--color-bg) 97%, transparent) 6%, color-mix(in srgb, var(--color-bg) 6%, transparent) 16%, color-mix(in srgb, var(--color-bg) 2%, transparent) 50%, transparent 84%, transparent 100%);"></div>
    <div class="min-h-[100dvh]">
      <slot />
    </div>
  </body>
</html>

<style is:global>
  html {
    --avatar-black: var(--theme-contrasty);
    --avatar-white: var(--theme-colorful);
    --avatar-gray: color-mix(in srgb, var(--theme-colorful) 82%, var(--theme-contrasty) 18%);

    /* Folder surfaces / shadows */
    --folder-base-fill: var(--color-bg);
    --folder-hover-fill: color-mix(in srgb, var(--color-bg) 94%, var(--color-text) 6%);
    --folder-shadow-ink: var(--color-text);
  }

  html.dark {
    --color-bg: #0F0F0E;
    --color-text: #E0DDD8;
    --color-muted: #9B9590;
    --color-subtle: #858280;
    --color-border: #4A4740;

    --folder-base-fill: var(--color-bg);
    --folder-hover-fill: color-mix(in srgb, var(--color-bg) 80%, var(--color-text) 20%);
    --folder-shadow-ink: #000;
    /* Avatar keeps light theme colors */
  }

  html[data-theme-switching='true'] [data-folder-fill-path],
  html[data-theme-switching='true'] [data-folder-svg] {
    transition: none !important;
  }

  @keyframes fade-in {
    from {
      opacity: 0;
      transform: translateY(12px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  @keyframes fadeSlideIn {
    from {
      opacity: 0;
      transform: translateY(16px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  @keyframes fade-out {
    from {
      opacity: 1;
      transform: translateY(0);
    }
    to {
      opacity: 0;
      transform: translateY(-12px);
    }
  }

  ::view-transition-old(root) {
    animation: fade-out 0.15s ease-out forwards;
  }

  ::view-transition-new(root) {
    animation: fade-in 0.2s ease-out forwards;
  }

@media (prefers-reduced-motion: reduce) {
    ::view-transition-old(root),
    ::view-transition-new(root) {
      animation: none;
    }
  }
</style>

<script>
  import '@/scripts/folder-shapes-client';
</script>

<script is:inline>
(function () {
  var themeSwitchTimer = null;

  function withInstantFolderThemeSwitch(fn) {
    var root = document.documentElement;
    root.setAttribute('data-theme-switching', 'true');
    if (themeSwitchTimer) clearTimeout(themeSwitchTimer);

    fn();

    themeSwitchTimer = window.setTimeout(function () {
      root.removeAttribute('data-theme-switching');
      themeSwitchTimer = null;
    }, 120);
  }

  function applyTheme() {
    var saved = localStorage.getItem('theme');
    var prefersDark = window.matchMedia('(prefers-color-scheme: dark)').matches;
    document.documentElement.classList.toggle('dark', saved === 'dark' || (!saved && prefersDark));
  }

  function updateToggleIcons() {
    var toggle = document.getElementById('theme-toggle');
    if (!toggle) return;
    var sunIcon = toggle.querySelector('.sun-icon');
    var moonIcon = toggle.querySelector('.moon-icon');
    if (sunIcon && moonIcon) {
      var isDark = document.documentElement.classList.contains('dark');
      sunIcon.style.display = isDark ? 'block' : 'none';
      moonIcon.style.display = isDark ? 'none' : 'block';
    }
  }

  function restoreScrollPosition() {
    var state = history.state;
    window.scrollTo(0, state?.scrollY ?? 0);
  }

  function initLightOverlay() {
    var overlay = document.getElementById('light-overlay');
    if (!overlay) return;
    function update() {
      overlay.style.opacity = '0.4';
    }
    window.addEventListener('scroll', update, { passive: true });
    update();
  }

  function initNavbarScroll() {
    var header = document.getElementById('site-header');
    var logo = document.getElementById('nav-logo');
    var links = document.getElementById('nav-links');
    if (!header || !logo || !links) return;

    var mql = window.matchMedia('(min-width: 1024px)');
    var reducedMotionMql = window.matchMedia('(prefers-reduced-motion: reduce)');
    function reset() {
      logo.style.transition = 'none';
      links.style.transition = 'none';
      logo.style.transform = 'translateX(0)';
      links.style.transform = 'translateX(0)';
    }

    function handleViewportModeChange() {
      if (!mql.matches || reducedMotionMql.matches) {
        reset();
      }
    }

    handleViewportModeChange();
    if (mql.addEventListener) {
      mql.addEventListener('change', handleViewportModeChange);
    } else if (mql.addListener) {
      mql.addListener(handleViewportModeChange);
    }

    if (reducedMotionMql.addEventListener) {
      reducedMotionMql.addEventListener('change', handleViewportModeChange);
    } else if (reducedMotionMql.addListener) {
      reducedMotionMql.addListener(handleViewportModeChange);
    }

    var lastScrollY = 0;
    var isHidden = false;
    var rafId = null;
    var threshold = 20;
    var navbarExtraOffset = 50;

    // Medir anchos reales para el translate
    var logoWidth = logo.getBoundingClientRect().width + navbarExtraOffset;
    var linksWidth = links.getBoundingClientRect().width + navbarExtraOffset;

    function animate() {
      if (!mql.matches || reducedMotionMql.matches) {
        reset();
        isHidden = false;
        lastScrollY = window.scrollY;
        return;
      }

      var scrollY = window.scrollY;
      var shouldHide = scrollY > threshold && scrollY > lastScrollY && scrollY > 0;
      var isBase = scrollY <= threshold;

      if (shouldHide && !isHidden) {
        logo.style.transform = 'translateX(-' + logoWidth + 'px)';
        logo.style.transition = 'transform 0.25s cubic-bezier(0.4, 0, 0.2, 1)';
        links.style.transform = 'translateX(' + linksWidth + 'px)';
        links.style.transition = 'transform 0.25s cubic-bezier(0.4, 0, 0.2, 1)';
        isHidden = true;
      } else if (isHidden && isBase) {
        logo.style.transform = 'translateX(0)';
        logo.style.transition = 'transform 0.15s cubic-bezier(0.2, 0, 0, 1)';
        links.style.transform = 'translateX(0)';
        links.style.transition = 'transform 0.15s cubic-bezier(0.2, 0, 0, 1)';
        isHidden = false;
      }

      lastScrollY = scrollY;
    }

    window.addEventListener(
      'scroll',
      function () {
        if (rafId) cancelAnimationFrame(rafId);
        rafId = requestAnimationFrame(animate);
      },
      { passive: true }
    );
  }

  function initGlitch() {
    var sequence = ['/', '-', '\\', '|', '/'];
    var tid = null;
    var anim = false;
    var reducedMotionMql = window.matchMedia('(prefers-reduced-motion: reduce)');

    function resetChars(chars) {
      chars.forEach(function (ch) {
        ch.textContent = ch.getAttribute('data-char') || '/';
      });
    }

    var wrapper = document.querySelector('.name-wrapper');
    var glitchChars = document.querySelectorAll('.glitch-char');
    var mobileBtn = document.getElementById('mobile-home-btn');
    var mobileGlitchChars = document.querySelectorAll('.mobile-glitch-char');
    var mobileNameNormal = mobileBtn ? mobileBtn.querySelector('.name-normal') : null;
    var mobileNameHover = mobileBtn ? mobileBtn.querySelector('.name-hover') : null;

    function resetVisualState() {
      if (tid) clearTimeout(tid);
      tid = null;
      anim = false;
      resetChars(glitchChars);
      resetChars(mobileGlitchChars);
      if (mobileNameNormal) mobileNameNormal.classList.remove('is-glitching');
      if (mobileNameHover) mobileNameHover.classList.remove('is-glitching');
    }

    function cycle(chars) {
      if (anim || reducedMotionMql.matches) return;
      anim = true;
      var i = 0;
      var c = 0;

      function next() {
        if (reducedMotionMql.matches) {
          resetVisualState();
          return;
        }

        chars.forEach(function (ch) {
          ch.textContent = sequence[i];
        });
        i = (i + 1) % sequence.length;

        if (i === 0) {
          c++;
          if (c >= 5) {
            resetVisualState();
            return;
          }
        }

        tid = setTimeout(next, 120);
      }

      next();
    }

    function handleReducedMotionChange(event) {
      if (event.matches) resetVisualState();
    }

    if (window.__glitchReducedMotionHandler) {
      if (reducedMotionMql.removeEventListener) {
        reducedMotionMql.removeEventListener('change', window.__glitchReducedMotionHandler);
      } else if (reducedMotionMql.removeListener) {
        reducedMotionMql.removeListener(window.__glitchReducedMotionHandler);
      }
    }

    window.__glitchReducedMotionHandler = handleReducedMotionChange;

    if (reducedMotionMql.addEventListener) {
      reducedMotionMql.addEventListener('change', handleReducedMotionChange);
    } else if (reducedMotionMql.addListener) {
      reducedMotionMql.addListener(handleReducedMotionChange);
    }

    // Desktop: hover effect
    if (wrapper && glitchChars.length) {
      wrapper.addEventListener('mouseenter', function () {
        if (reducedMotionMql.matches) return;
        if (tid) clearTimeout(tid);
        anim = false;
        setTimeout(function () { cycle(glitchChars); }, 250);
      });

      wrapper.addEventListener('mouseleave', resetVisualState);
    }

    // Mobile: click on button triggers glitch on home page
    if (mobileBtn && mobileGlitchChars.length) {
      var isHome = mobileBtn.getAttribute('data-is-home') === 'true';

      if (isHome) {
        mobileBtn.addEventListener('click', function (e) {
          e.preventDefault();
          if (reducedMotionMql.matches) return;

          // Visual transition (same as hover)
          if (mobileNameNormal) mobileNameNormal.classList.add('is-glitching');
          if (mobileNameHover) mobileNameHover.classList.add('is-glitching');

          // Start glitch animation (5 cycles × 5 chars × 120ms = 3000ms + 400ms hang)
          cycle(mobileGlitchChars);

          // Reset visual after animation + hang time
          setTimeout(function () {
            if (reducedMotionMql.matches) {
              resetVisualState();
              return;
            }
            if (mobileNameNormal) mobileNameNormal.classList.remove('is-glitching');
            if (mobileNameHover) mobileNameHover.classList.remove('is-glitching');
          }, 4200);
        });
      } else {
        mobileBtn.addEventListener('click', function () {
          window.location.href = '/';
        });
      }
    }
  }

  function bindThemeToggle() {
    var toggle = document.getElementById('theme-toggle');
    if (!toggle || toggle.dataset.themeBound === 'true') return;
    toggle.dataset.themeBound = 'true';

    toggle.addEventListener('click', function () {
      withInstantFolderThemeSwitch(function () {
        var isDark = document.documentElement.classList.toggle('dark');
        localStorage.setItem('theme', isDark ? 'dark' : 'light');
        updateToggleIcons();
      });
    });
  }

  function init() {
    applyTheme();
    updateToggleIcons();
    restoreScrollPosition();
    initLightOverlay();
    initNavbarScroll();
    initGlitch();
    bindThemeToggle();
  }

  init();
  document.addEventListener('astro:after-swap', init);
})();
</script>

<script is:inline>
// Hover swipe: direction-aware (izq/der)
(function(){
  if (window.__navSwipeDirectionInit) return;
  window.__navSwipeDirectionInit = true;

  var selector = '#nav-links a, #theme-toggle, #contacto a';

  function getSide(el, clientX){
    var r = el.getBoundingClientRect();
    var mid = r.left + (r.width / 2);
    return clientX < mid ? 'left' : 'right';
  }

  function getItemFromEventTarget(target){
    if (!(target instanceof Element)) return null;
    return target.closest(selector);
  }

  // pointerover/out bubble (a diferencia de pointerenter/leave),
  // entonces usamos relatedTarget para filtrar “movimientos internos”.
  document.addEventListener('pointerover', function(e){
    if (e.pointerType && e.pointerType !== 'mouse') return;

    var el = getItemFromEventTarget(e.target);
    if (!el) return;

    var rel = e.relatedTarget;
    if (rel instanceof Node && el.contains(rel)) return;

    el.style.setProperty('--nav-origin-in', getSide(el, e.clientX));
  });

  document.addEventListener('pointerout', function(e){
    if (e.pointerType && e.pointerType !== 'mouse') return;

    var el = getItemFromEventTarget(e.target);
    if (!el) return;

    var rel = e.relatedTarget;
    if (rel instanceof Node && el.contains(rel)) return;

    el.style.setProperty('--nav-origin-out', getSide(el, e.clientX));
  });
})();
</script>
