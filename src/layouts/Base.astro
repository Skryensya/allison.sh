---
import '@/styles/global.css';
import clientModules from '@/generated/client-modules.json';
import clashGrotesk400 from '@/assets/fonts/clash-grotesk-400.woff2';
import satoshi400 from '@/assets/fonts/satoshi-400.woff2';
import satoshi500 from '@/assets/fonts/satoshi-500.woff2';
import {
  DEFAULT_OG_IMAGE,
  DEFAULT_TWITTER_IMAGE,
  getSocialImageType,
  OG_IMAGE_HEIGHT,
  OG_IMAGE_WIDTH,
  SITE_AUTHOR,
  SITE_DESCRIPTION,
  SITE_LOCALE,
  SITE_NAME,
  SITE_URL,
  TWITTER_IMAGE_HEIGHT,
  TWITTER_IMAGE_WIDTH,
} from '@/lib/seo';

interface StructuredData {
  [key: string]: unknown;
}

interface Props {
  title: string;
  description?: string;
  image?: string;
  imageAlt?: string;
  twitterImage?: string;
  twitterImageAlt?: string;
  canonical?: string;
  type?: 'website' | 'article' | 'profile';
  noindex?: boolean;
  publishedTime?: string;
  modifiedTime?: string;
  structuredData?: StructuredData | StructuredData[];
}

const {
  title,
  description = SITE_DESCRIPTION,
  image = DEFAULT_OG_IMAGE,
  imageAlt = title,
  twitterImage = DEFAULT_TWITTER_IMAGE,
  twitterImageAlt = imageAlt,
  canonical,
  type = 'website',
  noindex = false,
  publishedTime,
  modifiedTime,
  structuredData,
} = Astro.props;

const siteBase = Astro.site ?? new URL(SITE_URL);
const canonicalUrl = new URL(canonical || Astro.url.pathname, siteBase).toString();
const ogImageUrl = new URL(image, siteBase).toString();
const ogImageType = getSocialImageType(image);
const twitterImageUrl = new URL(twitterImage, siteBase).toString();
const twitterImageType = getSocialImageType(twitterImage);
const robotsContent = noindex
  ? 'noindex, nofollow'
  : 'index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1';
const schemas = structuredData ? (Array.isArray(structuredData) ? structuredData : [structuredData]) : [];
---

<!doctype html>
<html
  lang="es"
  class="scroll-smooth"
  data-base-client-url={clientModules['base-client']}
  data-folder-shapes-client-url={clientModules['folder-shapes-client']}
>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="author" content={SITE_AUTHOR} />
    <meta name="robots" content={robotsContent} />
    <meta name="googlebot" content={robotsContent} />
    <meta name="image" content={ogImageUrl} />
    <meta itemprop="name" content={title} />
    <meta itemprop="description" content={description} />
    <meta itemprop="image" content={ogImageUrl} />
    <link rel="canonical" href={canonicalUrl} />
    <link rel="image_src" href={ogImageUrl} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />
    <meta property="og:site_name" content={SITE_NAME} />
    <meta property="og:locale" content={SITE_LOCALE} />
    <meta property="og:type" content={type} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:image:url" content={ogImageUrl} />
    <meta property="og:image:secure_url" content={ogImageUrl} />
    <meta property="og:image:type" content={ogImageType} />
    <meta property="og:image:width" content={String(OG_IMAGE_WIDTH)} />
    <meta property="og:image:height" content={String(OG_IMAGE_HEIGHT)} />
    <meta property="og:image:alt" content={imageAlt} />
    {type === 'article' && <meta property="article:author" content={SITE_AUTHOR} />}
    {type === 'article' && publishedTime && <meta property="article:published_time" content={publishedTime} />}
    {type === 'article' && modifiedTime && <meta property="article:modified_time" content={modifiedTime} />}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:url" content={canonicalUrl} />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={twitterImageUrl} />
    <meta name="twitter:image:src" content={twitterImageUrl} />
    <meta name="twitter:image:alt" content={twitterImageAlt} />
    <meta name="twitter:image:type" content={twitterImageType} />
    <meta name="twitter:image:width" content={String(TWITTER_IMAGE_WIDTH)} />
    <meta name="twitter:image:height" content={String(TWITTER_IMAGE_HEIGHT)} />
    <meta name="theme-color" content="#f4f1eb" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#0f0f0e" media="(prefers-color-scheme: dark)" />
    {schemas.map((schema) => (
      <script is:inline type="application/ld+json" set:html={JSON.stringify(schema)}></script>
    ))}
    <!-- Prevent FOUC: apply theme before render -->
    <script is:inline>
      (function() {
        var saved = localStorage.getItem('theme');
        var prefersDark = window.matchMedia('(prefers-color-scheme: dark)').matches;
        if (saved === 'dark' || (!saved && prefersDark)) {
          document.documentElement.classList.add('dark');
        }
      })();
    </script>
    <!-- Critical CSS: inline for fast first paint with font fallback -->
    <style>:root{--color-bg:#f4f1eb;--color-text:#1f1c18;--color-muted:#4a4742;--color-border:#c8c3ba;--theme-colorful:#f4f1eb;--theme-contrasty:#3d3832}*,::before,::after{box-sizing:border-box;margin:0;padding:0}html{font-family:Inter,ui-sans-serif,system-ui,-apple-system,BlinkMacSystemFont,"Segoe UI",sans-serif;font-size-adjust:.52}body{background-color:var(--color-bg);color:var(--color-text);line-height:1.5;min-height:100vh;-webkit-font-smoothing:antialiased}h1,h2{line-height:1.05;font-weight:400;letter-spacing:-0.025em}.hero-heading{font-size:clamp(2rem,4vw,4.25rem);line-height:1.04;letter-spacing:-0.03em}.font-display{font-family:"Arial Narrow","Helvetica Neue",Arial,sans-serif;font-size-adjust:.5}.font-mono{font-family:"Spline Sans Mono","SFMono-Regular",ui-monospace,SFMono-Regular,Menlo,Monaco,Consolas,"Liberation Mono",monospace;font-size-adjust:.5}.font-sans{font-family:Inter,ui-sans-serif,system-ui,-apple-system,BlinkMacSystemFont,"Segoe UI",sans-serif;font-size-adjust:.52}.text-muted{color:var(--color-muted)}.text-text{color:var(--color-text)}.antialiased{-webkit-font-smoothing:antialiased;-moz-osx-font-smoothing:grayscale}img,video,svg{vertical-align:middle;max-width:100%;height:auto}@media(max-width:47.999rem){#nav-links a{display:none!important}}</style>
    <!-- Preload local fonts -->
    <link rel="preload" href={clashGrotesk400} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={satoshi400} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={satoshi500} as="font" type="font/woff2" crossorigin />
  </head>
  <body class="text-text antialiased min-h-screen bg-bg relative z-0">
    <!-- Skip to main content link for keyboard users -->
    <a href="#main-content" class="sr-only focus:not-sr-only focus:fixed focus:top-4 focus:left-4 focus:z-[9999] focus:bg-bg focus:text-text focus:px-4 focus:py-2 focus:outline-none focus:ring-2 focus:ring-border">
      Saltar al contenido principal
    </a>

    <!-- Luz tenue desde arriba a la derecha -->
    <div id="light-overlay" class="pointer-events-none fixed inset-0 z-50" style="opacity: 0.4; background: radial-gradient(ellipse 100vw 100vh at 100% 0%, oklab(0.92 0.05 0.08 / 0.45), transparent 60%);"></div>
    <!-- Velo vertical sobre el contenido, debajo del navbar y de la luz -->
    <div id="viewport-gradient" class="pointer-events-none fixed inset-x-0 top-0 h-[100dvh] z-40"></div>
    <div class="min-h-[100dvh]">
      <slot />
    </div>
  </body>
</html>

<style is:global>
  html {
    --avatar-black: var(--theme-contrasty);
    --avatar-white: var(--theme-colorful);
    --avatar-gray: color-mix(in srgb, var(--theme-colorful) 82%, var(--theme-contrasty) 18%);

    /* Folder surfaces / shadows */
    --folder-base-fill: var(--color-bg);
    --folder-hover-fill-top: color-mix(in srgb, var(--color-bg) 87%, var(--color-text) 13%);
    --folder-hover-fill-bottom: var(--color-bg);
    --folder-shadow-ink: var(--color-text);
  }

  html.dark {
    --color-bg: #0F0F0E;
    --color-text: #E0DDD8;
    --color-muted: #9B9590;
    --color-subtle: #858280;
    --color-border: #4A4740;

    --folder-base-fill: var(--color-bg);
    --folder-hover-fill-top: color-mix(in srgb, var(--color-bg) 62%, var(--color-text) 38%);
    --folder-hover-fill-bottom: var(--color-bg);
    --folder-shadow-ink: #000;
    /* Avatar keeps light theme colors */
  }

  html[data-theme-switching='true'] [data-folder-fill-path],
  html[data-theme-switching='true'] [data-folder-svg] {
    transition: none !important;
  }

  @keyframes fade-in {
    from {
      opacity: 0;
      transform: translateY(12px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  @keyframes fadeSlideIn {
    from {
      opacity: 0;
      transform: translateY(16px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  @keyframes fade-out {
    from {
      opacity: 1;
      transform: translateY(0);
    }
    to {
      opacity: 0;
      transform: translateY(-12px);
    }
  }

  ::view-transition-old(root) {
    animation: fade-out 0.15s ease-out forwards;
  }

  ::view-transition-new(root) {
    animation: fade-in 0.2s ease-out forwards;
  }

@media (prefers-reduced-motion: reduce) {
    ::view-transition-old(root),
    ::view-transition-new(root) {
      animation: none;
    }
  }
</style>

<script is:inline>

  const injectedBaseClientUrl = document.documentElement.dataset.baseClientUrl;
  const injectedFolderShapesClientUrl = document.documentElement.dataset.folderShapesClientUrl;

  let baseClientPromise;
  let folderShapesClientPromise;

  const loadBaseClient = () => {
    if (!injectedBaseClientUrl) return baseClientPromise;
    baseClientPromise ??= import(injectedBaseClientUrl);
    return baseClientPromise;
  };

  const loadFolderShapesClient = () => {
    if (!document.querySelector('[data-folder]') || !injectedFolderShapesClientUrl) return folderShapesClientPromise;
    folderShapesClientPromise ??= import(injectedFolderShapesClientUrl);
    return folderShapesClientPromise;
  };

  const scheduleBaseClient = () => {
    const boot = () => {
      void loadBaseClient();
    };

    if ('requestIdleCallback' in window) {
      window.requestIdleCallback(boot, { timeout: 1200 });
      return;
    }

    window.setTimeout(boot, 280);
  };

  const observeFolders = () => {
    const folders = document.querySelectorAll('[data-folder]');
    if (!folders.length) return;

    if (!('IntersectionObserver' in window)) {
      window.setTimeout(() => {
        void loadFolderShapesClient();
      }, 320);
      return;
    }

    const observer = new IntersectionObserver(
      (entries) => {
        if (!entries.some((entry) => entry.isIntersecting)) return;
        observer.disconnect();
        void loadFolderShapesClient();
      },
      {
        rootMargin: '240px 0px',
        threshold: 0.01,
      }
    );

    folders.forEach((folder) => observer.observe(folder));
  };

  observeFolders();

  if (document.readyState === 'complete') {
    scheduleBaseClient();
  } else {
    window.addEventListener('load', scheduleBaseClient, { once: true });
  }

  window.addEventListener('pointerdown', () => {
    void loadBaseClient();
  }, { once: true, passive: true });

  window.addEventListener('keydown', () => {
    void loadBaseClient();
  }, { once: true });

  document.addEventListener('astro:page-load', () => {
    observeFolders();
  });
</script>
