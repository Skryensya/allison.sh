---
import Base from './Base.astro';
import Navbar from '@/components/Navbar.astro';
import Footer from '@/components/Footer.astro';
import { getOgImagePath, getTwitterImagePath } from '@/lib/seo';

interface StructuredData {
  [key: string]: unknown;
}

interface Props {
  title: string;
  description: string;
  slug: string;
  year?: string;
  structuredData?: StructuredData | StructuredData[];
}

const { title, description, slug, year, structuredData } = Astro.props;
const publishedTime = year ? `${year}-01-01` : undefined;
---

<Base
  title={`${title} | Allison Peña`}
  description={description}
  image={getOgImagePath(slug)}
  imageAlt={`Vista previa del proyecto ${title}`}
  twitterImage={getTwitterImagePath(slug)}
  twitterImageAlt={`Vista previa en X del proyecto ${title}`}
  canonical={`/proyectos/${slug}`}
  type="article"
  publishedTime={publishedTime}
  structuredData={structuredData}
>
  <Navbar />

  <main id="main-content" class="pb-10 md:pb-16">

    <div class="max-w-[42rem] mx-auto px-6 md:px-8 pt-10 md:pt-12">
      <a href="/" class="group inline-flex items-center gap-2 font-mono text-sm tracking-wide text-muted hover:text-text transition-colors duration-200 mb-8 md:mb-10">
        <svg class="w-3 h-3 motion-safe:transition-transform motion-safe:duration-150 motion-safe:group-hover:-translate-x-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7" />
        </svg>
        volver al inicio
      </a>

      <header class="project-header mb-10 md:mb-12">
        <div class="flex items-start justify-between gap-6">
          <h1 class="font-sans text-[1.85rem] md:text-[2.15rem] leading-[1.08] tracking-[-0.028em] text-text max-w-[18rem]">
            {title}
          </h1>
          {year && <span class="font-mono text-sm tracking-wide text-muted shrink-0 pt-2 tabular-nums">{year}</span>}
        </div>
      </header>
    </div>

    <div class="max-w-[42rem] mx-auto px-6 md:px-8 relative z-30">
      <article class="project-article font-sans text-[16px] leading-[1.6] text-text tracking-[-0.01em]">
        <slot />
      </article>

      <slot name="after-article" />

      <footer class="mt-12 md:mt-14 mb-8">
        <a href="/" class="group inline-flex items-center gap-2 font-mono text-sm tracking-wide text-muted hover:text-text transition-colors duration-200">
          <svg class="w-3 h-3 motion-safe:transition-transform motion-safe:duration-150 motion-safe:group-hover:-translate-x-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7" />
          </svg>
          volver al inicio
        </a>
      </footer>

      <Footer />
    </div>

    <style>
      .project-article :global(h2) {
        font-family: var(--font-sans);
        font-size: 1.125rem;
        font-weight: 500;
        letter-spacing: -0.02em;
        line-height: 1.35;
        color: var(--color-text);
        margin-top: 3.25rem;
        margin-bottom: 1.125rem;
      }

      .project-article :global(h2:first-child) {
        margin-top: 0;
      }

      .project-article :global(p) {
        color: var(--color-text);
        line-height: 1.6;
      }

      .project-article :global(p + p) {
        margin-top: 1.25rem;
      }

      /* Exclude folder stack: same ul.project-folder-stack as home — prose ul rules would indent/bleed it wrong */
      .project-article :global(ul:not(.project-folder-stack)) {
        margin-top: 1rem;
        margin-bottom: 1rem;
        list-style-type: disc;
        padding-left: 1.5rem;
      }

      .project-article :global(ul:not(.project-folder-stack) li) {
        color: var(--color-text);
        line-height: 1.6;
        margin-top: 0.375rem;
      }

      .project-article :global(ul:not(.project-folder-stack) li:first-child) {
        margin-top: 0;
      }

      .project-article :global(blockquote) {
        border-left: 2px solid var(--color-border);
        padding-left: 1.25rem;
        margin: 1.5rem 0;
        color: var(--color-muted);
        font-style: italic;
        line-height: 1.6;
      }

      .project-article :global(strong) {
        font-weight: 600;
        color: var(--color-text);
      }
    </style>

  </main>
</Base>
