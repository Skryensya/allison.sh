---
import Base from './Base.astro';
import Navbar from '@/components/Navbar.astro';
import Footer from '@/components/Footer.astro';
import { getOgImagePath, getTwitterImagePath } from '@/lib/seo';

interface StructuredData {
  [key: string]: unknown;
}

interface Props {
  title: string;
  description: string;
  slug: string;
  year?: string;
  accent?: string;
  structuredData?: StructuredData | StructuredData[];
}

const { title, description, slug, year, accent = 'var(--color-link)', structuredData } = Astro.props;
const publishedTime = year ? `${year}-01-01` : undefined;
const mainStyle = `--project-page-accent:${accent}`;
---

<Base
  title={`${title} | Allison Peña`}
  description={description}
  image={getOgImagePath(slug)}
  imageAlt={`Vista previa del proyecto ${title}`}
  twitterImage={getTwitterImagePath(slug)}
  twitterImageAlt={`Vista previa en X del proyecto ${title}`}
  canonical={`/proyectos/${slug}`}
  type="article"
  publishedTime={publishedTime}
  structuredData={structuredData}
>
  <Navbar />

  <main
    id="main-content"
    class="project-page-shell relative pb-10 md:pb-16"
    style={mainStyle}
    data-project-page-shell
  >
    <div class="project-page-glow" data-project-page-glow aria-hidden="true">
      <span class="project-page-glow__lick project-page-glow__lick--a"></span>
      <span class="project-page-glow__lick project-page-glow__lick--b"></span>
      <span class="project-page-glow__lick project-page-glow__lick--c"></span>
    </div>

    <div class="relative z-30 max-w-[42rem] mx-auto px-6 md:px-8 pt-10 md:pt-12">
      <a href="/" class="group inline-flex items-center gap-2 font-mono text-sm tracking-wide text-muted hover:text-text transition-colors duration-200 mb-8 md:mb-10">
        <svg class="w-3 h-3 motion-safe:transition-transform motion-safe:duration-150 motion-safe:group-hover:-translate-x-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7" />
        </svg>
        volver al inicio
      </a>

      <header class="project-header mb-10 md:mb-12">
        <div class="flex items-start justify-between gap-6">
          <h1 class="font-sans text-[1.85rem] md:text-[2.15rem] leading-[1.08] tracking-[-0.028em] text-text max-w-[18rem]">
            {title}
          </h1>
          {year && <span class="font-mono text-sm tracking-wide text-muted shrink-0 pt-2 tabular-nums">{year}</span>}
        </div>
      </header>
    </div>

    <div class="max-w-[42rem] mx-auto px-6 md:px-8 relative">
      <article class="project-article relative z-30 font-sans text-[16px] leading-[1.6] text-text tracking-[-0.01em] select-none">
        <div class="select-text">
        <slot />
        </div>
      </article>

      <div data-after-article class="relative z-10 select-none">
        <slot name="after-article" />
      </div>

      <footer class="relative z-30 mt-12 md:mt-14 mb-8">
        <a href="/" class="group inline-flex items-center gap-2 font-mono text-sm tracking-wide text-muted hover:text-text transition-colors duration-200">
          <svg class="w-3 h-3 motion-safe:transition-transform motion-safe:duration-150 motion-safe:group-hover:-translate-x-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7" />
          </svg>
          volver al inicio
        </a>
      </footer>

      <div class="relative z-30">
        <Footer />
      </div>
    </div>

    <script is:inline>
      (function () {
        function initProjectGlow() {
          var shell = document.querySelector('[data-project-page-shell]');
          if (!shell) return;
          var reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
          if (reduceMotion.matches) {
            shell.style.setProperty('--project-page-glow-opacity', '0');
            return;
          }

          var raf = 0;

          function clamp(value, min, max) {
            return Math.min(max, Math.max(min, value));
          }

          function smoothstep(value) {
            var t = clamp(value, 0, 1);
            return t * t * (3 - 2 * t);
          }

          function update() {
            raf = 0;
            var doc = document.documentElement;
            var maxScroll = Math.max(1, doc.scrollHeight - window.innerHeight);
            var progress = clamp((window.scrollY || window.pageYOffset || 0) / maxScroll, 0, 1);
            var stage = smoothstep(progress);
            var isDark = doc.classList.contains('dark');
            var maxOpacity = isDark ? 0.56 : 0.38;
            var baseOpacity = isDark ? 0.26 : 0.16;

            shell.style.setProperty('--project-page-glow-opacity', (baseOpacity + stage * (maxOpacity - baseOpacity)).toFixed(3));
            shell.style.setProperty('--project-page-glow-scale', (0.98 + stage * 0.09).toFixed(3));
            shell.style.setProperty('--project-page-glow-rise', (stage * -8).toFixed(2) + 'vh');
            shell.style.setProperty('--project-page-glow-rise-soft', (stage * -4).toFixed(2) + 'vh');
            shell.style.setProperty('--project-page-glow-drift', ((stage - 0.5) * 24).toFixed(1) + 'px');
            shell.style.setProperty('--project-page-glow-core-opacity', (isDark ? 0.58 + stage * 0.16 : 0.46 + stage * 0.14).toFixed(3));
            shell.style.setProperty('--project-page-glow-veil-opacity', (isDark ? 0.34 + stage * 0.16 : 0.25 + stage * 0.14).toFixed(3));
            shell.style.setProperty('--project-page-glow-lick-opacity', (isDark ? 0.3 + stage * 0.14 : 0.22 + stage * 0.1).toFixed(3));
          }

          function schedule() {
            if (raf) return;
            raf = window.requestAnimationFrame(update);
          }

          update();
          window.addEventListener('scroll', schedule, { passive: true });
          window.addEventListener('resize', schedule);

          var themeObserver = new MutationObserver(schedule);
          themeObserver.observe(document.documentElement, { attributes: true, attributeFilter: ['class'] });

          window.addEventListener('pagehide', function () {
            if (raf) window.cancelAnimationFrame(raf);
            themeObserver.disconnect();
          }, { once: true });
        }

        function init() {
          initProjectGlow();

          var figures = document.querySelectorAll('[data-figure-root]');
          if (!figures.length) return;

          // Assign staggered sides, fade in with delay
          figures.forEach(function (fig, i) {
            var frame = fig.querySelector('[data-figure-frame]');
            if (frame) frame.style.transitionDelay = (i * 150) + 'ms';
            fig.dataset.side = i % 2 === 0 ? 'right' : 'left';
          });

          var isOpen = false;
          var overlay = null;
          var closeButton = null;
          var flyingClone = null;
          var activeFrame = null;
          var onKeyDown = null;
          var reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)');

          function getOverlay() {
            if (overlay) return overlay;
            overlay = document.createElement('div');
            overlay.className =
              'lightbox-overlay fixed inset-0 z-[250] opacity-0 pointer-events-none transition-opacity duration-[240ms] ease-out data-[open]:opacity-100 data-[open]:pointer-events-auto motion-reduce:transition-none';
            overlay.setAttribute('aria-hidden', 'true');
            overlay.innerHTML = [
              '<span class="lightbox-overlay__shade"></span>',
              '<span class="lightbox-overlay__shader lightbox-overlay__shader--a"></span>',
              '<span class="lightbox-overlay__shader lightbox-overlay__shader--b"></span>',
              '<span class="lightbox-overlay__grain"></span>'
            ].join('');
            document.body.appendChild(overlay);
            overlay.addEventListener('click', closeExpanded);
            return overlay;
          }

          function getCloseButton() {
            if (closeButton) return closeButton;
            closeButton = document.createElement('button');
            closeButton.setAttribute('type', 'button');
            closeButton.setAttribute('data-lightbox-close', '');
            closeButton.setAttribute('aria-label', 'Cerrar imagen');
            closeButton.className =
              'group fixed top-5 right-5 z-[270] inline-flex h-11 w-11 items-center justify-center rounded-full border border-[color:color-mix(in_srgb,var(--color-text)_18%,transparent)] bg-[color:color-mix(in_srgb,var(--color-bg)_72%,transparent)] text-[color:color-mix(in_srgb,var(--color-text)_76%,transparent)] opacity-0 pointer-events-none select-none shadow-[0_10px_30px_color-mix(in_srgb,var(--color-text)_8%,transparent),0_1px_0_color-mix(in_srgb,var(--color-bg)_65%,transparent)_inset] backdrop-blur-md supports-[backdrop-filter]:bg-[color:color-mix(in_srgb,var(--color-bg)_58%,transparent)] transition-[opacity,color,border-color,background-color,transform,box-shadow] duration-150 ease-out data-[open]:opacity-100 data-[open]:pointer-events-auto hover:border-[color:color-mix(in_srgb,var(--color-text)_30%,transparent)] hover:bg-[color:color-mix(in_srgb,var(--color-bg)_52%,transparent)] hover:text-[var(--color-text)] hover:shadow-[0_14px_36px_color-mix(in_srgb,var(--color-text)_10%,transparent),0_1px_0_color-mix(in_srgb,var(--color-bg)_72%,transparent)_inset] active:scale-[0.96] focus-visible:border-[color:color-mix(in_srgb,var(--color-text)_38%,transparent)] focus-visible:text-[var(--color-text)] focus-visible:outline focus-visible:outline-1 focus-visible:outline-[color:color-mix(in_srgb,var(--color-text)_24%,transparent)] focus-visible:outline-offset-[4px] motion-reduce:transition-none';
            closeButton.innerHTML = '<span aria-hidden="true" class="pointer-events-none inline-flex items-center justify-center transition-transform duration-150 ease-out motion-reduce:transition-none group-active:scale-[0.96]"><svg width="14" height="14" viewBox="0 0 12 12" fill="none" xmlns="http://www.w3.org/2000/svg"><path d="M2 2l8 8M10 2L2 10" stroke="currentColor" stroke-width="1.25" stroke-linecap="round"/></svg></span>';
            closeButton.addEventListener('click', function (e) {
              e.stopPropagation();
              closeExpanded();
            });
            document.body.appendChild(closeButton);
            return closeButton;
          }

          function getExpandedMetrics(frame) {
            var sourceRect = frame.getBoundingClientRect();
            var measure = frame.cloneNode(true);
            measure.classList.add('is-flying');
            measure.style.cssText = [
              'position:fixed',
              'top:0',
              'left:0',
              'width:min(92vw, 900px)',
              'margin:0',
              'z-index:-1',
              'opacity:0',
              'pointer-events:none',
              'transform:none',
              'transition:none',
            ].join(';');
            document.body.appendChild(measure);

            var media = measure.querySelector('[data-figure-media]');
            var caption = measure.querySelector('[data-figure-caption]');
            var imageAspect = media.offsetHeight / media.offsetWidth;
            var captionH = caption ? caption.offsetHeight : 0;
            var isMobile = window.innerWidth < 768;
            var maxW = isMobile ? window.innerWidth * 0.92 : Math.min(window.innerWidth * 0.72, 900);
            var maxWidthFromHeight = (window.innerHeight * 0.85 - captionH) / imageAspect;
            var width = Math.max(sourceRect.width, Math.min(maxW, maxWidthFromHeight));
            measure.style.width = width + 'px';
            var height = measure.offsetHeight;
            measure.remove();

            return {
              sourceRect: sourceRect,
              targetWidth: width,
              targetHeight: height,
              targetLeft: (window.innerWidth - width) / 2,
              targetTop: Math.max(isMobile ? 64 : 32, (window.innerHeight - height) / 2),
            };
          }

          function openExpanded(frame) {
            if (isOpen) return;
            isOpen = true;
            activeFrame = frame;

            var metrics = getExpandedMetrics(frame);
            var rect = metrics.sourceRect;

            var ov = getOverlay();
            requestAnimationFrame(function () {
              ov.setAttribute('data-open', '');
            });

            var clone = frame.cloneNode(true);
            clone.classList.add('is-flying');
            clone.style.cssText = [
              'position:fixed',
              'top:' + metrics.targetTop + 'px',
              'left:' + metrics.targetLeft + 'px',
              'width:' + metrics.targetWidth + 'px',
              'margin:0',
              'z-index:260',
              'opacity:1',
              'transform-origin:top left',
              'will-change:transform,opacity',
              'transition:none',
              'transition-delay:0ms',
            ].join(';');

            var startX = rect.left - metrics.targetLeft;
            var startY = rect.top - metrics.targetTop;
            var startScale = rect.width / metrics.targetWidth;
            clone.style.transform = 'translate3d(' + startX + 'px, ' + startY + 'px, 0) scale(' + startScale + ')';
            document.body.appendChild(clone);
            flyingClone = clone;

            var closeBtn = getCloseButton();
            closeBtn.setAttribute('data-open', '');

            frame.style.transition = 'none';
            frame.style.opacity = '0';

            var shouldReduce = reduceMotion.matches;
            var ease = 'cubic-bezier(0.19, 1, 0.22, 1)';
            var dur = shouldReduce ? '1ms' : '360ms';

            requestAnimationFrame(function () {
              clone.style.transition = [
                'transform ' + dur + ' ' + ease,
                'opacity ' + dur + ' ease-out'
              ].join(',');
              clone.style.transform = 'translate3d(0, 0, 0) scale(1)';
              closeBtn.focus();
            });

            onKeyDown = function (e) { if (e.key === 'Escape') closeExpanded(); };
            document.addEventListener('keydown', onKeyDown);
            var scrollbarWidth = window.innerWidth - document.documentElement.clientWidth;
            document.body.style.paddingRight = scrollbarWidth + 'px';
            document.documentElement.style.overflow = 'hidden';
          }

          function closeExpanded() {
            if (!isOpen || !flyingClone || !activeFrame) return;

            var clone = flyingClone;
            var frame = activeFrame;
            var ov = overlay;
            var closeBtn = closeButton;
            var shouldReduce = reduceMotion.matches;

            if (closeBtn) closeBtn.removeAttribute('data-open');

            frame.style.transition = shouldReduce ? 'opacity 1ms linear' : 'opacity 140ms ease-out';
            frame.style.transitionDelay = shouldReduce ? '0ms' : '140ms';
            frame.style.opacity = '';

            if (ov) ov.removeAttribute('data-open');

            var origRect = frame.getBoundingClientRect();
            var cloneRect = clone.getBoundingClientRect();
            var endX = origRect.left - cloneRect.left;
            var endY = origRect.top - cloneRect.top;
            var endScale = origRect.width / cloneRect.width;
            var easeOut = 'cubic-bezier(0.19, 1, 0.22, 1)';
            var dur = shouldReduce ? '1ms' : '380ms';

            clone.style.transition = [
              'transform ' + dur + ' ' + easeOut,
              'opacity ' + (shouldReduce ? '1ms linear' : '160ms ease-out 180ms')
            ].join(',');
            clone.style.transform = 'translate3d(' + endX + 'px, ' + endY + 'px, 0) scale(' + endScale + ')';
            clone.style.opacity = shouldReduce ? '0' : '0.08';

            function cleanup() {
              clone.remove();
              frame.style.transition = 'none';
              frame.style.transitionDelay = '';
              requestAnimationFrame(function () {
                frame.style.transition = '';
              });
              frame.focus();
              document.documentElement.style.overflow = '';
              document.body.style.paddingRight = '';
              isOpen = false;
              flyingClone = null;
              activeFrame = null;
            }

            function onTransitionEnd(e) {
              if (e.propertyName !== 'transform') return;
              clone.removeEventListener('transitionend', onTransitionEnd);
              cleanup();
            }

            if (shouldReduce) {
              requestAnimationFrame(cleanup);
            } else {
              clone.addEventListener('transitionend', onTransitionEnd);
            }

            if (onKeyDown) {
              document.removeEventListener('keydown', onKeyDown);
              onKeyDown = null;
            }
          }

          figures.forEach(function (fig) {
            var frame = fig.querySelector('[data-figure-frame]');
            if (!frame) return;
            frame.setAttribute('tabindex', '0');
            frame.setAttribute('role', 'button');
            frame.setAttribute('aria-label', 'Ampliar imagen');
            frame.addEventListener('click', function () { openExpanded(frame); });
            frame.addEventListener('keydown', function (e) {
              if (e.key === 'Enter' || e.key === ' ') {
                e.preventDefault();
                openExpanded(frame);
              }
            });
          });
        }

        if (document.readyState === 'loading') {
          document.addEventListener('DOMContentLoaded', init);
        } else {
          init();
        }
      })();
    </script>

    <style>
      .project-page-shell {
        isolation: isolate;
        --project-page-glow-opacity: 0.16;
        --project-page-glow-scale: 0.98;
        --project-page-glow-rise: 0vh;
        --project-page-glow-rise-soft: 0vh;
        --project-page-glow-drift: 0px;
        --project-page-glow-core-opacity: 0.46;
        --project-page-glow-veil-opacity: 0.25;
        --project-page-glow-lick-opacity: 0.22;
      }

      .project-page-glow {
        position: fixed;
        left: 50%;
        bottom: -14vh;
        z-index: 20;
        width: 100vw;
        height: min(74vh, 720px);
        opacity: var(--project-page-glow-opacity);
        pointer-events: none;
        transform: translate3d(-50%, 0, 0) scale(var(--project-page-glow-scale));
        transform-origin: 50% 100%;
        transition:
          opacity 160ms ease,
          transform 220ms cubic-bezier(0.23, 1, 0.32, 1);
        will-change: opacity, transform;
      }

      .project-page-glow::before,
      .project-page-glow::after {
        content: '';
        position: absolute;
        left: 50%;
        bottom: 0;
        pointer-events: none;
        will-change: opacity, transform;
      }

      .project-page-glow::before {
        width: min(220vw, 2200px);
        height: 100%;
        background:
          radial-gradient(
            ellipse at 50% 100%,
            color-mix(in srgb, var(--project-page-accent) 44%, transparent) 0%,
            color-mix(in srgb, var(--project-page-accent) 25%, transparent) 22%,
            color-mix(in srgb, var(--project-page-accent) 9%, transparent) 56%,
            transparent 84%
          ),
          radial-gradient(
            ellipse at 4% 100%,
            color-mix(in srgb, var(--project-page-accent) 14%, transparent) 0%,
            color-mix(in srgb, var(--project-page-accent) 7%, transparent) 44%,
            transparent 74%
          ),
          radial-gradient(
            ellipse at 96% 100%,
            color-mix(in srgb, var(--project-page-accent) 14%, transparent) 0%,
            color-mix(in srgb, var(--project-page-accent) 7%, transparent) 44%,
            transparent 74%
          ),
          linear-gradient(
            to top,
            color-mix(in srgb, var(--project-page-accent) 7%, transparent) 0%,
            color-mix(in srgb, var(--project-page-accent) 3%, transparent) 38%,
            transparent 72%
          );
        filter: blur(18px);
        opacity: var(--project-page-glow-core-opacity);
        animation: projectPageGlowFireCore 4.9s ease-in-out infinite;
      }

      .project-page-glow::after {
        bottom: -2vh;
        width: min(176vw, 1760px);
        height: 78%;
        background:
          radial-gradient(
            ellipse at 50% 100%,
            color-mix(in srgb, var(--project-page-accent) 28%, transparent) 0%,
            color-mix(in srgb, var(--project-page-accent) 14%, transparent) 30%,
            transparent 72%
          ),
          radial-gradient(
            ellipse at 0% 100%,
            color-mix(in srgb, var(--project-page-accent) 9%, transparent) 0%,
            transparent 64%
          ),
          radial-gradient(
            ellipse at 100% 100%,
            color-mix(in srgb, var(--project-page-accent) 9%, transparent) 0%,
            transparent 64%
          );
        filter: blur(10px);
        opacity: var(--project-page-glow-veil-opacity);
        animation: projectPageGlowFireVeil 6.7s ease-in-out infinite;
      }

      :global(html.dark) .project-page-glow::before {
        background:
          radial-gradient(
            ellipse at 50% 100%,
            color-mix(in srgb, var(--project-page-accent) 45%, transparent) 0%,
            color-mix(in srgb, var(--project-page-accent) 26%, transparent) 24%,
            color-mix(in srgb, var(--project-page-accent) 11%, transparent) 57%,
            transparent 85%
          ),
          radial-gradient(
            ellipse at 4% 100%,
            color-mix(in srgb, var(--project-page-accent) 20%, transparent) 0%,
            color-mix(in srgb, var(--project-page-accent) 9%, transparent) 44%,
            transparent 76%
          ),
          radial-gradient(
            ellipse at 96% 100%,
            color-mix(in srgb, var(--project-page-accent) 20%, transparent) 0%,
            color-mix(in srgb, var(--project-page-accent) 9%, transparent) 44%,
            transparent 76%
          ),
          linear-gradient(
            to top,
            color-mix(in srgb, var(--project-page-accent) 9%, transparent) 0%,
            color-mix(in srgb, var(--project-page-accent) 3.6%, transparent) 40%,
            transparent 74%
          );
        filter: blur(16px);
      }

      :global(html.dark) .project-page-glow::after {
        background:
          radial-gradient(
            ellipse at 50% 100%,
            color-mix(in srgb, var(--project-page-accent) 31%, transparent) 0%,
            color-mix(in srgb, var(--project-page-accent) 16%, transparent) 34%,
            transparent 75%
          ),
          radial-gradient(
            ellipse at 0% 100%,
            color-mix(in srgb, var(--project-page-accent) 12%, transparent) 0%,
            transparent 66%
          ),
          radial-gradient(
            ellipse at 100% 100%,
            color-mix(in srgb, var(--project-page-accent) 12%, transparent) 0%,
            transparent 66%
          );
      }

      .project-page-glow__lick {
        position: absolute;
        left: 50%;
        bottom: 0;
        width: min(42vw, 460px);
        height: 62%;
        border-radius: 999px;
        background:
          radial-gradient(
            ellipse at 50% 100%,
            color-mix(in srgb, var(--project-page-accent) 26%, transparent) 0%,
            color-mix(in srgb, var(--project-page-accent) 12%, transparent) 34%,
            transparent 72%
          );
        filter: blur(12px);
        opacity: 0;
        pointer-events: none;
        transform-origin: 50% 100%;
        will-change: opacity, transform;
      }

      .project-page-glow__lick--a {
        animation: projectPageGlowLickA 3.35s cubic-bezier(0.45, 0, 0.55, 1) infinite;
      }

      .project-page-glow__lick--b {
        width: min(36vw, 380px);
        height: 54%;
        animation: projectPageGlowLickB 4.25s cubic-bezier(0.5, 0, 0.45, 1) -1.1s infinite;
      }

      .project-page-glow__lick--c {
        width: min(34vw, 360px);
        height: 50%;
        animation: projectPageGlowLickC 5.1s cubic-bezier(0.42, 0, 0.58, 1) -2.3s infinite;
      }

      :global(html.dark) .project-page-glow__lick {
        background:
          radial-gradient(
            ellipse at 50% 100%,
            color-mix(in srgb, var(--project-page-accent) 32%, transparent) 0%,
            color-mix(in srgb, var(--project-page-accent) 15%, transparent) 36%,
            transparent 74%
          );
      }

      @keyframes projectPageGlowFireCore {
        0%,
        100% {
          opacity: calc(var(--project-page-glow-core-opacity) * 0.9);
          transform: translate3d(calc(-50% + var(--project-page-glow-drift) - 3px), var(--project-page-glow-rise), 0) scaleX(0.99) scaleY(0.98);
        }

        9% {
          opacity: calc(var(--project-page-glow-core-opacity) * 1.04);
          transform: translate3d(calc(-50% + var(--project-page-glow-drift) + 2px), calc(var(--project-page-glow-rise) - 0.5vh), 0) scaleX(1.012) scaleY(1.035);
        }

        18% {
          opacity: calc(var(--project-page-glow-core-opacity) * 0.95);
          transform: translate3d(calc(-50% + var(--project-page-glow-drift) - 1px), calc(var(--project-page-glow-rise) - 0.18vh), 0) scaleX(0.998) scaleY(1.005);
        }

        31% {
          opacity: calc(var(--project-page-glow-core-opacity) * 1.02);
