---
import Base from './Base.astro';
import Navbar from '@/components/Navbar.astro';
import Footer from '@/components/Footer.astro';
import Folder from '@/components/Folder.astro';
import SingleFolder from '@/components/SingleFolder.astro';

interface Props {
  title: string;
  description: string;
  year?: string;
}

const { title, description, year } = Astro.props;
---

<Base title={`${title} | Allison Peña`} description={description}>
  <Navbar showBack={true} />

  <main class="max-w-[58ch] mx-auto px-6 md:px-8 pt-4 pb-16 md:pb-24">

    <section class="mt-10 md:mt-12 mb-10 md:mb-12">
      <div class="project-folder-active">
        <Folder title={title} description={description} className="w-full folder-bleed" />
      </div>
      {year && (
        <p class="mt-3 font-sans text-xs text-subtle">{year}</p>
      )}
    </section>

    <SingleFolder class="-mx-6 md:-mx-8 px-6 md:px-8 py-4 md:py-6">
      <article class="font-sans text-base leading-[1.75] text-text tracking-tight">
        <slot />
      </article>
    </SingleFolder>

    <style>
      .project-folder-active [data-folder] {
        --folder-fill: var(--folder-hover-fill, color-mix(in srgb, var(--color-bg) 92%, var(--color-text) 8%));
        --folder-shadow-filter:
          drop-shadow(0 -8px 16px color-mix(in srgb, var(--folder-shadow-ink, var(--color-text)) 2.1%, transparent))
          drop-shadow(0 -2px 5px color-mix(in srgb, var(--folder-shadow-ink, var(--color-text)) 0.9%, transparent));
      }

      article :global(h2) {
        font-family: var(--font-sans);
        font-size: 1.125rem;
        font-weight: 500;
        letter-spacing: -0.02em;
        color: var(--color-text);
        margin-top: 2.75rem;
        margin-bottom: 0.875rem;
      }

      article :global(p) {
        color: var(--color-text);
        line-height: 1.75;
      }

      article :global(p + p) {
        margin-top: 1.25rem;
      }
    </style>

    <footer class="mt-12 md:mt-14">
      <a href="/" class="inline-flex items-center gap-1.5 font-mono text-[11px] tracking-wide transition-colors duration-200 text-muted hover:text-text group">
        <svg class="w-3 h-3 transition-transform duration-200 group-hover:-translate-x-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7" />
        </svg>
        volver
      </a>
    </footer>

    <Footer />

  </main>
</Base>
