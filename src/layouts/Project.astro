---
import Base from './Base.astro';
import Navbar from '@/components/Navbar.astro';
import Footer from '@/components/Footer.astro';

interface Props {
  title: string;
  description: string;
  year?: string;
}

const { title, description, year } = Astro.props;
---

<Base title={`${title} | Allison Peña`} description={description}>
  <Navbar showBack={true} />

  <main class="max-w-[58ch] mx-auto px-6 md:px-8 pt-4 pb-16 md:pb-24">

    <header class="mt-12 md:mt-16 mb-8 md:mb-10">
      <h1 class="font-sans text-2xl md:text-3xl tracking-tight text-text leading-[1.1]">{title}</h1>
      <p class="mt-3 font-sans text-base leading-[1.55] text-muted">{description}</p>
      {year && (
        <p class="mt-2 font-mono text-xs text-subtle">{year}</p>
      )}
    </header>

    <article class="project-article font-sans text-base leading-[1.75] text-text tracking-tight">
      <slot />
    </article>

    <style>
      .project-article :global(h2) {
        font-family: var(--font-sans);
        font-size: 1.125rem;
        font-weight: 500;
        letter-spacing: -0.02em;
        color: var(--color-text);
        margin-top: 2.75rem;
        margin-bottom: 0.875rem;
      }

      .project-article :global(p) {
        color: var(--color-text);
        line-height: 1.75;
      }

      .project-article :global(p + p) {
        margin-top: 1.25rem;
      }
    </style>

    <footer class="mt-12 md:mt-14">
      <a href="/" class="inline-flex items-center gap-1.5 font-mono text-[11px] tracking-wide transition-colors duration-200 text-muted hover:text-text group">
        <svg class="w-3 h-3 transition-transform duration-200 group-hover:-translate-x-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7" />
        </svg>
        volver
      </a>
    </footer>

    <Footer />

  </main>
</Base>
