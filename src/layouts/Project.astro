---
import Base from './Base.astro';
import Navbar from '@/components/Navbar.astro';
import Footer from '@/components/Footer.astro';
import Folder from '@/components/Folder.astro';
import { getOgImagePath } from '@/lib/seo';

interface StructuredData {
  [key: string]: unknown;
}

interface Props {
  title: string;
  description: string;
  slug: string;
  year?: string;
  structuredData?: StructuredData | StructuredData[];
}

const { title, description, slug, year, structuredData } = Astro.props;
const publishedTime = year ? `${year}-01-01` : undefined;
---

<Base
  title={`${title} | Allison Peña`}
  description={description}
  image={getOgImagePath(slug)}
  imageAlt={`Vista previa del proyecto ${title}`}
  canonical={`/proyectos/${slug}`}
  type="article"
  publishedTime={publishedTime}
  structuredData={structuredData}
>
  <Navbar />

  <main id="main-content" class="pb-16 md:pb-24">

    <div class="max-w-[58ch] mx-auto px-6 md:px-8 pt-10 md:pt-12">
      <a href="/" class="inline-flex items-center gap-1.5 font-mono text-[11px] tracking-wide transition-colors duration-200 text-muted hover:text-text group mb-6">
        <svg class="w-3 h-3 transition-transform duration-200 group-hover:-translate-x-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7" />
        </svg>
        ir al inicio
      </a>
      <div class="project-folder folder-bleed" data-folder>
        <div class="project-folder__gradient" aria-hidden="true"></div>
        <div data-folder-shell class="relative">
          <svg
            data-folder-svg
            height="480"
            class="block w-full"
            aria-hidden="true"
            preserveAspectRatio="none"
          >
            <path data-folder-fill-path fill="var(--folder-fill, var(--folder-base-fill, var(--color-bg)))"></path>
          </svg>
          <div data-folder-text-layer class="pointer-events-none absolute inset-0 z-[2]">
            <h1
              data-folder-label
              class="absolute left-[var(--folder-pad-x)] top-[32px] text-text font-sans text-2xl md:text-3xl leading-[1.1] tracking-tight font-normal whitespace-nowrap pointer-events-auto select-text"
            >
              {title}
            </h1>
            <p
              data-folder-description
              class="absolute left-[var(--folder-pad-x)] top-[100px] right-[var(--folder-pad-x)] text-text font-sans text-base leading-[1.65] pointer-events-auto select-text"
            >
              {description}
            </p>
            {year && (
              <p class="absolute left-[var(--folder-pad-x)] top-[116px] font-mono text-xs text-subtle">{year}</p>
            )}
          </div>
        </div>
      </div>
    </div>

    <div class="max-w-[58ch] mx-auto px-6 md:px-8 relative z-30" data-project-article-wrap>
      <article class="project-article font-sans text-base leading-[1.75] text-text tracking-tight">
        <slot />
      </article>

      <footer class="mt-12 md:mt-14 mb-8">
        <a href="/" class="inline-flex items-center gap-1.5 font-mono text-[11px] tracking-wide transition-colors duration-200 text-muted hover:text-text group">
          <svg class="w-3 h-3 transition-transform duration-200 group-hover:-translate-x-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7" />
          </svg>
          ir al inicio
        </a>
      </footer>

      <Footer />
    </div>

    <style>
      .project-folder {
        position: relative;
        --folder-min-h: 480px;
        --folder-base-fill: var(--color-bg);
      }

      .project-folder__gradient {
        position: absolute;
        left: -10%;
        right: -10%;
        bottom: 0;
        width: 120%;
        height: 100%;
        background: linear-gradient(
          to bottom,
          transparent 0%,
          transparent 4%,
          color-mix(in srgb, var(--color-bg) 5%, transparent) 6%,
          color-mix(in srgb, var(--color-bg) 15%, transparent) 10%,
          color-mix(in srgb, var(--color-bg) 30%, transparent) 15%,
          color-mix(in srgb, var(--color-bg) 48%, transparent) 22%,
          color-mix(in srgb, var(--color-bg) 65%, transparent) 30%,
          color-mix(in srgb, var(--color-bg) 80%, transparent) 40%,
          color-mix(in srgb, var(--color-bg) 90%, transparent) 50%,
          color-mix(in srgb, var(--color-bg) 96%, transparent) 60%,
          var(--color-bg) 70%
        );
        pointer-events: none;
        z-index: 26;
      }

      .project-folder [data-folder-shell] {
        clip-path: inset(-56px -88px 0 -88px);
      }

      .project-folder [data-folder-svg] {
        filter: drop-shadow(0 -7px 13px color-mix(in srgb, var(--folder-shadow-ink, var(--color-text)) 5%, transparent))
                drop-shadow(0 -2px 4px color-mix(in srgb, var(--folder-shadow-ink, var(--color-text)) 2.5%, transparent));
      }

      /* Always show as active/hover state */
      .project-folder [data-folder-fill-path] {
        --folder-fill: var(--folder-hover-fill, color-mix(in srgb, var(--color-bg) 92%, var(--color-text) 8%));
      }

      .project-article :global(h2) {
        font-family: var(--font-sans);
        font-size: 1.125rem;
        font-weight: 500;
        letter-spacing: -0.02em;
        color: var(--color-text);
        margin-top: 3.25rem;
        margin-bottom: 1.125rem;
      }

      .project-article :global(h2:first-child) {
        margin-top: 0;
      }

      .project-article :global(p) {
        color: var(--color-text);
        line-height: 1.75;
      }

      .project-article :global(p + p) {
        margin-top: 1.375rem;
      }
    </style>

    <script>
      function positionArticle() {
        const folder = document.querySelector('.project-folder') as HTMLElement;
        const wrap = document.querySelector('[data-project-article-wrap]') as HTMLElement;
        if (!folder || !wrap) return;

        const desc = folder.querySelector('[data-folder-description]') as HTMLElement;
        const label = folder.querySelector('[data-folder-label]') as HTMLElement;
        if (!desc && !label) return;

        const contentBottom = desc
          ? desc.offsetTop + desc.offsetHeight
          : label!.offsetTop + label!.offsetHeight;

        // Measure up to the end of the "siguiente" nav, not the footer
        const article = wrap.querySelector('.project-article') as HTMLElement;
        if (!article) return;
        const articleBottom = article.offsetTop + article.offsetHeight;

        // Gap between description end and article start
        const gap = 36;
        const desiredH = contentBottom + gap + articleBottom;

        const finalH = Math.max(480, desiredH);

        // Set --folder-min-h so the shapes script doesn't shrink it
        folder.style.setProperty('--folder-min-h', `${finalH}px`);

        // Also set the SVG height directly for immediate effect
        const svg = folder.querySelector('[data-folder-svg]') as SVGSVGElement;
        if (svg) svg.setAttribute('height', String(finalH));

        // Trigger shapes recalc
        window.dispatchEvent(new Event('resize'));

        const svgH = svg ? Number(svg.getAttribute('height')) || finalH : finalH;
        const pull = svgH - contentBottom - gap;
        wrap.style.marginTop = `-${pull}px`;
      }

      // Run after folder shapes are computed (they use rAF)
      requestAnimationFrame(() => requestAnimationFrame(positionArticle));
      window.addEventListener('resize', () => requestAnimationFrame(positionArticle));
      document.addEventListener('astro:page-load', () => {
        requestAnimationFrame(() => requestAnimationFrame(positionArticle));
      });
    </script>



  </main>
</Base>
