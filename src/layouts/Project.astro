---
import Base from './Base.astro';
import clientModules from '@/generated/client-modules.json';
import Navbar from '@/components/Navbar.astro';
import Footer from '@/components/Footer.astro';
import { getOgImagePath, getTwitterImagePath } from '@/lib/seo';

interface StructuredData {
  [key: string]: unknown;
}

interface Props {
  title: string;
  description: string;
  slug: string;
  year?: string;
  accent?: string;
  structuredData?: StructuredData | StructuredData[];
}

const { title, description, slug, year, accent = 'var(--color-link)', structuredData } = Astro.props;
const publishedTime = year ? `${year}-01-01` : undefined;
const mainStyle = `--project-page-accent:${accent}`;
---

<Base
  title={`${title} | Allison Peña`}
  description={description}
  image={getOgImagePath(slug)}
  imageAlt={`Vista previa del proyecto ${title}`}
  twitterImage={getTwitterImagePath(slug)}
  twitterImageAlt={`Vista previa en X del proyecto ${title}`}
  canonical={`/proyectos/${slug}`}
  type="article"
  publishedTime={publishedTime}
  structuredData={structuredData}
>
  <Navbar />

  <main
    id="main-content"
    class="project-page-shell relative pb-10 md:pb-16"
    style={mainStyle}
    data-project-page-shell
  >
    <div class="project-page-glow" data-project-page-glow aria-hidden="true">
      <span class="project-page-glow__lick project-page-glow__lick--a"></span>
      <span class="project-page-glow__lick project-page-glow__lick--b"></span>
      <span class="project-page-glow__lick project-page-glow__lick--c"></span>
    </div>

    <div class="relative z-30 max-w-[42rem] mx-auto px-6 md:px-8 pt-10 md:pt-12">
      <a href="/" class="group inline-flex items-center gap-2 font-mono text-sm tracking-wide text-muted hover:text-text transition-colors duration-200 mb-8 md:mb-10">
        <svg class="w-3 h-3 motion-safe:transition-transform motion-safe:duration-150 motion-safe:group-hover:-translate-x-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7" />
        </svg>
        volver al inicio
      </a>

      <header class="project-header mb-10 md:mb-12">
        <div class="flex items-start justify-between gap-6">
          <h1 class="font-sans text-[1.85rem] md:text-[2.15rem] leading-[1.08] tracking-[-0.028em] text-text max-w-[18rem]">
            {title}
          </h1>
          {year && <span class="font-mono text-sm tracking-wide text-muted shrink-0 pt-2 tabular-nums">{year}</span>}
        </div>
      </header>
    </div>

    <div class="max-w-[42rem] mx-auto px-6 md:px-8 relative">
      <article class="project-article relative z-30 font-sans text-[16px] leading-[1.6] text-text tracking-[-0.01em] select-none">
        <div class="select-text">
        <slot />
        </div>
      </article>

      <div data-after-article class="relative z-10 select-none">
        <slot name="after-article" />
      </div>

      <footer class="relative z-30 mt-12 md:mt-14 mb-8">
        <a href="/" class="group inline-flex items-center gap-2 font-mono text-sm tracking-wide text-muted hover:text-text transition-colors duration-200">
          <svg class="w-3 h-3 motion-safe:transition-transform motion-safe:duration-150 motion-safe:group-hover:-translate-x-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7" />
          </svg>
          volver al inicio
        </a>
      </footer>

      <div class="relative z-30">
        <Footer />
      </div>
    </div>

    <script is:inline define:vars={{ projectLightboxClientUrl: clientModules['project-lightbox-client'] }}>
      (function () {
        function initProjectGlow() {
          var shell = document.querySelector('[data-project-page-shell]');
          if (!shell) return;

          var reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
          var controller = new AbortController();
          var signal = controller.signal;
          var raf = 0;
          var lastKey = '';

          function clamp(value, min, max) {
            return Math.min(max, Math.max(min, value));
          }

          function smoothstep(value) {
            var t = clamp(value, 0, 1);
            return t * t * (3 - 2 * t);
          }

          function setVar(name, value) {
            shell.style.setProperty(name, value);
          }

          function updateGlow() {
            raf = 0;

            if (reduceMotion.matches) {
              if (lastKey !== 'reduced') {
                lastKey = 'reduced';
                setVar('--project-page-glow-opacity', '0');
              }
              return;
            }

            var doc = document.documentElement;
            var maxScroll = Math.max(1, doc.scrollHeight - window.innerHeight);
            var progress = clamp((window.scrollY || window.pageYOffset || 0) / maxScroll, 0, 1);
            var bucket = Math.round(progress * 1000);
            var isDark = doc.classList.contains('dark');
            var key = bucket + ':' + (isDark ? 'dark' : 'light');

            if (key === lastKey) return;
            lastKey = key;

            var p = bucket / 1000;
            var motion = smoothstep(p);
            var intensity = smoothstep(p * 0.92 + 0.04);
            var baseOpacity = isDark ? 0.12 : 0.07;
            var maxOpacity = isDark ? 0.42 : 0.28;

            setVar('--project-page-glow-opacity', (baseOpacity + intensity * (maxOpacity - baseOpacity)).toFixed(3));
            setVar('--project-page-glow-scale', (0.98 + motion * 0.09).toFixed(3));
            setVar('--project-page-glow-rise', (motion * -8).toFixed(2) + 'vh');
            setVar('--project-page-glow-rise-soft', (motion * -4).toFixed(2) + 'vh');
            setVar('--project-page-glow-drift', ((motion - 0.5) * 24).toFixed(1) + 'px');
            setVar('--project-page-glow-core-opacity', (isDark ? 0.42 + intensity * 0.12 : 0.32 + intensity * 0.1).toFixed(3));
            setVar('--project-page-glow-veil-opacity', (isDark ? 0.24 + intensity * 0.11 : 0.17 + intensity * 0.09).toFixed(3));
            setVar('--project-page-glow-lick-opacity', (isDark ? 0.18 + intensity * 0.1 : 0.13 + intensity * 0.08).toFixed(3));
          }

          function scheduleGlow(force) {
            if (!force && document.hidden) return;
            if (raf) return;
            raf = window.requestAnimationFrame(updateGlow);
          }

          updateGlow();
          window.addEventListener('scroll', function () { scheduleGlow(false); }, { passive: true, signal: signal });
          window.addEventListener('resize', function () { scheduleGlow(true); }, { signal: signal });
          reduceMotion.addEventListener?.('change', function () { scheduleGlow(true); }, { signal: signal });
          document.addEventListener('visibilitychange', function () {
            if (!document.hidden) scheduleGlow(true);
          }, { signal: signal });
          document.addEventListener('click', function (event) {
            if (!(event.target instanceof Element) || !event.target.closest('#theme-toggle')) return;
            window.setTimeout(function () { scheduleGlow(true); }, 0);
          }, { signal: signal });
          window.addEventListener('pagehide', function () {
            controller.abort();
            if (raf) window.cancelAnimationFrame(raf);
          }, { once: true });
        }

        var projectLightboxPromise;

        function loadProjectLightbox() {
          if (!projectLightboxClientUrl) return Promise.resolve();
          projectLightboxPromise ??= import(projectLightboxClientUrl);
          return projectLightboxPromise;
        }

        function prepareProjectFigures() {
          var figures = document.querySelectorAll('[data-figure-root]');
          figures.forEach(function (fig, i) {
            var frame = fig.querySelector('[data-figure-frame]');
            if (!frame) return;

            if (!fig.dataset.side) fig.dataset.side = i % 2 === 0 ? 'right' : 'left';
            if (!frame.style.transitionDelay) frame.style.transitionDelay = (i * 150) + 'ms';
            frame.setAttribute('tabindex', '0');
            frame.setAttribute('role', 'button');
            frame.setAttribute('aria-label', 'Ampliar imagen');

            if (frame.dataset.lightboxLoaderBound === 'true') return;
            frame.dataset.lightboxLoaderBound = 'true';

            var prime = function (event) {
              if (window.__projectLightboxLoaded || frame.dataset.lightboxReady === 'true') return;

              var shouldReplay = event.type === 'click';
              if (event.type === 'keydown') {
                if (event.key !== 'Enter' && event.key !== ' ') return;
                shouldReplay = true;
              }

              if (shouldReplay) event.preventDefault();
              void loadProjectLightbox().then(function () {
                if (shouldReplay && frame.isConnected) frame.click();
              });
            };

            frame.addEventListener('pointerenter', prime, { passive: true });
            frame.addEventListener('focus', prime, { passive: true });
            frame.addEventListener('click', prime);
            frame.addEventListener('keydown', prime);
          });
        }

        function init() {
          initProjectGlow();
          prepareProjectFigures();
        }

        if (document.readyState === 'loading') {
          document.addEventListener('DOMContentLoaded', init, { once: true });
        } else {
          init();
        }
      })();
    </script>

    <style>
      .project-page-shell {
        isolation: isolate;
        --project-page-glow-opacity: 0.16;
        --project-page-glow-scale: 0.98;
        --project-page-glow-rise: 0vh;
        --project-page-glow-rise-soft: 0vh;
        --project-page-glow-drift: 0px;
        --project-page-glow-core-opacity: 0.46;
        --project-page-glow-veil-opacity: 0.25;
        --project-page-glow-lick-opacity: 0.22;
      }

      .project-page-glow {
        position: fixed;
        left: 50%;
        bottom: -14vh;
        z-index: 20;
        width: 100vw;
        height: min(74vh, 720px);
        opacity: var(--project-page-glow-opacity);
        pointer-events: none;
        transform: translate3d(-50%, 0, 0) scale(var(--project-page-glow-scale));
        transform-origin: 50% 100%;
        transition:
          opacity 160ms ease,
          transform 220ms cubic-bezier(0.23, 1, 0.32, 1);
      }

      .project-page-glow::before,
      .project-page-glow::after {
        content: '';
        position: absolute;
        left: 50%;
        bottom: 0;
        pointer-events: none;
      }

      .project-page-glow::before {
        width: min(220vw, 2200px);
        height: 100%;
        background:
          radial-gradient(
            ellipse at 50% 100%,
            color-mix(in srgb, var(--project-page-accent) 37%, transparent) 0%,
            color-mix(in srgb, var(--project-page-accent) 21%, transparent) 22%,
            color-mix(in srgb, var(--project-page-accent) 8%, transparent) 56%,
            transparent 84%
          ),
          radial-gradient(
            ellipse at 4% 100%,
            color-mix(in srgb, var(--project-page-accent) 12%, transparent) 0%,
            color-mix(in srgb, var(--project-page-accent) 6%, transparent) 44%,
            transparent 74%
          ),
          radial-gradient(
            ellipse at 96% 100%,
            color-mix(in srgb, var(--project-page-accent) 12%, transparent) 0%,
            color-mix(in srgb, var(--project-page-accent) 6%, transparent) 44%,
            transparent 74%
          ),
          linear-gradient(
            to top,
            color-mix(in srgb, var(--project-page-accent) 6%, transparent) 0%,
            color-mix(in srgb, var(--project-page-accent) 2.6%, transparent) 38%,
            transparent 72%
          );
        filter: blur(18px);
        opacity: var(--project-page-glow-core-opacity);
        animation: projectPageGlowFireCore 4.9s ease-in-out infinite;
      }

      .project-page-glow::after {
        bottom: -2vh;
        width: min(176vw, 1760px);
        height: 78%;
        background:
          radial-gradient(
            ellipse at 50% 100%,
            color-mix(in srgb, var(--project-page-accent) 24%, transparent) 0%,
            color-mix(in srgb, var(--project-page-accent) 12%, transparent) 30%,
            transparent 72%
          ),
          radial-gradient(
            ellipse at 0% 100%,
            color-mix(in srgb, var(--project-page-accent) 8%, transparent) 0%,
            transparent 64%
          ),
          radial-gradient(
            ellipse at 100% 100%,
            color-mix(in srgb, var(--project-page-accent) 8%, transparent) 0%,
            transparent 64%
          );
        filter: blur(10px);
        opacity: var(--project-page-glow-veil-opacity);
        animation: projectPageGlowFireVeil 6.7s ease-in-out infinite;
      }

      :global(html.dark) .project-page-glow::before {
        background:
          radial-gradient(
            ellipse at 50% 100%,
            color-mix(in srgb, var(--project-page-accent) 38%, transparent) 0%,
            color-mix(in srgb, var(--project-page-accent) 22%, transparent) 24%,
            color-mix(in srgb, var(--project-page-accent) 9%, transparent) 57%,
            transparent 85%
          ),
          radial-gradient(
            ellipse at 4% 100%,
            color-mix(in srgb, var(--project-page-accent) 17%, transparent) 0%,
            color-mix(in srgb, var(--project-page-accent) 8%, transparent) 44%,
            transparent 76%
          ),
          radial-gradient(
            ellipse at 96% 100%,
            color-mix(in srgb, var(--project-page-accent) 17%, transparent) 0%,
            color-mix(in srgb, var(--project-page-accent) 8%, transparent) 44%,
            transparent 76%
          ),
          linear-gradient(
            to top,
            color-mix(in srgb, var(--project-page-accent) 8%, transparent) 0%,
            color-mix(in srgb, var(--project-page-accent) 3.1%, transparent) 40%,
            transparent 74%
          );
        filter: blur(16px);
      }

      :global(html.dark) .project-page-glow::after {
        background:
          radial-gradient(
            ellipse at 50% 100%,
            color-mix(in srgb, var(--project-page-accent) 26%, transparent) 0%,
            color-mix(in srgb, var(--project-page-accent) 14%, transparent) 34%,
            transparent 75%
          ),
          radial-gradient(
            ellipse at 0% 100%,
            color-mix(in srgb, var(--project-page-accent) 10%, transparent) 0%,
            transparent 66%
          ),
          radial-gradient(
            ellipse at 100% 100%,
            color-mix(in srgb, var(--project-page-accent) 10%, transparent) 0%,
            transparent 66%
          );
      }

      .project-page-glow__lick {
        position: absolute;
        left: 50%;
        bottom: 0;
        width: min(42vw, 460px);
        height: 62%;
        border-radius: 999px;
        background:
          radial-gradient(
            ellipse at 50% 100%,
            color-mix(in srgb, var(--project-page-accent) 22%, transparent) 0%,
            color-mix(in srgb, var(--project-page-accent) 10%, transparent) 34%,
            transparent 72%
          );
        filter: blur(12px);
        opacity: 0;
        pointer-events: none;
        transform-origin: 50% 100%;
      }

      .project-page-glow__lick--a {
        animation: projectPageGlowLickA 3.35s cubic-bezier(0.45, 0, 0.55, 1) infinite;
      }

      .project-page-glow__lick--b {
        width: min(36vw, 380px);
        height: 54%;
        animation: projectPageGlowLickB 4.25s cubic-bezier(0.5, 0, 0.45, 1) -1.1s infinite;
      }

      .project-page-glow__lick--c {
        width: min(34vw, 360px);
        height: 50%;
        animation: projectPageGlowLickC 5.1s cubic-bezier(0.42, 0, 0.58, 1) -2.3s infinite;
      }

      :global(html.dark) .project-page-glow__lick {
        background:
          radial-gradient(
            ellipse at 50% 100%,
            color-mix(in srgb, var(--project-page-accent) 27%, transparent) 0%,
            color-mix(in srgb, var(--project-page-accent) 13%, transparent) 36%,
            transparent 74%
          );
      }

      @keyframes projectPageGlowFireCore {
        0%,
        100% {
          opacity: calc(var(--project-page-glow-core-opacity) * 0.9);
          transform: translate3d(calc(-50% + var(--project-page-glow-drift) - 3px), var(--project-page-glow-rise), 0) scaleX(0.99) scaleY(0.98);
        }

        9% {
          opacity: calc(var(--project-page-glow-core-opacity) * 1.04);
          transform: translate3d(calc(-50% + var(--project-page-glow-drift) + 2px), calc(var(--project-page-glow-rise) - 0.5vh), 0) scaleX(1.012) scaleY(1.035);
        }

        18% {
          opacity: calc(var(--project-page-glow-core-opacity) * 0.95);
          transform: translate3d(calc(-50% + var(--project-page-glow-drift) - 1px), calc(var(--project-page-glow-rise) - 0.18vh), 0) scaleX(0.998) scaleY(1.005);
        }

        31% {
          opacity: calc(var(--project-page-glow-core-opacity) * 1.02);
          transform: translate3d(calc(-50% + var(--project-page-glow-drift) + 4px), calc(var(--project-page-glow-rise) - 0.9vh), 0) scaleX(1.02) scaleY(1.048);
        }

        47% {
          opacity: calc(var(--project-page-glow-core-opacity) * 0.93);
          transform: translate3d(calc(-50% + var(--project-page-glow-drift) - 5px), calc(var(--project-page-glow-rise) - 0.32vh), 0) scaleX(0.992) scaleY(1.012);
        }

        64% {
          opacity: calc(var(--project-page-glow-core-opacity) * 1.06);
          transform: translate3d(calc(-50% + var(--project-page-glow-drift) + 1px), calc(var(--project-page-glow-rise) - 0.72vh), 0) scaleX(1.017) scaleY(1.04);
        }

        81% {
          opacity: calc(var(--project-page-glow-core-opacity) * 0.97);
          transform: translate3d(calc(-50% + var(--project-page-glow-drift) - 2px), calc(var(--project-page-glow-rise) - 0.24vh), 0) scaleX(1.003) scaleY(1.018);
        }
      }

      @keyframes projectPageGlowFireVeil {
        0%,
        100% {
          opacity: calc(var(--project-page-glow-veil-opacity) * 0.78);
          transform: translate3d(calc(-50% + var(--project-page-glow-drift) - 14px), var(--project-page-glow-rise-soft), 0) scaleX(0.94) scaleY(0.985);
        }

        13% {
          opacity: calc(var(--project-page-glow-veil-opacity) * 1.05);
          transform: translate3d(calc(-50% + var(--project-page-glow-drift) + 8px), calc(var(--project-page-glow-rise) - 1vh), 0) scaleX(1.025) scaleY(1.055);
        }

        29% {
          opacity: calc(var(--project-page-glow-veil-opacity) * 0.86);
          transform: translate3d(calc(-50% + var(--project-page-glow-drift) - 7px), calc(var(--project-page-glow-rise-soft) - 0.16vh), 0) scaleX(0.98) scaleY(1.005);
        }

        46% {
          opacity: calc(var(--project-page-glow-veil-opacity) * 1.01);
          transform: translate3d(calc(-50% + var(--project-page-glow-drift) + 13px), calc(var(--project-page-glow-rise) - 0.7vh), 0) scaleX(1.014) scaleY(1.035);
        }

        70% {
          opacity: calc(var(--project-page-glow-veil-opacity) * 0.9);
          transform: translate3d(calc(-50% + var(--project-page-glow-drift) - 4px), calc(var(--project-page-glow-rise-soft) - 0.35vh), 0) scaleX(0.99) scaleY(1.018);
        }

        88% {
          opacity: calc(var(--project-page-glow-veil-opacity) * 1.04);
          transform: translate3d(calc(-50% + var(--project-page-glow-drift) + 6px), calc(var(--project-page-glow-rise) - 0.8vh), 0) scaleX(1.02) scaleY(1.045);
        }
      }

      @keyframes projectPageGlowLickA {
        0%,
        100% {
          opacity: 0;
          transform: translate3d(calc(-50% + var(--project-page-glow-drift) - 4px), calc(var(--project-page-glow-rise-soft) + 1vh), 0) scaleX(0.6) scaleY(0.72);
        }

        17% {
          opacity: calc(var(--project-page-glow-lick-opacity) * 0.56);
          transform: translate3d(calc(-50% + var(--project-page-glow-drift) + 5px), calc(var(--project-page-glow-rise) - 1.6vh), 0) scaleX(0.86) scaleY(1.05);
        }

        36% {
          opacity: calc(var(--project-page-glow-lick-opacity) * 0.28);
          transform: translate3d(calc(-50% + var(--project-page-glow-drift) - 8px), calc(var(--project-page-glow-rise) - 0.7vh), 0) scaleX(0.78) scaleY(0.9);
        }

        62% {
          opacity: calc(var(--project-page-glow-lick-opacity) * 0.62);
          transform: translate3d(calc(-50% + var(--project-page-glow-drift) + 2px), calc(var(--project-page-glow-rise) - 2.2vh), 0) scaleX(0.92) scaleY(1.16);
        }

        82% {
          opacity: calc(var(--project-page-glow-lick-opacity) * 0.16);
          transform: translate3d(calc(-50% + var(--project-page-glow-drift) - 3px), calc(var(--project-page-glow-rise) - 0.9vh), 0) scaleX(0.7) scaleY(0.82);
        }
      }

      @keyframes projectPageGlowLickB {
        0%,
        100% {
          opacity: 0;
          transform: translate3d(calc(-50% + var(--project-page-glow-drift) - 34px), var(--project-page-glow-rise-soft), 0) scaleX(0.58) scaleY(0.7);
        }

        23% {
          opacity: calc(var(--project-page-glow-lick-opacity) * 0.42);
          transform: translate3d(calc(-50% + var(--project-page-glow-drift) - 52px), calc(var(--project-page-glow-rise) - 1.2vh), 0) scaleX(0.82) scaleY(1.02);
        }

        49% {
          opacity: calc(var(--project-page-glow-lick-opacity) * 0.18);
          transform: translate3d(calc(-50% + var(--project-page-glow-drift) - 26px), calc(var(--project-page-glow-rise) - 0.45vh), 0) scaleX(0.66) scaleY(0.88);
        }

        71% {
          opacity: calc(var(--project-page-glow-lick-opacity) * 0.5);
          transform: translate3d(calc(-50% + var(--project-page-glow-drift) - 42px), calc(var(--project-page-glow-rise) - 1.9vh), 0) scaleX(0.88) scaleY(1.14);
        }
      }

      @keyframes projectPageGlowLickC {
        0%,
        100% {
          opacity: 0;
          transform: translate3d(calc(-50% + var(--project-page-glow-drift) + 36px), var(--project-page-glow-rise-soft), 0) scaleX(0.58) scaleY(0.72);
        }

        14% {
          opacity: calc(var(--project-page-glow-lick-opacity) * 0.36);
          transform: translate3d(calc(-50% + var(--project-page-glow-drift) + 54px), calc(var(--project-page-glow-rise) - 0.95vh), 0) scaleX(0.78) scaleY(0.98);
        }

        39% {
          opacity: calc(var(--project-page-glow-lick-opacity) * 0.14);
          transform: translate3d(calc(-50% + var(--project-page-glow-drift) + 24px), calc(var(--project-page-glow-rise) - 0.3vh), 0) scaleX(0.64) scaleY(0.84);
        }

        58% {
          opacity: calc(var(--project-page-glow-lick-opacity) * 0.52);
          transform: translate3d(calc(-50% + var(--project-page-glow-drift) + 44px), calc(var(--project-page-glow-rise) - 1.7vh), 0) scaleX(0.86) scaleY(1.1);
        }

        79% {
          opacity: calc(var(--project-page-glow-lick-opacity) * 0.22);
          transform: translate3d(calc(-50% + var(--project-page-glow-drift) + 31px), calc(var(--project-page-glow-rise) - 0.75vh), 0) scaleX(0.72) scaleY(0.9);
        }
      }

      @media (max-width: 768px) {
        .project-page-glow {
          bottom: -10vh;
          height: 62vh;
        }

        .project-page-glow::before {
          width: 210vw;
          filter: blur(16px);
        }

        .project-page-glow::after {
          width: 166vw;
          filter: blur(9px);
        }
      }

      @media (prefers-reduced-motion: reduce) {
        .project-page-glow {
          opacity: 0;
          transition: none;
        }

        .project-page-glow::before,
        .project-page-glow::after,
        .project-page-glow__lick {
          animation: none;
        }
      }

      /* Prevent image selection in after-article slot */
      [data-after-article] img,
      [data-after-article] figcaption,
      [data-after-article] figure {
        user-select: none;
        -webkit-user-select: none;
      }

      .project-article :global(h2) {
        font-family: var(--font-sans);
        font-size: 1.02rem;
        font-weight: 500;
        letter-spacing: -0.015em;
        line-height: 1.35;
        color: var(--color-text);
        margin-top: 4rem;
        margin-bottom: 1.2rem;
      }

      .project-article :global(h2:first-child) {
        margin-top: 0;
      }

      .project-article :global(p) {
        color: var(--color-text);
        line-height: 1.82;
        text-wrap: pretty;
      }

      .project-article :global(p + p) {
        margin-top: 1.45rem;
      }

      /* Exclude folder stack: same ul.project-folder-stack as home — prose ul rules would indent/bleed it wrong */
      .project-article :global(ul:not(.project-folder-stack)) {
        margin-top: 1.25rem;
        margin-bottom: 1.4rem;
        list-style-type: disc;
        padding-left: 1.4rem;
      }

      .project-article :global(ul:not(.project-folder-stack) li) {
        color: var(--color-text);
        line-height: 1.78;
        margin-top: 0.48rem;
        padding-left: 0.1rem;
      }

      .project-article :global(ul:not(.project-folder-stack) li:first-child) {
        margin-top: 0;
      }

      .project-article :global(blockquote) {
        border-left: 1px solid var(--color-border);
        padding-left: 1.1rem;
        margin: 2rem 0;
        color: var(--color-muted);
        font-style: italic;
        line-height: 1.8;
      }

      .project-article :global(strong) {
        font-weight: 600;
        color: var(--color-text);
      }

      .project-article :global(p a),
      .project-article :global(li a) {
        color: inherit;
        text-underline-offset: 0.22em;
        text-decoration: underline;
        text-decoration-color: color-mix(in srgb, currentColor 34%, transparent);
        transition:
          text-decoration-color 150ms ease;
      }

      @media (hover: hover) and (pointer: fine) {
        .project-article :global(p a:hover),
        .project-article :global(li a:hover) {
          color: inherit;
          text-decoration-color: currentColor;
        }
      }

    </style>

  </main>
</Base>
