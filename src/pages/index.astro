---
import { getCollection } from 'astro:content';
import Base from '@/layouts/Base.astro';
import Avatar from '@/components/Avatar.astro';
import Navbar from '@/components/Navbar.astro';
import Footer from '@/components/Footer.astro';
import Folder from '@/components/Folder.astro';
import FolderStack from '@/components/FolderStack.astro';
import FolderStackItem from '@/components/FolderStackItem.astro';
import {
  DEFAULT_OG_IMAGE,
  SITE_DESCRIPTION,
  SITE_LOCALE,
  SITE_NAME,
  SITE_ROLE,
  SITE_URL,
  SOCIAL_PROFILES,
  toAbsoluteUrl,
} from '@/lib/seo';

const proyectos = await getCollection('proyectos');
const projects = proyectos
  .sort((a, b) => (b.data.year || '').localeCompare(a.data.year || ''));

const homeStructuredData = [
  {
    '@context': 'https://schema.org',
    '@type': 'WebSite',
    name: SITE_NAME,
    url: SITE_URL,
    description: SITE_DESCRIPTION,
    image: toAbsoluteUrl(DEFAULT_OG_IMAGE),
    inLanguage: SITE_LOCALE,
  },
  {
    '@context': 'https://schema.org',
    '@type': 'Person',
    name: 'Allison Peña',
    url: SITE_URL,
    jobTitle: SITE_ROLE,
    description: SITE_DESCRIPTION,
    image: toAbsoluteUrl(DEFAULT_OG_IMAGE),
    email: 'mailto:contacto@allison.sh',
    sameAs: SOCIAL_PROFILES,
    inLanguage: SITE_LOCALE,
  },
];

const previewImages: Record<string, string[]> = {
  'agenda-uc': [
    'https://dummyimage.com/940x620/e8c9b0/2b2b2b',
    'https://dummyimage.com/780x980/b0cce8/2b2b2b',
  ],
  barrancas: [
    'https://dummyimage.com/1020x680/e8a8a0/2b2b2b',
    'https://dummyimage.com/760x920/a8d4b8/2b2b2b',
    'https://dummyimage.com/1100x620/e8d4a0/2b2b2b',
  ],
  'kit-digital-uc': [
    'https://dummyimage.com/900x700/a0c8e8/2b2b2b',
    'https://dummyimage.com/1180x620/e8c0a8/2b2b2b',
  ],
  'portal-uc': [
    'https://dummyimage.com/1080x640/b0b8e8/2b2b2b',
    'https://dummyimage.com/820x1020/e0d0a0/2b2b2b',
  ],
};
---

<Base
  title="Allison Peña — Desarrollador web full stack"
  description={SITE_DESCRIPTION}
  image={DEFAULT_OG_IMAGE}
  imageAlt="Allison.sh — Interfaces con intención"
  canonical="/"
  structuredData={homeStructuredData}
>
  <Navbar />

  <main id="main-content" class="max-w-[58ch] mx-auto px-6 md:px-8 pt-4 pb-16 md:pb-24">

    <section class="mt-20 md:mt-28 mb-36 md:mb-40">
      <h1 class="hero-heading font-display text-4xl md:text-5xl xl:text-6xl leading-[1.15] tracking-[-0.03em]">
        Interfaces<br />
        <span class="text-subtle">con intención.</span>
      </h1>
      <p class="mt-5 font-sans text-[18px] leading-[1.65] text-muted max-w-[44ch]">
        Construyo interfaces que funcionan.<br class="hidden sm:inline" /> Me importa que sean usables y accesibles.
      </p>
    </section>

    <section id="proyectos" class="mb-0 md:mb-0 scroll-mt-20">
      <p class="font-sans text-[11px] uppercase tracking-[0.12em] text-muted mb-6 md:mb-8">
        Trabajo seleccionado
      </p>
      <FolderStack>
        {projects.map((p, i) => (
          <FolderStackItem
            href={`/proyectos/${p.id}`}
            index={i}
            previewSrcs={previewImages[p.id]}
            previewAlt={`Preview de ${p.data.title}`}
          >
            <Folder title={p.data.title} description={p.data.description} className="w-full" />
          </FolderStackItem>
        ))}
      </FolderStack>
    </section>

    <section id="sobre-mi" class="relative z-30 -mt-8 md:-mt-12 mb-32 md:mb-40 scroll-mt-20">
      <div class="flex flex-col gap-8 items-start">
        <Avatar id="about-avatar" className="w-[160px] h-[160px] rounded-full border border-border -mt-20 md:-mt-28" />
        <div class="space-y-6">
          <p class="font-sans text-lg leading-[1.8]">
            Me interesa cómo las interfaces se vuelven invisibles. Que la tecnología importe menos que lo que permite hacer.
          </p>
          <p class="font-sans text-base leading-[1.8] text-muted">
            Trabajo principalmente con React, Astro y herramientas que priorizan rendimiento y accesibilidad. Prefiero resolver problemas con menos código que más.
          </p>
        </div>
      </div>
    </section>

    <Footer />

  </main>
</Base>
