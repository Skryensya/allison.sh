---
import { getCollection } from 'astro:content';
import Base from '@/layouts/Base.astro';
import Avatar from '@/components/Avatar.astro';
import Navbar from '@/components/Navbar.astro';
import Footer from '@/components/Footer.astro';
import ProjectFolderCard from '@/components/ProjectFolderCard.astro';
import ProjectFolderStack from '@/components/ProjectFolderStack.astro';
import {
  DEFAULT_OG_IMAGE,
  DEFAULT_TWITTER_IMAGE,
  SITE_DESCRIPTION,
  SITE_LOCALE,
  SITE_NAME,
  SITE_ROLE,
  SITE_URL,
  SOCIAL_PROFILES,
  toAbsoluteUrl,
} from '@/lib/seo';

const proyectos = await getCollection('proyectos');
const projects = proyectos.sort((a, b) => (a.data.order ?? 99) - (b.data.order ?? 99));

const homeStructuredData = [
  {
    '@context': 'https://schema.org',
    '@type': 'WebSite',
    name: SITE_NAME,
    url: SITE_URL,
    description: SITE_DESCRIPTION,
    image: toAbsoluteUrl(DEFAULT_OG_IMAGE),
    inLanguage: SITE_LOCALE,
  },
  {
    '@context': 'https://schema.org',
    '@type': 'Person',
    name: 'Allison Peña',
    url: SITE_URL,
    jobTitle: SITE_ROLE,
    description: SITE_DESCRIPTION,
    image: toAbsoluteUrl(DEFAULT_OG_IMAGE),
    email: 'mailto:contacto@allison.sh',
    sameAs: SOCIAL_PROFILES,
    inLanguage: SITE_LOCALE,
  },
];

---

<Base
  title="Allison Peña — Interfaces web claras, rápidas y accesibles"
  description={SITE_DESCRIPTION}
  image={DEFAULT_OG_IMAGE}
  imageAlt="Allison.sh — Interfaces con intención"
  twitterImage={DEFAULT_TWITTER_IMAGE}
  twitterImageAlt="Allison.sh — Vista previa para X"
  canonical="/"
  structuredData={homeStructuredData}
>
  <Navbar />

  <main id="main-content" class="relative max-w-[42rem] mx-auto px-6 md:px-8 pt-4 pb-10 md:pb-16">

    <section class="mt-20 md:mt-28 mb-36 md:mb-40">
      <h1 class="hero-heading font-display text-3xl md:text-4xl xl:text-5xl leading-[1.04] tracking-[-0.03em] text-balance">
        Allison Peña
      </h1>
      <p class="mt-5 font-sans text-[18px] leading-[1.8] text-muted tracking-normal">
        Desarrollador fullstack con foco en interfaces. Me gusta construir cosas para la web, prototipar e iterar hasta que las ideas queden bien resueltas, poniendo atención en los detalles y buscando soluciones simples a problemas complejos.
      </p>
    </section>

    <section id="proyectos" class="mb-24 md:mb-28 scroll-mt-20 relative z-20">
      <h2 class="font-mono text-sm tracking-wide text-muted mb-6 md:mb-8">
        Proyectos destacados
      </h2>
      <ProjectFolderStack>
        {projects.map((p) => (
          <ProjectFolderCard
            href={`/proyectos/${p.id}`}
            title={p.data.title}
            description={p.data.description}
            previewSrcs={p.data.previewImages}
            previewAlt={`Preview de ${p.data.title}`}
          />
        ))}
      </ProjectFolderStack>

    </section>

    <section id="sobre-mi" class="relative z-30 mb-32 md:mb-40 scroll-mt-20">
      <div class="flex flex-col gap-8 items-start">
        <Avatar id="about-avatar" className="w-[160px] h-[160px] rounded-full avatar-frame -mt-20 md:-mt-28" />
        <div class="space-y-6">
          <p class="font-sans text-lg leading-[1.8]">
            Me gusta entender cómo funcionan las cosas y llevarlas un poco más allá. Disfruto construir, iterar, simplificar. Tengo una fascinación genuina por el diseño y me gusta trabajar cerca de él.
          </p>
          <p class="font-sans text-base leading-[1.8] text-muted">
            Fuera del trabajo, paso tiempo aprendiendo noruego, jugando ajedrez y explorando música. También construyo proyectos personales de forma constante, más por curiosidad que por necesidad.{' '}
            <a href="https://fun.allison.sh" class="underline underline-offset-[0.22em] text-muted decoration-from-font transition-[color,text-decoration-color] duration-150 ease-out decoration-[color-mix(in_srgb,var(--color-text)_32%,transparent)] hover:text-text hover:decoration-[color-mix(in_srgb,var(--color-text)_52%,transparent)]" target="_blank" rel="noopener noreferrer">Este sitio</a>{' '}
            es una extensión de eso.
          </p>
        </div>
      </div>
    </section>

    <Footer />

  </main>
</Base>
