---
import { getCollection } from 'astro:content';
import Base from '@/layouts/Base.astro';
import Avatar from '@/components/Avatar.astro';
import Navbar from '@/components/Navbar.astro';
import Footer from '@/components/Footer.astro';
import Folder from '@/components/Folder.astro';
import FolderStack from '@/components/FolderStack.astro';
import FolderStackItem from '@/components/FolderStackItem.astro';

const proyectos = await getCollection('proyectos');
const projects = proyectos
  .sort((a, b) => (b.data.year || '').localeCompare(a.data.year || ''));

const previewImages: Record<string, string[]> = {
  'agenda-uc': [
    'https://dummyimage.com/940x620/f2f1e8/2b2b2b',
    'https://dummyimage.com/780x980/f2f1e8/2b2b2b',
  ],
  barrancas: [
    'https://dummyimage.com/1020x680/f2f1e8/2b2b2b',
    'https://dummyimage.com/760x920/f2f1e8/2b2b2b',
    'https://dummyimage.com/1100x620/f2f1e8/2b2b2b',
  ],
  'hostal-micelio': [
    'https://dummyimage.com/980x640/f2f1e8/2b2b2b',
    'https://dummyimage.com/820x1040/f2f1e8/2b2b2b',
  ],
  'kit-digital-uc': [
    'https://dummyimage.com/900x700/f2f1e8/2b2b2b',
    'https://dummyimage.com/1180x620/f2f1e8/2b2b2b',
  ],
  'kit-digital-uss': [
    'https://dummyimage.com/960x720/f2f1e8/2b2b2b',
    'https://dummyimage.com/760x980/f2f1e8/2b2b2b',
  ],
  'portal-uc': [
    'https://dummyimage.com/1080x640/f2f1e8/2b2b2b',
    'https://dummyimage.com/820x1020/f2f1e8/2b2b2b',
  ],
  ttu: [
    'https://dummyimage.com/920x690/f2f1e8/2b2b2b',
    'https://dummyimage.com/1160x640/f2f1e8/2b2b2b',
    'https://dummyimage.com/760x960/f2f1e8/2b2b2b',
  ],
};
---

<Base title="Allison Peña — Desarrollador web full stack">
  <Navbar />

  <main id="main-content" class="max-w-[58ch] mx-auto px-6 md:px-8 pt-4 pb-16 md:pb-24">

    <section class="min-h-[45vh] mt-20 md:mt-28 mb-28 md:mb-36">
      <h1 class="hero-heading font-display text-5xl md:text-6xl xl:text-7xl leading-[1.05] font-normal tracking-tight">
        Interfaces que se olvidan <span class="text-muted">de existir.</span>
      </h1>
      <p class="hero-subtitle font-sans text-base md:text-lg leading-[1.6] text-muted mt-6">
        Me interesa cómo el código se vuelve invisible. Cómo lo que construyes importa más que cómo lo construyes.
      </p>
    </section>

    <section id="proyectos" class="mb-32 md:mb-40 scroll-mt-20">
      <FolderStack>
        {projects.map((p, i) => (
          <FolderStackItem
            href={`/proyectos/${p.id}`}
            index={i}
            previewSrcs={previewImages[p.id]}
            previewAlt={`Preview de ${p.data.title}`}
          >
            <Folder title={p.data.title} description={p.data.description} className="w-full" />
          </FolderStackItem>
        ))}
      </FolderStack>
    </section>

    <section id="sobre-mi" class="mb-32 md:mb-40 scroll-mt-20">
      <div class="flex flex-col gap-8 items-start">
        <Avatar id="about-avatar" className="w-[160px] h-[160px] rounded-full border border-border" />
        <div class="space-y-6">
          <p class="font-sans text-lg leading-[1.8]">
            Me interesa cómo las interfaces se vuelven invisibles. Que la tecnología importe menos que lo que permite hacer.
          </p>
          <p class="font-sans text-base leading-[1.8] text-muted">
            Trabajo principalmente con React, Astro y herramientas que priorizan rendimiento y accesibilidad. Prefiero resolver problemas con menos código que más.
          </p>
        </div>
      </div>
    </section>

    <Footer />

  </main>
</Base>
