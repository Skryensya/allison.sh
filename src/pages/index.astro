---
import { getCollection } from 'astro:content';
import Base from '@/layouts/Base.astro';
import Avatar from '@/components/Avatar.astro';
import Navbar from '@/components/Navbar.astro';
import Footer from '@/components/Footer.astro';
import ProjectFolderCard from '@/components/ProjectFolderCard.astro';
import ProjectFolderStack from '@/components/ProjectFolderStack.astro';
import {
  DEFAULT_OG_IMAGE,
  DEFAULT_TWITTER_IMAGE,
  SITE_DESCRIPTION,
  SITE_LOCALE,
  SITE_NAME,
  SITE_ROLE,
  SITE_URL,
  SOCIAL_PROFILES,
  toAbsoluteUrl,
} from '@/lib/seo';

const proyectos = await getCollection('proyectos');
const projects = proyectos
  .sort((a, b) => (b.data.year || '').localeCompare(a.data.year || ''));

const featuredProjectIds = ['agenda-uc', 'barrancas', 'kit-digital-uc'];
const featuredProjects = featuredProjectIds
  .map((id) => projects.find((project) => project.id === id))
  .filter(Boolean);

const homeStructuredData = [
  {
    '@context': 'https://schema.org',
    '@type': 'WebSite',
    name: SITE_NAME,
    url: SITE_URL,
    description: SITE_DESCRIPTION,
    image: toAbsoluteUrl(DEFAULT_OG_IMAGE),
    inLanguage: SITE_LOCALE,
  },
  {
    '@context': 'https://schema.org',
    '@type': 'Person',
    name: 'Allison Peña',
    url: SITE_URL,
    jobTitle: SITE_ROLE,
    description: SITE_DESCRIPTION,
    image: toAbsoluteUrl(DEFAULT_OG_IMAGE),
    email: 'mailto:contacto@allison.sh',
    sameAs: SOCIAL_PROFILES,
    inLanguage: SITE_LOCALE,
  },
];

---

<Base
  title="Allison Peña — Interfaces web claras, rápidas y accesibles"
  description={SITE_DESCRIPTION}
  image={DEFAULT_OG_IMAGE}
  imageAlt="Allison.sh — Interfaces con intención"
  twitterImage={DEFAULT_TWITTER_IMAGE}
  twitterImageAlt="Allison.sh — Vista previa para X"
  canonical="/"
  structuredData={homeStructuredData}
>
  <Navbar />

  <main id="main-content" class="max-w-[58ch] mx-auto px-6 md:px-8 pt-4 pb-16 md:pb-24">

    <section class="mt-20 md:mt-28 mb-36 md:mb-40">
      <h1 class="hero-heading font-display text-4xl md:text-5xl xl:text-6xl leading-[1.15] tracking-[-0.03em]">
        Interfaces<br />
        <span class="text-subtle">con intención.</span>
      </h1>
      <p class="mt-5 font-sans text-[18px] leading-[1.65] text-muted max-w-[44ch]">
        Construyo interfaces que funcionan.<br class="hidden sm:inline" /> Me importa que sean usables y accesibles.
      </p>
    </section>

    <section id="proyectos" class="mb-24 md:mb-28 scroll-mt-20 relative z-20">
      <div class="mb-6 md:mb-8 flex items-center justify-between gap-4">
        <p class="font-sans text-[11px] uppercase tracking-[0.12em] text-muted">
          Destacados
        </p>
        <a
          href="/proyectos/"
          class="inline-flex items-center gap-2 font-mono text-[11px] tracking-wide text-muted hover:text-text transition-colors duration-200 group shrink-0"
        >
          ver todos
          <span class="transition-transform duration-200 group-hover:translate-x-0.5">→</span>
        </a>
      </div>
      <ProjectFolderStack>
        {featuredProjects.map((p) => (
          <ProjectFolderCard
            href={`/proyectos/${p.id}`}
            title={p.data.title}
            description={p.data.description}
            previewSrcs={p.data.previewImages}
            previewAlt={`Preview de ${p.data.title}`}
          />
        ))}
      </ProjectFolderStack>

    </section>

    <section id="sobre-mi" class="relative z-30 mb-32 md:mb-40 scroll-mt-20">
      <div class="flex flex-col gap-8 items-start">
        <Avatar id="about-avatar" className="w-[160px] h-[160px] rounded-full border border-border -mt-20 md:-mt-28" />
        <div class="space-y-6">
          <p class="font-sans text-lg leading-[1.8]">
            Me interesa cómo las interfaces se vuelven invisibles. Que la tecnología importe menos que lo que permite hacer.
          </p>
          <p class="font-sans text-base leading-[1.8] text-muted">
            Trabajo principalmente con React, Astro y herramientas que priorizan rendimiento y accesibilidad. Prefiero resolver problemas con menos código que más.
          </p>
        </div>
      </div>
    </section>

    <Footer />

  </main>
</Base>
