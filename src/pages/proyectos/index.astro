---
import { getCollection } from 'astro:content';
import Base from '@/layouts/Base.astro';
import Navbar from '@/components/Navbar.astro';
import Footer from '@/components/Footer.astro';
import ProjectFolderCard from '@/components/ProjectFolderCard.astro';
import ProjectFolderStack from '@/components/ProjectFolderStack.astro';
import { projectPreviewImages } from '@/data/project-previews';
import {
  DEFAULT_OG_IMAGE,
  DEFAULT_TWITTER_IMAGE,
  SITE_DESCRIPTION,
  SITE_LOCALE,
  SITE_NAME,
  SITE_URL,
  toAbsoluteUrl,
} from '@/lib/seo';

const proyectos = await getCollection('proyectos');
const projects = proyectos.sort((a, b) => (b.data.year || '').localeCompare(a.data.year || ''));

const structuredData = {
  '@context': 'https://schema.org',
  '@type': 'CollectionPage',
  name: 'Proyectos',
  headline: 'Proyectos',
  description: 'Todos los proyectos mostrados como folders apilados.',
  url: toAbsoluteUrl('/proyectos'),
  image: toAbsoluteUrl(DEFAULT_OG_IMAGE),
  inLanguage: SITE_LOCALE,
  isPartOf: {
    '@type': 'WebSite',
    name: SITE_NAME,
    url: SITE_URL,
  },
};
---

<Base
  title="Proyectos | Allison Peña"
  description="Todos los proyectos mostrados como folders apilados."
  image={DEFAULT_OG_IMAGE}
  imageAlt="Allison.sh — Proyectos"
  twitterImage={DEFAULT_TWITTER_IMAGE}
  twitterImageAlt="Allison.sh — Proyectos"
  canonical="/proyectos/"
  structuredData={structuredData}
>
  <Navbar />

  <main id="main-content" class="max-w-[58ch] mx-auto px-6 md:px-8 pt-4 pb-16 md:pb-24">
    <section class="mt-20 md:mt-28 mb-14 md:mb-16">
      <p class="font-sans text-[11px] uppercase tracking-[0.12em] text-muted mb-5">Archivo</p>
      <h1 class="font-display text-4xl md:text-5xl xl:text-6xl leading-[1.12] tracking-[-0.03em] text-text">
        Proyectos
      </h1>
      <p class="mt-5 font-sans text-[18px] leading-[1.65] text-muted max-w-[44ch]">
        Una selección más completa del trabajo. Cada pieza existe por una decisión, un problema o una forma particular de mirar una interfaz.
      </p>
    </section>

    <section class="mb-24 md:mb-28">
      <ProjectFolderStack>
        {projects.map((project) => (
          <ProjectFolderCard
            href={`/proyectos/${project.id}`}
            title={project.data.title}
            description={project.data.description}
            previewSrcs={projectPreviewImages[project.id]}
            previewAlt={`Preview de ${project.data.title}`}
          />
        ))}
      </ProjectFolderStack>
    </section>

    <Footer />
  </main>
</Base>
