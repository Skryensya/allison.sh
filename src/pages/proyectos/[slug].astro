---
import { getCollection, render } from 'astro:content';
import Project from '@/layouts/Project.astro';
import TechChips from '@/components/TechChips.astro';
import ImageFigure from '@/components/ImageFigure.astro';
import Folder from '@/components/Folder.astro';
import FolderStack from '@/components/FolderStack.astro';
import FolderStackItem from '@/components/FolderStackItem.astro';
import { getOgImagePath, SITE_LOCALE, SITE_NAME, SITE_URL, toAbsoluteUrl } from '@/lib/seo';

export async function getStaticPaths() {
  const proyectos = await getCollection('proyectos');
  return proyectos.map((entry) => ({
    params: { slug: entry.id },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);

// Get all projects sorted chronologically for navigation
const allProyectos = await getCollection('proyectos');
const sorted = allProyectos.sort((a, b) => (a.data.year || '').localeCompare(b.data.year || ''));
const currentIndex = sorted.findIndex(p => p.id === entry.id);
const nextProject = sorted[(currentIndex + 1) % sorted.length];

const previewImages: Record<string, string[]> = {
  'agenda-uc': [
    'https://dummyimage.com/940x620/e8c9b0/2b2b2b',
    'https://dummyimage.com/780x980/b0cce8/2b2b2b',
  ],
  barrancas: [
    'https://dummyimage.com/1020x680/e8a8a0/2b2b2b',
    'https://dummyimage.com/760x920/a8d4b8/2b2b2b',
    'https://dummyimage.com/1100x620/e8d4a0/2b2b2b',
  ],
  'kit-digital-uc': [
    'https://dummyimage.com/900x700/a0c8e8/2b2b2b',
    'https://dummyimage.com/1180x620/e8c0a8/2b2b2b',
  ],
  'portal-uc': [
    'https://dummyimage.com/1080x640/b0b8e8/2b2b2b',
    'https://dummyimage.com/820x1020/e0d0a0/2b2b2b',
  ],
};

const nextPreviews = previewImages[nextProject.id] || [];
const projectStructuredData = {
  '@context': 'https://schema.org',
  '@type': 'CreativeWork',
  name: entry.data.title,
  headline: entry.data.title,
  description: entry.data.description,
  url: toAbsoluteUrl(`/proyectos/${entry.id}`),
  image: toAbsoluteUrl(getOgImagePath(entry.id)),
  inLanguage: SITE_LOCALE,
  mainEntityOfPage: toAbsoluteUrl(`/proyectos/${entry.id}`),
  author: {
    '@type': 'Person',
    name: 'Allison Peña',
    url: SITE_URL,
  },
  publisher: {
    '@type': 'Person',
    name: 'Allison Peña',
    url: SITE_URL,
  },
  isPartOf: {
    '@type': 'WebSite',
    name: SITE_NAME,
    url: SITE_URL,
  },
  ...(entry.data.year ? { datePublished: `${entry.data.year}-01-01` } : {}),
};
---

<Project
  title={entry.data.title}
  description={entry.data.description}
  slug={entry.id}
  year={entry.data.year}
  structuredData={projectStructuredData}
>
  <div class="space-y-6 font-sans text-base leading-[1.75] text-text">
    <Content components={{ ImageFigure }} />
    <TechChips tech={entry.data.tech || []} />
  </div>

  <nav class="mt-20">
    <p class="font-mono text-[11px] tracking-wide text-subtle mb-8">siguiente</p>
    <div class="next-folder-stack" data-next-folder-stack>
      <FolderStack>
        <FolderStackItem
          href={`/proyectos/${nextProject.id}`}
          index={0}
          ariaLabel={`Ir a ${nextProject.data.title}`}
          previewSrcs={nextPreviews}
          previewAlt={`Preview de ${nextProject.data.title}`}
        >
          <Folder title={nextProject.data.title} description={nextProject.data.description} className="w-full" />
        </FolderStackItem>
      </FolderStack>
    </div>

    <script>
      function activateNextFolder() {
        if (!window.matchMedia('(max-width: 768px)').matches) return;
        const wrap = document.querySelector('[data-next-folder-stack]');
        if (!wrap) return;
        const item = wrap.querySelector('[data-folder-stack-item]') as HTMLElement;
        if (!item) return;

        item.dataset.active = 'true';
        item.dataset.previewOpen = 'true';

        // Load preview images
        item.querySelectorAll('[data-folder-preview-img]').forEach((img) => {
          if (img instanceof HTMLImageElement && img.dataset.src) {
            img.src = img.dataset.src;
          }
        });

        // Set preview-open on each preview element
        item.querySelectorAll('[data-preview-index]').forEach((el) => {
          if (el instanceof HTMLElement) el.dataset.previewOpen = 'true';
        });
      }

      requestAnimationFrame(() => requestAnimationFrame(activateNextFolder));
      document.addEventListener('astro:page-load', () => {
        requestAnimationFrame(() => requestAnimationFrame(activateNextFolder));
      });
    </script>
  </nav>
</Project>

<style is:global>
  @media (max-width: 768px) {
    .next-folder-stack .folder-stack__item[data-active='true'] :is(.folder-stack__card, .folder-stack__hit) {
      transform: none !important;
      transition: none !important;
    }

    .next-folder-stack .folder-stack__item [data-folder],
    .next-folder-stack .folder-stack__item[data-active='true'] [data-folder] {
      --folder-fill: var(--folder-hover-fill, color-mix(in srgb, var(--color-bg) 92%, var(--color-text) 8%)) !important;
    }

    .next-folder-stack .folder-stack__item::before {
      display: none !important;
    }
  }
</style>
