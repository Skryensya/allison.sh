---
import { getCollection, render } from 'astro:content';
import Project from '@/layouts/Project.astro';
import TechChips from '@/components/TechChips.astro';
import ImageFigure from '@/components/ImageFigure.astro';
import ProjectFolderCard from '@/components/ProjectFolderCard.astro';
import ProjectFolderStack from '@/components/ProjectFolderStack.astro';
import { getOgImagePath, SITE_LOCALE, SITE_NAME, SITE_URL, toAbsoluteUrl } from '@/lib/seo';

export async function getStaticPaths() {
  const proyectos = await getCollection('proyectos');
  return proyectos.map((entry) => ({
    params: { slug: entry.id },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);

// Get all projects sorted chronologically for navigation
const allProyectos = await getCollection('proyectos');
const sorted = allProyectos.sort((a, b) => (a.data.order ?? 99) - (b.data.order ?? 99));
const currentIndex = sorted.findIndex(p => p.id === entry.id);
const nextProject = sorted[(currentIndex + 1) % sorted.length];

const nextPreviews = nextProject.data.previewImages || [];
const projectAccents: Record<string, string> = {
  'agenda-uc': 'var(--flexoki-blue-400)',
  'barrancas': 'var(--flexoki-orange-400)',
  'kit-digital-uc': 'var(--flexoki-purple-400)',
  'nike': 'var(--flexoki-cyan-400)',
  'portal-uc': 'var(--flexoki-green-400)',
  'radio': 'var(--flexoki-magenta-400)',
};
const projectStructuredData = {
  '@context': 'https://schema.org',
  '@type': 'CreativeWork',
  name: entry.data.title,
  headline: entry.data.title,
  description: entry.data.description,
  url: toAbsoluteUrl(`/proyectos/${entry.id}`),
  image: toAbsoluteUrl(getOgImagePath(entry.id)),
  inLanguage: SITE_LOCALE,
  mainEntityOfPage: toAbsoluteUrl(`/proyectos/${entry.id}`),
  author: {
    '@type': 'Person',
    name: 'Allison Peña',
    url: SITE_URL,
  },
  publisher: {
    '@type': 'Person',
    name: 'Allison Peña',
    url: SITE_URL,
  },
  isPartOf: {
    '@type': 'WebSite',
    name: SITE_NAME,
    url: SITE_URL,
  },
  ...(entry.data.year ? { datePublished: `${entry.data.year}-01-01` } : {}),
};
---

<Project
  title={entry.data.title}
  description={entry.data.description}
  slug={entry.id}
  year={entry.data.year}
  links={entry.data.links}
  employer={entry.data.employer}
  accent={projectAccents[entry.id]}
  structuredData={projectStructuredData}
>
  <div class="space-y-6 font-sans text-[16px] leading-[1.6] text-text tracking-[-0.01em]">
    <Content components={{ ImageFigure }} />
    <TechChips tech={entry.data.tech || []} />
  </div>

  <nav slot="after-article" class="mt-20">
    <p class="font-mono text-sm tracking-wide text-muted mb-16 md:mb-8">siguiente</p>
    <div class="next-folder-stack">
      <ProjectFolderStack alwaysOpenPreviewsMobile>
        <ProjectFolderCard
          href={`/proyectos/${nextProject.id}`}
          title={nextProject.data.title}
          description={nextProject.data.description}
          previewSrcs={nextPreviews}
          previewAlt={`Preview de ${nextProject.data.title}`}
          accent={projectAccents[nextProject.id]}
        />
      </ProjectFolderStack>
    </div>
  </nav>
</Project>

<style is:global>
  @media (max-width: 768px) {
    .next-folder-stack .project-folder-card[data-active='true'] .project-folder-card__link {
      transform: none !important;
      transition: none !important;
    }

    .next-folder-stack .project-folder-card [data-folder],
    .next-folder-stack .project-folder-card[data-active='true'] [data-folder] {
      --folder-fill-top: color-mix(in srgb, var(--folder-accent, var(--flexoki-green-400, var(--color-link))) 22%, var(--color-bg) 78%) !important;
      --folder-fill-bottom: color-mix(in srgb, var(--folder-accent, var(--flexoki-green-400, var(--color-link))) 12%, var(--color-bg) 88%) !important;
    }
  }
</style>
