---
import { getCollection } from 'astro:content';
import Base from '@/layouts/Base.astro';
import Folder from '@/components/Folder.astro';
import FolderStack from '@/components/FolderStack.astro';
import FolderStackItem from '@/components/FolderStackItem.astro';

const proyectos = await getCollection('proyectos');
const projects = proyectos.sort((a, b) => (b.data.year || '').localeCompare(a.data.year || ''));
---

<Base title="Debug">
  <!-- Same container as Home (para prototipar en contexto) -->
  <main id="main-content" class="max-w-[58ch] mx-auto px-6 md:px-8 pt-4 pb-16 md:pb-24">
    <div class="mt-6 md:mt-10 flex items-center justify-between">
      <a href="/" class="font-mono text-sm text-muted hover:text-text transition-colors">
        ← home
      </a>

      <button
        id="theme-toggle"
        class="font-sans text-base font-normal tracking-[0.01em] text-text text-left"
        type="button"
      >
        <span class="dark-label">dark</span>
        <span class="light-label" style="display:none">light</span>
      </button>
    </div>

    <section class="mt-12 md:mt-16">
      <h1 class="font-display text-4xl md:text-5xl leading-[1.05] tracking-tight">
        Proyectos (debug)
      </h1>
      <p class="font-sans text-base md:text-lg leading-[1.7] text-muted mt-4">
        Lista de todos los proyectos, simulada como “folders”.
      </p>
    </section>

    <section class="mt-14">
      <FolderStack>
        {projects.map((p, i) => (
          <FolderStackItem href={`/proyectos/${p.id}`} index={i}>
            <Folder title={p.data.title} description={p.data.description} className="w-full" />
          </FolderStackItem>
        ))}
      </FolderStack>
    </section>
  </main>
</Base>
