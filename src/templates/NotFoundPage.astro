---
import Base from '@/layouts/Base.astro';
import { homePath, type Locale } from '@/i18n';
import { messages } from '@/i18n/messages';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = messages[locale].notFound;
const home = homePath(locale);
---

<Base
  title={t.title}
  description={t.description}
  canonical={`${locale === 'en' ? '/en' : ''}/404`}
  noindex={true}
>
  <header id="site-header" class="w-full sticky top-0 z-50 overflow-hidden transition-[padding] duration-300">
    <nav id="site-nav" class="max-w-[42rem] mx-auto flex justify-between items-center px-3 md:px-8 py-4 md:py-8 transition-[padding] duration-300">
      <h1 class="font-display text-xl font-medium tracking-tight shrink-0"><a href={home} class="hover:text-muted transition-colors duration-200"><span class="font-light">Allison</span> Peña</a></h1>
    </nav>
  </header>

  <main id="main-content" class="relative max-w-[42rem] mx-auto px-3 md:px-8 pt-4">
    <section class="min-h-[60vh] flex flex-col justify-center">
      <p class="font-mono text-sm tracking-wide text-muted mb-4">404</p>
      <h2 class="font-sans text-5xl md:text-6xl xl:text-7xl leading-[1.05] font-normal tracking-tight mb-8">
        {t.heading}
      </h2>
      <p class="font-mono text-base leading-[1.7] text-muted max-w-[40ch]">
        {t.body}
      </p>
      <a 
        href={home}
        class="inline-block mt-12 font-sans text-base transition-colors duration-200 hover:text-muted group"
      >
        <span class="mr-2 text-muted group-hover:text-text transition-colors duration-200">←</span>
        <span class="border-b border-current pb-0.5">{t.back}</span>
      </a>
    </section>
  </main>
</Base>
