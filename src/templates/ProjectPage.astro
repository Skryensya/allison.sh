---
import { render } from 'astro:content';
import type { CollectionEntry } from 'astro:content';
import Project from '@/layouts/Project.astro';
import TechChips from '@/components/TechChips.astro';
import ImageFigure from '@/components/ImageFigure.astro';
import ProjectFolderCard from '@/components/ProjectFolderCard.astro';
import ProjectFolderStack from '@/components/ProjectFolderStack.astro';
import { projectPath, type Locale } from '@/i18n';
import { messages } from '@/i18n/messages';
import { getProjects, projectAccents } from '@/lib/projects';
import { getInLanguage, getOgImagePath, getTwitterImagePath, SITE_NAME, SITE_URL, toAbsoluteUrl } from '@/lib/seo';

interface Props {
  entry: CollectionEntry<'proyectos'> | CollectionEntry<'projects'>;
  locale: Locale;
}

const { entry, locale } = Astro.props;
const t = messages[locale];
const { Content } = await render(entry);

// All projects of this locale, in order, for the "next" navigation
const sorted = await getProjects(locale);
const currentIndex = sorted.findIndex((p) => p.id === entry.id);
const nextProject = sorted[(currentIndex + 1) % sorted.length];

const nextPreviews = nextProject.data.previewImages || [];
const pagePath = projectPath(entry.id, locale);
const ogImage = getOgImagePath(entry.id, locale);
const twitterImage = getTwitterImagePath(entry.id, locale);
const projectStructuredData = {
  '@context': 'https://schema.org',
  '@type': 'CreativeWork',
  name: entry.data.title,
  headline: entry.data.title,
  description: entry.data.description,
  url: toAbsoluteUrl(pagePath),
  image: toAbsoluteUrl(ogImage),
  inLanguage: getInLanguage(locale),
  mainEntityOfPage: toAbsoluteUrl(pagePath),
  author: {
    '@type': 'Person',
    name: 'Allison Peña',
    url: SITE_URL,
  },
  publisher: {
    '@type': 'Person',
    name: 'Allison Peña',
    url: SITE_URL,
  },
  isPartOf: {
    '@type': 'WebSite',
    name: SITE_NAME,
    url: SITE_URL,
  },
  ...(entry.data.year ? { datePublished: `${entry.data.year}-01-01` } : {}),
};
---

<Project
  title={entry.data.title}
  description={entry.data.description}
  slug={entry.id}
  canonical={pagePath}
  image={ogImage}
  twitterImage={twitterImage}
  year={entry.data.year}
  links={entry.data.links}
  employer={entry.data.employer}
  accent={projectAccents[entry.id]}
  structuredData={projectStructuredData}
>
  <div class="space-y-6 font-sans text-[16px] leading-[1.6] text-text tracking-[-0.01em]">
    <Content components={{ ImageFigure }} />
    <TechChips tech={entry.data.tech || []} />
  </div>

  <nav slot="after-article" class="mt-20">
    <p class="font-mono text-sm tracking-wide text-muted mb-16 md:mb-8">{t.project.next}</p>
    <div class="next-folder-stack">
      <ProjectFolderStack alwaysOpenPreviewsMobile>
        <ProjectFolderCard
          href={projectPath(nextProject.id, locale)}
          title={nextProject.data.title}
          description={nextProject.data.description}
          previewSrcs={nextPreviews}
          previewAlt={t.project.previewAlt(nextProject.data.title)}
          accent={projectAccents[nextProject.id]}
        />
      </ProjectFolderStack>
    </div>
  </nav>
</Project>

<style is:global>
  @media (max-width: 768px) {
    .next-folder-stack .project-folder-card[data-active='true'] .project-folder-card__link {
      transform: none !important;
      transition: none !important;
    }

    .next-folder-stack .project-folder-card [data-folder],
    .next-folder-stack .project-folder-card[data-active='true'] [data-folder] {
      --folder-fill-top: color-mix(in srgb, var(--folder-accent, var(--flexoki-green-400, var(--color-link))) 22%, var(--color-bg) 78%) !important;
      --folder-fill-bottom: color-mix(in srgb, var(--folder-accent, var(--flexoki-green-400, var(--color-link))) 12%, var(--color-bg) 88%) !important;
    }
  }
</style>
