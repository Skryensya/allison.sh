---
import Base from '@/layouts/Base.astro';
import Avatar from '@/components/Avatar.astro';
import Navbar from '@/components/Navbar.astro';
import Footer from '@/components/Footer.astro';
import ProjectFolderCard from '@/components/ProjectFolderCard.astro';
import ProjectFolderStack from '@/components/ProjectFolderStack.astro';
import { homePath, projectPath, type Locale } from '@/i18n';
import { messages } from '@/i18n/messages';
import { getProjects, projectAccents } from '@/lib/projects';
import {
  getInLanguage,
  getOgImagePath,
  getSiteDescription,
  getSiteRole,
  getTwitterImagePath,
  SITE_NAME,
  SITE_URL,
  SOCIAL_PROFILES,
  toAbsoluteUrl,
} from '@/lib/seo';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = messages[locale];
const projects = await getProjects(locale);
const description = getSiteDescription(locale);
const ogImage = getOgImagePath('index', locale);
const twitterImage = getTwitterImagePath('index', locale);
const pageUrl = toAbsoluteUrl(homePath(locale));

const homeStructuredData = [
  {
    '@context': 'https://schema.org',
    '@type': 'WebSite',
    name: SITE_NAME,
    url: pageUrl,
    description,
    image: toAbsoluteUrl(ogImage),
    inLanguage: getInLanguage(locale),
  },
  {
    '@context': 'https://schema.org',
    '@type': 'Person',
    name: 'Allison Peña',
    url: SITE_URL,
    jobTitle: getSiteRole(locale),
    description,
    image: toAbsoluteUrl(ogImage),
    email: 'mailto:contacto@allison.sh',
    sameAs: SOCIAL_PROFILES,
    inLanguage: getInLanguage(locale),
  },
];
---

<Base
  title={t.home.title}
  description={description}
  image={ogImage}
  imageAlt={t.home.imageAlt}
  twitterImage={twitterImage}
  twitterImageAlt={t.home.twitterImageAlt}
  canonical={homePath(locale)}
  structuredData={homeStructuredData}
>
  <Navbar />

  <main id="main-content" class="relative max-w-[42rem] mx-auto px-3 md:px-8 pt-4 pb-0">

    <section class="mt-20 md:mt-32 mb-36 md:mb-44">
      <h1 class="hero-heading font-display text-4xl md:text-5xl xl:text-6xl leading-[1.02] tracking-[-0.035em] text-balance max-w-[12ch]">
        {t.home.heroTitle}
      </h1>
      <p class="mt-6 font-sans text-[1.02rem] leading-[1.9] text-muted tracking-normal max-w-[34rem] text-pretty">
        {t.home.heroLead}
      </p>
    </section>

    <section id="proyectos" class="mb-4 md:mb-6 scroll-mt-20 relative z-20">
      <h2 class="font-mono text-[0.82rem] tracking-[0.16em] uppercase text-muted mb-6 md:mb-8">
        {t.home.projectsHeading}
      </h2>
      <ProjectFolderStack>
        {projects.map((p) => (
          <ProjectFolderCard
            href={projectPath(p.id, locale)}
            title={p.data.title}
            description={p.data.description}
            previewSrcs={p.data.previewImages}
            previewAlt={t.home.previewAlt(p.data.title)}
            accent={projectAccents[p.id]}
          />
        ))}
      </ProjectFolderStack>

    </section>

    <section id="sobre-mi" class="relative z-30 mb-32 md:mb-40 scroll-mt-64 pt-0">
      <p class="font-mono text-[0.82rem] tracking-[0.16em] uppercase text-muted mb-8 md:mb-10">
        {t.home.aboutHeading}
      </p>
      <div class="flex flex-col gap-8 items-start md:gap-10">
        <Avatar id="about-avatar" className="w-[160px] h-[160px] rounded-full avatar-frame" />
        <div class="space-y-6 max-w-[34rem]">
          <p class="font-sans text-[1.06rem] leading-[1.9] text-text text-pretty">
            {t.home.aboutLead}
          </p>
          <p class="font-sans text-base leading-[1.9] text-muted text-pretty">
            {t.home.aboutBody}{' '}
            <a href="https://fun.allison.sh" class="editorial-link" target="_blank" rel="noopener noreferrer">{t.home.aboutLinkText}<svg class="editorial-link__icon" aria-hidden="true" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 256 256" fill="currentColor"><path d="M204,64V168a12,12,0,0,1-24,0V93L72.49,200.49a12,12,0,0,1-17-17L163,76H88a12,12,0,0,1,0-24H192A12,12,0,0,1,204,64Z" /></svg></a>{' '}
            {t.home.aboutAfterLink}
          </p>
        </div>
      </div>
    </section>

    <div class="home-footer-area">
      <div class="home-footer-glow" aria-hidden="true">
        <span class="home-footer-glow__lick home-footer-glow__lick--a"></span>
        <span class="home-footer-glow__lick home-footer-glow__lick--b"></span>
      </div>
      <Footer tone="home" />
    </div>

  </main>

  <style>
    .home-footer-area {
      position: relative;
      isolation: isolate;
      --home-footer-glow-accent: color-mix(in srgb, var(--color-text) 12%, var(--color-bg));
      --home-footer-glow-opacity: 0.26;
    }

    .home-footer-glow {
      position: absolute;
      left: 50%;
      bottom: 0;
      z-index: -1;
      width: 100vw;
      height: min(84vh, 840px);
      opacity: var(--home-footer-glow-opacity);
      pointer-events: none;
      transform: translate3d(-50%, 0, 0);
      transform-origin: 50% 100%;
      overflow: hidden;
      mask-image: linear-gradient(to top, black 0%, black 42%, transparent 92%);
      -webkit-mask-image: linear-gradient(to top, black 0%, black 42%, transparent 92%);
    }

    .home-footer-glow::before,
    .home-footer-glow::after {
      content: '';
      position: absolute;
      left: 50%;
      bottom: 0;
      pointer-events: none;
      transform: translateX(-50%);
    }

    .home-footer-glow::before {
      width: min(220vw, 2200px);
      height: 100%;
      background:
        radial-gradient(
          ellipse at 50% 100%,
          color-mix(in srgb, var(--home-footer-glow-accent) 34%, transparent) 0%,
          color-mix(in srgb, var(--home-footer-glow-accent) 18%, transparent) 22%,
          color-mix(in srgb, var(--home-footer-glow-accent) 7%, transparent) 56%,
          transparent 84%
        ),
        radial-gradient(
          ellipse at 4% 100%,
          color-mix(in srgb, var(--home-footer-glow-accent) 11%, transparent) 0%,
          color-mix(in srgb, var(--home-footer-glow-accent) 5%, transparent) 44%,
          transparent 74%
        ),
        radial-gradient(
          ellipse at 96% 100%,
          color-mix(in srgb, var(--home-footer-glow-accent) 11%, transparent) 0%,
          color-mix(in srgb, var(--home-footer-glow-accent) 5%, transparent) 44%,
          transparent 74%
        ),
        linear-gradient(
          to top,
          color-mix(in srgb, var(--home-footer-glow-accent) 9%, transparent) 0%,
          color-mix(in srgb, var(--home-footer-glow-accent) 3%, transparent) 38%,
          transparent 72%
        );
      filter: blur(18px);
      opacity: 0.44;
    }

    .home-footer-glow::after {
      bottom: 0;
      width: min(176vw, 1760px);
      height: 78%;
      background:
        radial-gradient(
          ellipse at 50% 100%,
          color-mix(in srgb, var(--home-footer-glow-accent) 22%, transparent) 0%,
          color-mix(in srgb, var(--home-footer-glow-accent) 10%, transparent) 30%,
          transparent 72%
        ),
        radial-gradient(
          ellipse at 0% 100%,
          color-mix(in srgb, var(--home-footer-glow-accent) 7%, transparent) 0%,
          transparent 64%
        ),
        radial-gradient(
          ellipse at 100% 100%,
          color-mix(in srgb, var(--home-footer-glow-accent) 7%, transparent) 0%,
          transparent 64%
        );
      filter: blur(10px);
      opacity: 0.28;
    }

    .home-footer-glow__lick {
      position: absolute;
      left: 50%;
      bottom: 0;
      width: min(42vw, 460px);
      height: 62%;
      border-radius: 999px;
      background: radial-gradient(
        ellipse at 50% 100%,
        color-mix(in srgb, var(--home-footer-glow-accent) 18%, transparent) 0%,
        color-mix(in srgb, var(--home-footer-glow-accent) 7%, transparent) 34%,
        transparent 72%
      );
      filter: blur(12px);
      opacity: 0;
      pointer-events: none;
      transform-origin: 50% 100%;
    }

    .home-footer-glow__lick--a {
      opacity: 0.08;
      transform: translateX(-58%) translateY(-6%) scaleX(0.95) scaleY(1.02);
    }

    .home-footer-glow__lick--b {
      opacity: 0.06;
      transform: translateX(-36%) translateY(-4%) scaleX(0.86) scaleY(0.96);
    }

    :global(html.dark) .home-footer-area {
      --home-footer-glow-accent: var(--color-home-text);
      --home-footer-glow-opacity: 0.23;
    }

    :global(html.dark) .home-footer-glow::before {
      background:
        radial-gradient(
          ellipse at 50% 100%,
          color-mix(in srgb, var(--home-footer-glow-accent) 38%, transparent) 0%,
          color-mix(in srgb, var(--home-footer-glow-accent) 22%, transparent) 24%,
          color-mix(in srgb, var(--home-footer-glow-accent) 9%, transparent) 57%,
          transparent 85%
        ),
        radial-gradient(
          ellipse at 4% 100%,
          color-mix(in srgb, var(--home-footer-glow-accent) 17%, transparent) 0%,
          color-mix(in srgb, var(--home-footer-glow-accent) 8%, transparent) 44%,
          transparent 76%
        ),
        radial-gradient(
          ellipse at 96% 100%,
          color-mix(in srgb, var(--home-footer-glow-accent) 17%, transparent) 0%,
          color-mix(in srgb, var(--home-footer-glow-accent) 8%, transparent) 44%,
          transparent 76%
        ),
        linear-gradient(
          to top,
          color-mix(in srgb, var(--home-footer-glow-accent) 8%, transparent) 0%,
          color-mix(in srgb, var(--home-footer-glow-accent) 3.1%, transparent) 40%,
          transparent 74%
        );
      opacity: 0.58;
      filter: blur(16px);
    }

    :global(html.dark) .home-footer-glow::after {
      background:
        radial-gradient(
          ellipse at 50% 100%,
          color-mix(in srgb, var(--home-footer-glow-accent) 26%, transparent) 0%,
          color-mix(in srgb, var(--home-footer-glow-accent) 14%, transparent) 34%,
          transparent 75%
        ),
        radial-gradient(
          ellipse at 0% 100%,
          color-mix(in srgb, var(--home-footer-glow-accent) 10%, transparent) 0%,
          transparent 66%
        ),
        radial-gradient(
          ellipse at 100% 100%,
          color-mix(in srgb, var(--home-footer-glow-accent) 10%, transparent) 0%,
          transparent 66%
        );
      opacity: 0.36;
    }

    :global(html.dark) .home-footer-glow__lick {
      background: radial-gradient(
        ellipse at 50% 100%,
        color-mix(in srgb, var(--home-footer-glow-accent) 27%, transparent) 0%,
        color-mix(in srgb, var(--home-footer-glow-accent) 13%, transparent) 36%,
        transparent 74%
      );
    }

    @media (prefers-reduced-motion: reduce) {
      .home-footer-glow::before,
      .home-footer-glow::after,
      .home-footer-glow__lick {
        animation: none;
      }
    }
  </style>
</Base>
