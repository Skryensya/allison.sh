---
interface Props {
  className?: string;
}

const { className = '' } = Astro.props;
---

<div class={`single-folder-wrap ${className}`} data-single-folder>
  <div class="single-folder__backdrop"></div>
  <div class="single-folder__content">
    <slot />
  </div>
</div>

<style>
  .single-folder-wrap {
    position: relative;
  }

  /* Paper-like backdrop with grainy gradient */
  .single-folder__backdrop {
    position: absolute;
    inset: 0;
    pointer-events: none;
    z-index: 1;
    opacity: 0;
    transition: opacity 250ms cubic-bezier(0.16, 1, 0.3, 1);

    /* Paper texture gradient - full color at top, fades to bg at bottom */
    background:
      /* Paper grain texture */
      url("data:image/svg+xml,%3Csvg viewBox='0 0 200 200' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='noise'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='0.9' numOctaves='4' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23noise)'/%3E%3C/svg%3E"),
      /* Color gradient - stronger at top, subtle at bottom */
      linear-gradient(
        180deg,
        color-mix(in srgb, var(--color-bg) 75%, var(--color-text) 25%) 0%,
        color-mix(in srgb, var(--color-bg) 88%, var(--color-text) 12%) 40%,
        color-mix(in srgb, var(--color-bg) 96%, var(--color-text) 4%) 70%,
        transparent 100%
      );
    background-blend-mode: soft-light, normal;
    
    /* Top edge shadow */
    box-shadow:
      inset 0 1px 0 color-mix(in srgb, var(--color-text) 6%, transparent),
      0 1px 3px color-mix(in srgb, var(--color-text) 3%, transparent);
  }

  @media (prefers-color-scheme: dark) {
    .single-folder__backdrop {
      background:
        url("data:image/svg+xml,%3Csvg viewBox='0 0 200 200' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='noise'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='0.9' numOctaves='4' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23noise)'/%3E%3C/svg%3E"),
        linear-gradient(
          180deg,
          color-mix(in srgb, var(--color-bg) 70%, var(--color-text) 30%) 0%,
          color-mix(in srgb, var(--color-bg) 85%, var(--color-text) 15%) 40%,
          color-mix(in srgb, var(--color-bg) 96%, var(--color-text) 4%) 70%,
          transparent 100%
        );
      background-blend-mode: soft-light, normal;
    }
  }

  /* Hover: reveal paper effect */
  @media (hover: hover) and (pointer: fine) {
    .single-folder-wrap:hover .single-folder__backdrop {
      opacity: 1;
    }
  }

  /* Show on focus-within (keyboard navigation) */
  .single-folder-wrap:focus-within .single-folder__backdrop {
    opacity: 1;
  }

  .single-folder__content {
    position: relative;
    z-index: 2;
  }

  @media (prefers-reduced-motion: reduce) {
    .single-folder__backdrop {
      transition: none;
    }
  }
</style>
