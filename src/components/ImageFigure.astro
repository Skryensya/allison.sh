---
import HalftonePolaroid from '@/components/HalftonePolaroid';

interface Props {
  src: string;
  alt: string;
  caption?: string;
  wide?: boolean; // true = extends to left, false = extends to right
  credit?: string;
}

const { src, alt, caption, wide = false, credit } = Astro.props;
---

<figure class={`image-figure ${wide ? 'image-figure--wide' : 'image-figure--narrow'}`}>
  <HalftonePolaroid
    client:only="react"
    src={src}
    alt={alt}
    caption={caption}
    showCaption={true}
  />

  {credit && (
    <figcaption class="image-figure__meta">
      <span class="image-figure__credit">{credit}</span>
    </figcaption>
  )}
</figure>

<style>
  .image-figure {
    --breakout-size: 8rem;
    margin-top: 2.75rem;
    margin-bottom: 2.75rem;
    margin-left: calc(var(--breakout-size) * -1);
    margin-right: calc(var(--breakout-size) * -1);
  }

  @media (min-width: 768px) {
    .image-figure {
      margin-left: calc(var(--breakout-size) * -1);
      margin-right: calc(var(--breakout-size) * -1);
    }

    .image-figure--wide {
      --breakout-size: 12rem;
    }
  }

  .image-figure__meta {
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    color: var(--color-subtle);
    margin-top: 0.75rem;
    padding-left: 0.25rem;
    padding-right: 0.25rem;
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
  }

  .image-figure__credit {
    color: var(--color-muted);
    font-size: 0.625rem;
  }
</style>
