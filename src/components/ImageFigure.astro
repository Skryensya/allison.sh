---
import type { ImageMetadata } from 'astro:assets';
import PolaroidFigure from './PolaroidFigure.astro';

interface Props {
  src: ImageMetadata;
  alt: string;
  caption?: string;
  priority?: boolean;
}

const { src, alt, caption, priority = false } = Astro.props;
---

<PolaroidFigure src={src} alt={alt} caption={caption} priority={priority} />
