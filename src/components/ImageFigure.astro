---
import PolaroidFigure from './PolaroidFigure';

interface Props {
  src: string;
  alt: string;
  caption?: string;
  credit?: string;
  color?: string;
}

const { src, alt, caption, credit, color } = Astro.props;
---

<PolaroidFigure 
  client:load
  src={src} 
  alt={alt} 
  caption={caption}
  showCaption={true}
  color={color}
/>
