---
interface Props {
  tone?: 'page' | 'home';
}

const { tone = 'page' } = Astro.props;
const emailLinkMarkup = `<!--email_off--><a href="mailto:contacto@allison.sh" class="footer-contact-link font-sans text-xl md:text-2xl leading-tight">contacto@allison.sh</a><!--/email_off-->`;
const colorClass = tone === 'home' ? 'text-home' : 'text-text';
---

<section id="contacto" aria-labelledby="contacto-heading" class={`relative z-[60] ${colorClass} pt-12 pb-24 md:pt-16 md:pb-32`}>
    <h2 id="contacto-heading" class="sr-only">Contacto</h2>
    <p class="font-mono text-[0.82rem] tracking-[0.16em] uppercase mb-8 md:mb-10">Contacto</p>
    <ul class="space-y-3 -mx-1 md:-mx-2 max-w-[34rem]">
      <li set:html={emailLinkMarkup}></li>
      <li>
        <a
          href="https://linkedin.com/in/skryensya"
          class="footer-contact-link font-sans text-xl md:text-2xl leading-tight"
          target="_blank"
          rel="noopener noreferrer"
        >
          linkedin.com/in/skryensya
        </a>
      </li>
      <li>
        <a
          href="https://github.com/Skryensya"
          class="footer-contact-link font-sans text-xl md:text-2xl leading-tight"
          target="_blank"
          rel="noopener noreferrer"
        >
          github.com/skryensya
        </a>
      </li>
    </ul>
</section>

<footer class={`relative z-[60] ${colorClass} font-mono text-xs tracking-wide flex items-center justify-between gap-4 py-10 md:py-12`}>
    <div class="flex items-center gap-3 tabular-nums">
      <p>© 2026 Allison Peña</p>
      <span aria-label="Versión del sitio">v2.0</span>
    </div>
    <button
      id="theme-toggle"
      class="theme-toggle pointer-events-auto opacity-100 cursor-pointer -mr-1"
      aria-label="Cambiar tema"
      title="Cambiar tema"
    >
      <span class="theme-toggle__icons" aria-hidden="true">
        <svg class="theme-toggle__icon sun-icon w-4 h-4" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 256 256" fill="currentColor">
          <path d="M120,40V32a8,8,0,0,1,16,0v8a8,8,0,0,1-16,0Zm72,88a64,64,0,1,1-64-64A64.07,64.07,0,0,1,192,128Zm-16,0a48,48,0,1,0-48,48A48.05,48.05,0,0,0,176,128ZM58.34,69.66A8,8,0,0,0,69.66,58.34l-8-8A8,8,0,0,0,50.34,61.66Zm0,116.68-8,8a8,8,0,0,0,11.32,11.32l8-8a8,8,0,0,0-11.32-11.32ZM192,72a8,8,0,0,0,5.66-2.34l8-8a8,8,0,0,0-11.32-11.32l-8,8A8,8,0,0,0,192,72Zm5.66,114.34a8,8,0,0,0-11.32,11.32l8,8a8,8,0,0,0,11.32-11.32ZM40,120H32a8,8,0,0,0,0,16h8a8,8,0,0,0,0-16Zm88,88a8,8,0,0,0-8,8v8a8,8,0,0,0,16,0v-8A8,8,0,0,0,128,208Zm96-88h-8a8,8,0,0,0,0,16h8a8,8,0,0,0,0-16Z"/>
        </svg>
        <svg class="theme-toggle__icon moon-icon w-4 h-4" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 256 256" fill="currentColor">
          <path d="M233.54,142.23a8,8,0,0,0-8-2,88.08,88.08,0,0,1-109.8-109.8,8,8,0,0,0-10-10,104.84,104.84,0,0,0-52.91,37A104,104,0,0,0,136,224a103.09,103.09,0,0,0,62.52-20.88,104.84,104.84,0,0,0,37-52.91A8,8,0,0,0,233.54,142.23ZM188.9,190.34A88,88,0,0,1,65.66,67.11a89,89,0,0,1,31.4-26A106,106,0,0,0,96,56,104.11,104.11,0,0,0,200,160a106,106,0,0,0,14.92-1.06A89,89,0,0,1,188.9,190.34Z"/>
        </svg>
      </span>
    </button>
</footer>
