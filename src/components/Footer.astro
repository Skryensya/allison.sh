---
const emailLinkMarkup = `<!--email_off--><a href="mailto:contacto@allison.sh" class="footer-contact-link font-sans text-xl md:text-2xl leading-tight">contacto@allison.sh</a><!--/email_off-->`;
---

<div class="relative z-[60]">
  <section id="contacto" aria-labelledby="contacto-heading" class="mb-32 md:mb-40 pt-12 md:pt-16">
    <h2 id="contacto-heading" class="sr-only">Contacto</h2>
    <p class="font-mono text-[0.82rem] tracking-[0.16em] uppercase text-muted mb-8 md:mb-10">Contacto</p>
    <ul class="space-y-3 -mx-2 max-w-[34rem]">
      <li set:html={emailLinkMarkup}></li>
      <li>
        <a
          href="https://linkedin.com/in/skryensya"
          class="footer-contact-link font-sans text-xl md:text-2xl leading-tight"
          target="_blank"
          rel="noopener noreferrer"
        >
          linkedin.com/in/skryensya
        </a>
      </li>
      <li>
        <a
          href="https://github.com/Skryensya"
          class="footer-contact-link font-sans text-xl md:text-2xl leading-tight"
          target="_blank"
          rel="noopener noreferrer"
        >
          github.com/skryensya
        </a>
      </li>
    </ul>
  </section>

  <footer class="font-mono text-xs tracking-wide text-muted flex items-center justify-between gap-4 pt-5">
    <div class="flex items-center gap-3 tabular-nums">
      <p>© 2026 Allison Peña</p>
      <span aria-label="Versión del sitio">v2.0</span>
    </div>
    <button
      id="theme-toggle"
      class="theme-toggle pointer-events-auto opacity-80 hover:opacity-100 cursor-pointer -mr-1"
      aria-label="Cambiar tema"
      title="Cambiar tema"
    >
      <span class="theme-toggle__icons" aria-hidden="true">
        <!-- Sun icon (visible in dark mode) -->
        <svg class="theme-toggle__icon sun-icon w-4 h-4" fill="none" stroke-width="1.5" viewBox="0 0 24 24">
          <circle cx="12" cy="12" r="4" stroke="currentColor"/>
          <path stroke-linecap="round" d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M6.34 17.66l-1.41 1.41M19.07 4.93l-1.41 1.41" stroke="currentColor"/>
        </svg>
        <!-- Moon icon (visible in light mode) -->
        <svg class="theme-toggle__icon moon-icon w-4 h-4" fill="none" stroke-width="1.5" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z" stroke="currentColor"/>
        </svg>
      </span>
    </button>
  </footer>
</div>
