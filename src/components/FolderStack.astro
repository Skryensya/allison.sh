---
interface Props {
  /**
   * How much each folder overlaps the previous one.
   * (Bigger = tighter stack)
   */
  overlap?: string;
  /** Small positive spacing added back so the stack can breathe. */
  gap?: string;
  /** Lift amount on hover/focus/active */
  lift?: string;
}

const { overlap, gap, lift } = Astro.props;

const styleParts: string[] = [];
if (overlap) styleParts.push(`--folder-overlap:${overlap}`);
if (gap) styleParts.push(`--folder-gap:${gap}`);
if (lift) styleParts.push(`--folder-lift:${lift}`);

const style = styleParts.length ? styleParts.join('; ') : undefined;
---

<ul
  class="folder-stack"
  data-folder-stack
  style={style}
>
  <slot />
</ul>

<style is:global>
  /* Folder stack: overlapping pile with subtle randomness + micro-interactions */
  .folder-stack {
    /* Defaults (can be overridden by inline CSS vars via props) */
    --folder-overlap: 260px;
    --folder-gap: 38px;
    /* Separate more on hover */
    --folder-lift: 14px;

    /* How much “tighter” the stack starts before it relaxes into place */
    --stack-compress-step: 12px;

    /* Make this an offset context so item.offsetTop is stable & transform-independent. */
    position: relative;

    list-style: none;
    padding: 0;
    margin: 0;
  }

  @media (max-width: 640px) {
    .folder-stack {
      --folder-overlap: 230px;
      --folder-gap: 30px;
      --folder-lift: 12px;
      --stack-compress-step: 10px;
    }
  }

  @media (max-width: 420px) {
    .folder-stack {
      --folder-overlap: 210px;
      --folder-gap: 26px;
      --folder-lift: 10px;
      --stack-compress-step: 8px;
    }
  }

  /* Shadow: almost invisible while stacked (avoid a dark band), comes alive on hover. */
  .folder-stack [data-folder] {
    /* Near-transparent at rest: should read as “almost none”. */
    --folder-shadow-filter:
      drop-shadow(0 -3px 8px color-mix(in srgb, var(--color-text) 0.45%, transparent))
      drop-shadow(0 -1px 2px color-mix(in srgb, var(--color-text) 0.18%, transparent));
  }

  .folder-stack__item {
    position: relative;

    /* No tilt / no sideways drift */
    --stack-x: 0px;
    --stack-y: 0px;
    --stack-rot: 0deg;
  }

  .folder-stack__item + .folder-stack__item {
    margin-top: calc(-1 * var(--folder-overlap) + var(--folder-gap));
  }

  /* The stack relaxation happens on the LI (so hover lift on the link never fights it). */
  .folder-stack__item {
    transform: translate3d(0, 0, 0);
    will-change: transform;
  }

  /* Pre-state: start a bit tighter before the list animates in. */
  .folder-stack.is-pre .folder-stack__item {
    transform: translate3d(0, calc(-1 * (var(--stack-compress-step) * var(--i, 0))), 0);
  }

  @keyframes folder-stack-relax {
    0% {
      transform: translate3d(0, calc(-1 * (var(--stack-compress-step) * var(--i, 0))), 0);
    }

    72% {
      transform: translate3d(0, 2px, 0);
    }

    100% {
      transform: translate3d(0, 0, 0);
    }
  }

  /* Run once: while relaxing */
  .folder-stack.is-relaxing .folder-stack__item {
    animation: folder-stack-relax 720ms cubic-bezier(0.22, 1, 0.36, 1) both;
    animation-delay: calc(var(--i, 0) * 75ms);
  }

  .folder-stack__link {
    display: block;
    text-decoration: none;

    /* Hover lift lives here, separate from stack relax */
    transform: translate3d(0, 0, 0) scale(1);
    transform-origin: 50% 90%;

    transition: transform 200ms cubic-bezier(0.23, 1, 0.32, 1);
    will-change: transform;
    backface-visibility: hidden;
  }

  /* Active (touch) also lifts */
  .folder-stack__item[data-active='true'] .folder-stack__link {
    transform: translate3d(0, calc(-1 * var(--folder-lift)), 0) scale(1.004);
  }

  /* Hover + focus lift only on devices that truly hover */
  @media (hover: hover) and (pointer: fine) {
    .folder-stack__item:hover .folder-stack__link {
      transform: translate3d(0, calc(-1 * var(--folder-lift)), 0) scale(1.004);
    }
  }

  .folder-stack__item:focus-within .folder-stack__link {
    transform: translate3d(0, calc(-1 * var(--folder-lift)), 0) scale(1.004);
  }

  .folder-stack__link:active {
    transform: translate3d(0, calc(-1 * (var(--folder-lift) - 2px)), 0) scale(1.002);
  }

  /* Delight: subtle fill nudge + shadow ramps up only when a folder is “picked up”. */
  .folder-stack__item:hover [data-folder],
  .folder-stack__item:focus-within [data-folder],
  .folder-stack__item[data-active='true'] [data-folder] {
    --folder-fill: color-mix(in srgb, var(--color-bg) 95%, var(--color-text) 5%);
    --folder-shadow-filter:
      drop-shadow(0 -8px 16px color-mix(in srgb, var(--color-text) 3.2%, transparent))
      drop-shadow(0 -2px 5px color-mix(in srgb, var(--color-text) 1.4%, transparent));
  }

  @media (prefers-reduced-motion: reduce) {
    .folder-stack__item {
      animation: none !important;
      transform: none !important;
    }

    .folder-stack__link {
      transition: none;
      transform: none !important;
    }
  }
</style>

<script>
  // Folder stack: in-view relax animation + mobile “current folder” while scrolling.
  (function () {
    // This component can appear on multiple pages with Astro view transitions.
    // Guard against registering duplicate global listeners.
    if (window.__folderStackScriptLoaded) return;
    window.__folderStackScriptLoaded = true;

    const state = (window.__folderStackState ||= { controllers: [], observers: [] });

    function cleanupFolderStacks() {
      // Remove window listeners created for previous pages.
      state.controllers.forEach((c) => {
        try {
          c.abort();
        } catch {
          // ignore
        }
      });
      state.controllers.length = 0;

      // Disconnect any observers that may still be alive.
      state.observers.forEach((o) => {
        try {
          o.disconnect();
        } catch {
          // ignore
        }
      });
      state.observers.length = 0;
    }

    if (!window.__folderStackCleanupBound) {
      window.__folderStackCleanupBound = true;
      // Fired by Astro view transitions before swapping DOM.
      window.addEventListener('astro:before-preparation', cleanupFolderStacks);
      // Safety for bfcache / tab close.
      window.addEventListener('pagehide', cleanupFolderStacks);
    }

    function initFolderStacks() {
      const stacks = document.querySelectorAll('[data-folder-stack]');
      if (!stacks.length) return;

      const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

      stacks.forEach((stack) => {
        if (!(stack instanceof HTMLElement)) return;
        if (stack.dataset.stackInit === 'true') return;
        stack.dataset.stackInit = 'true';

        // Enable the “tight -> relaxed” in-view animation.
        stack.classList.add('is-observed');
        stack.classList.add('is-pre');

        const reveal = () => {
          if (stack.dataset.inviewDone === 'true') return;
          stack.dataset.inviewDone = 'true';

          stack.classList.add('is-relaxing');

          const count = stack.querySelectorAll('[data-folder-stack-item]').length;
          const total = 720 + Math.max(0, count - 1) * 75 + 80;
          window.setTimeout(() => {
            stack.classList.remove('is-relaxing');
            stack.classList.remove('is-pre');
            stack.classList.add('is-relaxed');
          }, total);
        };

        if (prefersReducedMotion) {
          // No motion: show final state immediately (but keep interactions).
          stack.classList.remove('is-pre');
          stack.classList.add('is-relaxed');
        } else {
          // If already in view, kick the animation on next frame.
          const rect = stack.getBoundingClientRect();
          const isInitiallyInView = rect.top < window.innerHeight && rect.bottom > 0;
          if (isInitiallyInView) {
            requestAnimationFrame(reveal);
          }

          // Otherwise, reveal when it enters the viewport.
          const io = new IntersectionObserver(
            (entries) => {
              if (!entries.some((e) => e.isIntersecting)) return;
              io.disconnect();
              requestAnimationFrame(reveal);
            },
            {
              threshold: 0.12,
              rootMargin: '0px 0px -10% 0px',
            }
          );

          state.observers.push(io);
          io.observe(stack);
        }

        // --- Mobile: no hover. Keep one folder “current” while scrolling. ---
        // Use an activation line slightly ABOVE center so the active one doesn't lag below.
        // This is intentionally simple (and fast): rAF-throttled scroll + a small loop.
        const enableAutoActive = window.matchMedia('(max-width: 768px)').matches;
        if (!enableAutoActive) return;

        const items = Array.from(stack.querySelectorAll('[data-folder-stack-item]')).filter(
          (el) => el instanceof HTMLElement
        );
        if (!items.length) return;

        const ACTIVE_LINE = 0.42; // 0..1 of viewport height
        const MIN_VISIBLE_RATIO = 0.5; // only show “current” when stack fills >= 50% of viewport

        /** Cached layout (document coordinates). Recomputed on resize / content changes. */
        let metricsReady = false;
        let stackTop = 0;
        let stackBottom = 0;
        let itemTops = [];

        let activeItem = null;

        function clearActive() {
          if (!activeItem) return;
          activeItem.dataset.active = 'false';
          activeItem = null;
        }

        function setActive(item) {
          if (!item) return;
          if (activeItem === item) return;
          if (activeItem) activeItem.dataset.active = 'false';
          activeItem = item;
          activeItem.dataset.active = 'true';
        }

        function recalcMetrics() {
          const sy = window.scrollY || window.pageYOffset || 0;
          const srect = stack.getBoundingClientRect();
          stackTop = srect.top + sy;
          stackBottom = srect.bottom + sy;

          itemTops = new Array(items.length);
          for (let i = 0; i < items.length; i++) {
            // offsetTop is cheap and ignores transforms (important during the relax animation).
            itemTops[i] = stackTop + items[i].offsetTop;
          }

          metricsReady = true;
        }

        function stackVisibleHeight(sy, vh) {
          return Math.max(0, Math.min(stackBottom, sy + vh) - Math.max(stackTop, sy));
        }

        function pickActive() {
          const vh = window.innerHeight || 0;
          const sy = window.scrollY || window.pageYOffset || 0;
          if (!vh) return;

          if (!metricsReady) recalcMetrics();

          // Gate: only when stack is meaningfully on screen.
          const visible = stackVisibleHeight(sy, vh);
          if (visible < vh * MIN_VISIBLE_RATIO) {
            clearActive();
            return;
          }

          const yDoc = sy + vh * ACTIVE_LINE;

          // Find last item whose top is above the activation line.
          // Binary search keeps scroll work tiny.
          let lo = 0;
          let hi = itemTops.length - 1;
          let ans = 0;

          while (lo <= hi) {
            const mid = (lo + hi) >> 1;
            if (itemTops[mid] <= yDoc) {
              ans = mid;
              lo = mid + 1;
            } else {
              hi = mid - 1;
            }
          }

          setActive(items[ans]);
        }

        let raf = 0;
        function scheduleUpdate() {
          if (raf) return;
          raf = window.requestAnimationFrame(() => {
            raf = 0;
            pickActive();
          });
        }

        let recalcRaf = 0;
        function scheduleRecalc() {
          if (recalcRaf) return;
          recalcRaf = window.requestAnimationFrame(() => {
            recalcRaf = 0;
            recalcMetrics();
            pickActive();
          });
        }

        const ac = new AbortController();
        state.controllers.push(ac);

        // Recalc when layout changes (folder heights can change after hydration).
        const ro = new ResizeObserver(scheduleRecalc);
        state.observers.push(ro);
        ro.observe(stack);

        recalcMetrics();
        pickActive();

        window.addEventListener('scroll', scheduleUpdate, { passive: true, signal: ac.signal });
        window.addEventListener('resize', scheduleRecalc, { signal: ac.signal });
      });
    }

    const boot = () => initFolderStacks();

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', boot, { once: true });
    } else {
      boot();
    }

    // Astro view transitions support
    document.addEventListener('astro:page-load', boot);
  })();
</script>
