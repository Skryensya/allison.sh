---
interface Props {
  /**
   * How much each folder overlaps the previous one.
   * (Bigger = tighter stack)
   */
  overlap?: string;
  /** Small positive spacing added back so the stack can breathe. */
  gap?: string;
  /** Lift amount on hover/focus/active */
  lift?: string;
}

const { overlap, gap, lift } = Astro.props;

const styleParts: string[] = [];
if (overlap) styleParts.push(`--folder-overlap:${overlap}`);
if (gap) styleParts.push(`--folder-gap:${gap}`);
if (lift) styleParts.push(`--folder-lift:${lift}`);

const style = styleParts.length ? styleParts.join('; ') : undefined;
---

<div class="folder-stack-wrap">
  <ul
    class="folder-stack"
    data-folder-stack
    style={style}
  >
    <slot />
  </ul>
  <div class="folder-stack__tail-mask" aria-hidden="true"></div>
</div>

<style is:global>
  /* Folder stack: overlapping pile with subtle randomness + micro-interactions */
  .folder-stack-wrap {
    position: relative;
    --folder-tail-mask-h: 120px;
  }

  .folder-stack {
    /* Defaults (can be overridden by inline CSS vars via props) */
    --folder-overlap: 260px;
    --folder-gap: 38px;
    /* Separate more on hover */
    --folder-lift: 14px;

    /* How much "tighter" the stack starts before it relaxes into place */
    --stack-compress-step: 12px;

    /* Make this an offset context so item.offsetTop is stable & transform-independent. */
    position: relative;

    list-style: none;
    padding: 0;
    margin: 0;
  }

  @media (max-width: 640px) {
    .folder-stack-wrap {
      --folder-tail-mask-h: 104px;
    }

    .folder-stack {
      --folder-overlap: 208px;
      --folder-gap: 38px;
      --folder-lift: 12px;
      --stack-compress-step: 10px;
    }
  }

  @media (max-width: 420px) {
    .folder-stack-wrap {
      --folder-tail-mask-h: 92px;
    }

    .folder-stack {
      --folder-overlap: 188px;
      --folder-gap: 34px;
      --folder-lift: 10px;
      --stack-compress-step: 8px;
    }
  }

  .folder-stack__gradient {
    position: absolute;
    left: -10%;
    right: -10%;
    bottom: 0;
    width: 120%;
    height: 100%;
    background: linear-gradient(
      to bottom,
      transparent 0%,
      transparent 40%,
      color-mix(in srgb, var(--color-bg) 40%, transparent) 55%,
      color-mix(in srgb, var(--color-bg) 80%, transparent) 70%,
      var(--color-bg) 80% 100%
    );
    pointer-events: none;
    z-index: 26;
  }

  /* .folder-stack__item:last-child .folder-stack__gradient {
    display: none;
  } */


  /* Shadow: almost invisible while stacked (avoid a dark band), comes alive on hover. */
  .folder-stack [data-folder] {
    /* Near-transparent at rest: should read as "almost none". */
    --folder-shadow-filter:
      drop-shadow(0 -3px 8px color-mix(in srgb, var(--folder-shadow-ink, var(--color-text)) 0.32%, transparent))
      drop-shadow(0 -1px 2px color-mix(in srgb, var(--folder-shadow-ink, var(--color-text)) 0.12%, transparent));
  }

  .folder-stack__item {
    position: relative;

    /*
      Critical: let "empty" parts of the folder bounding box pass through.
      The only clickable/hoverable element is the clipped .folder-stack__hit link.
    */
    pointer-events: none;

    /*
      Bleed into the page padding so the folder's inner padding can match the
      page text container width.

      (Uses the global --folder-pad-x which matches `px-6 md:px-8`.)
    */
    width: calc(100% + var(--folder-pad-x) + var(--folder-pad-x));
    margin-left: calc(0px - var(--folder-pad-x));
    margin-right: calc(0px - var(--folder-pad-x));

    /*
      3D context for hover tilt (applies to the hit + card children).
      Keeping it per-item avoids the whole stack becoming one 3D scene.
    */
    perspective: 950px;

    /* Uniform hover motion: like pulling a folder slightly forward from a cabinet */
    --folder-hover-rx: -3.4deg;
    --folder-hover-ry: 0deg;
    --folder-hover-rz: 0deg;
    --folder-hover-z: 2px;
    --preview-mobile-x: 0px;
    --preview-mobile-rot: -0.8deg;
    --preview-mobile-spread: 62px;
    --preview-mobile-lift: 36px;

    /* Hidden at rest; rise clearly above the folder on hover. */
    --preview-center-rest-x: -8px;
    --preview-center-rest-y: 28px;
    --preview-center-rest-rot: -0.8deg;
    --preview-left-rest-x: 84px;
    --preview-left-rest-y: 34px;
    --preview-left-rest-rot: -2.4deg;
    --preview-right-rest-x: 76px;
    --preview-right-rest-y: 38px;
    --preview-right-rest-rot: 2.8deg;

    --preview-center-hover-x: -6px;
    --preview-center-hover-y: -232px;
    --preview-center-hover-rot: -0.2deg;
    --preview-left-hover-x: 92px;
    --preview-left-hover-y: -222px;
    --preview-left-hover-rot: -1.8deg;
    --preview-right-hover-x: 82px;
    --preview-right-hover-y: -198px;
    --preview-right-hover-rot: 2.2deg;
  }

  .folder-stack__item:nth-child(4n + 1) {
    --preview-mobile-x: -14px;
    --preview-mobile-rot: 1.6deg;
    --preview-mobile-spread: 66px;
    --preview-mobile-lift: 40px;
    --preview-center-rest-x: -14px;
    --preview-center-rest-rot: 0.7deg;
    --preview-left-rest-x: 92px;
    --preview-left-rest-rot: -2.8deg;
    --preview-right-rest-x: 82px;
    --preview-right-rest-rot: 3.2deg;
    --preview-center-hover-x: -10px;
    --preview-center-hover-rot: 0.2deg;
    --preview-left-hover-x: 104px;
    --preview-left-hover-rot: -2deg;
    --preview-right-hover-x: 92px;
    --preview-right-hover-rot: 2.4deg;
  }

  .folder-stack__item:nth-child(4n + 2) {
    --preview-mobile-x: 14px;
    --preview-mobile-rot: -1.9deg;
    --preview-mobile-spread: 58px;
    --preview-mobile-lift: 34px;
    --preview-center-rest-x: 10px;
    --preview-center-rest-rot: -1deg;
    --preview-left-rest-x: 66px;
    --preview-left-rest-rot: -1.8deg;
    --preview-right-rest-x: 70px;
    --preview-right-rest-rot: 2.8deg;
    --preview-center-hover-x: 4px;
    --preview-center-hover-rot: -0.3deg;
    --preview-left-hover-x: 86px;
    --preview-left-hover-rot: -1.4deg;
    --preview-right-hover-x: 78px;
    --preview-right-hover-rot: 2deg;
  }

  .folder-stack__item:nth-child(4n + 3) {
    --preview-mobile-x: -10px;
    --preview-mobile-rot: 1.1deg;
    --preview-mobile-spread: 70px;
    --preview-mobile-lift: 42px;
    --preview-center-rest-x: -10px;
    --preview-center-rest-rot: 0.9deg;
    --preview-left-rest-x: 96px;
    --preview-left-rest-rot: -3deg;
    --preview-right-rest-x: 84px;
    --preview-right-rest-rot: 3.4deg;
    --preview-center-hover-x: -6px;
    --preview-center-hover-rot: 0.3deg;
    --preview-left-hover-x: 112px;
    --preview-left-hover-rot: -2.2deg;
    --preview-right-hover-x: 94px;
    --preview-right-hover-rot: 2.6deg;
  }

  .folder-stack__item:nth-child(4n) {
    --preview-mobile-x: 9px;
    --preview-mobile-rot: -1.35deg;
    --preview-mobile-spread: 60px;
    --preview-mobile-lift: 38px;
    --preview-center-rest-x: 6px;
    --preview-center-rest-rot: -0.5deg;
    --preview-left-rest-x: 80px;
    --preview-left-rest-rot: -2.2deg;
    --preview-right-rest-x: 74px;
    --preview-right-rest-rot: 3deg;
    --preview-center-hover-x: 2px;
    --preview-center-hover-rot: -0.1deg;
    --preview-left-hover-x: 88px;
    --preview-left-hover-rot: -1.8deg;
    --preview-right-hover-x: 78px;
    --preview-right-hover-rot: 2.2deg;
  }

  .folder-stack__item + .folder-stack__item {
    margin-top: calc(-1 * var(--folder-overlap) + var(--folder-gap));
  }

  /* The stack relaxation happens on the LI (so hover lift on the link never fights it). */
  .folder-stack__item {
    transform: translate3d(0, 0, 0);
    will-change: transform;
  }

  /* Pre-state: start a bit tighter before the list animates in. */
  .folder-stack.is-pre .folder-stack__item {
    transform: translate3d(0, calc(-1 * (var(--stack-compress-step) * var(--i, 0))), 0);
  }

  @keyframes folder-stack-relax {
    0% {
      transform: translate3d(0, calc(-1 * (var(--stack-compress-step) * var(--i, 0))), 0);
    }

    72% {
      transform: translate3d(0, 2px, 0);
    }

    100% {
      transform: translate3d(0, 0, 0);
    }
  }

  /* Run once: while relaxing */
  .folder-stack.is-relaxing .folder-stack__item {
    animation: folder-stack-relax 720ms cubic-bezier(0.22, 1, 0.36, 1) both;
    animation-delay: calc(var(--i, 0) * 75ms);
  }

  /*
    Visual card (the actual Folder markup) + an invisible, clipped hit-area link.
    The hit-area is clipped to the real folder SVG path via --folder-clip-path
    (set by folder-shapes-client.ts).

    This lets the "empty" parts of the folder bounding box pass pointer events
    through to the folders below.
  */
  .folder-stack__card,
  .folder-stack__hit {
    transform: translate3d(0, 0, 0) rotateX(0deg) rotateY(0deg) rotateZ(0deg) scale(1);
    transform-origin: 50% 114%;

    /* Hover-out uses this (quick but soft). Hover-in overrides below. */
    transition: transform 300ms cubic-bezier(0.16, 1, 0.3, 1);
    will-change: transform;
    backface-visibility: hidden;
  }

  .folder-stack__card {
    display: block;
    /* Important: don't block clicks in transparent corners. */
    pointer-events: none;
    position: relative;
    z-index: calc(var(--i, 0) * 2 + 2);
  }

  /* Ensure the whole visual subtree is non-interactive (overlay link handles all hits). */
  .folder-stack__card * {
    pointer-events: none;
  }

  .folder-stack__hit {
    position: absolute;
    inset: 0;
    z-index: calc(var(--i, 0) * 2 + 3);

    display: block;
    text-decoration: none;
    cursor: pointer;
    touch-action: manipulation;
    outline: none;

    /* Re-enable events (the parent LI is pointer-events:none) */
    pointer-events: auto;

    /* Only clickable where the folder is actually visible. */
    -webkit-clip-path: var(--folder-clip-path, none);
    clip-path: var(--folder-clip-path, none);
  }


  .folder-stack__preview-stack {
    position: absolute;
    left: 50%;
    top: 28px;
    width: 100%;
    height: 0;
    transform: translateX(-50%);
    pointer-events: none;
    z-index: calc(var(--i, 0) * 2 + 1);
    overflow: visible;
  }


  .folder-stack__item:first-child .folder-stack__preview-stack {
    top: 18px;
  }

  .folder-stack__preview {
    position: absolute;
    left: 50%;
    top: 0;
    width: 54%;
    aspect-ratio: 4 / 3;
    display: block;
    transform: translate3d(-50%, 40px, 0) scale(0.32);
    transform-origin: 50% 100%;
    opacity: 0;
    visibility: hidden;
    pointer-events: auto;
    will-change: transform;
    text-decoration: none;
    transition: transform 180ms cubic-bezier(0.16, 1, 0.3, 1);
  }

  .folder-stack__preview:focus-visible {
    outline: none;
  }

  .folder-stack__preview[data-preview-index='0'] {
    z-index: 2;
    transition-delay: 0ms;
    transform: translateX(calc(-50% + var(--preview-center-hover-x)))
      translateY(calc(var(--preview-center-hover-y) + 240px)) scale(0.58) rotate(var(--preview-center-hover-rot));
  }

  .folder-stack__preview[data-preview-index='1'] {
    z-index: 1;
    transition-delay: 10ms;
    transform: translateX(calc(-50% - var(--preview-left-hover-x)))
      translateY(calc(var(--preview-left-hover-y) + 240px)) scale(0.58) rotate(var(--preview-left-hover-rot));
  }

  .folder-stack__preview[data-preview-index='2'] {
    z-index: 1;
    transition-delay: 20ms;
    transform: translateX(calc(-50% + var(--preview-right-hover-x)))
      translateY(calc(var(--preview-right-hover-y) + 240px)) scale(0.58) rotate(var(--preview-right-hover-rot));
  }

  @media (max-width: 768px) {
    .folder-stack__preview-stack {
      display: block;
      top: 18px;
      width: 100%;
      pointer-events: none;
    }

    .folder-stack__item:first-child .folder-stack__preview-stack {
      top: 12px;
    }

    .folder-stack__item {
      --folder-hover-rx: 0deg;
      --folder-hover-z: 0px;
      --preview-mobile-y-shift: 24px;
      perspective: none;
    }

    .folder-stack__item::before {
      content: '';
      position: absolute;
      top: 34px;
      left: calc(var(--folder-pad-x) - 16px);
      width: 4px;
      height: 26px;
      border-radius: 999px;
      background: var(--color-text);
      opacity: 0;
      transform: translateY(2px) scaleY(0.94);
      transition:
        opacity 150ms cubic-bezier(0.16, 1, 0.3, 1),
        transform 150ms cubic-bezier(0.16, 1, 0.3, 1);
    }

    .folder-stack__item[data-active='true']::before {
      opacity: 0.82;
      transform: translateY(0) scaleY(1);
    }

    /* ===== NUCLEAR: kill ALL hover/focus/active visual effects on mobile ===== */
    .folder-stack__item [data-folder],
    .folder-stack__hit:hover ~ .folder-stack__card [data-folder],
    .folder-stack__item:focus-within [data-folder],
    .folder-stack__item[data-hovered-preview] [data-folder],
    .folder-stack__item[data-preview-open='true'] [data-folder] {
      --folder-fill: var(--folder-base-fill, var(--color-bg)) !important;
      --folder-shadow-filter: none !important;
    }

    /* Selected: keep fill color but no hover transform */
    .folder-stack__item[data-active='true'] [data-folder] {
      --folder-fill: var(--folder-hover-fill, color-mix(in srgb, var(--color-bg) 92%, var(--color-text) 8%)) !important;
      --folder-shadow-filter: none !important;
    }

    .folder-stack__card,
    .folder-stack__hit,
    .folder-stack__hit:hover,
    .folder-stack__hit:active,
    .folder-stack__hit:focus,
    .folder-stack__hit:hover ~ .folder-stack__card,
    .folder-stack__hit:active ~ .folder-stack__card,
    .folder-stack__item:focus-within .folder-stack__card,
    .folder-stack__item:focus-within .folder-stack__hit,
    .folder-stack__item[data-hovered-preview] .folder-stack__card,
    .folder-stack__item[data-hovered-preview] .folder-stack__hit {
      transition: none !important;
      transform: none !important;
      will-change: auto;
    }

    .folder-stack__hit {
      -webkit-tap-highlight-color: transparent;
    }

    .folder-stack__item[data-active='true'] :is(.folder-stack__card, .folder-stack__hit) {
      transform: translate3d(0, -1.5px, 0) scale(1.001) !important;
      transition: transform 180ms cubic-bezier(0.22, 1, 0.36, 1) !important;
    }

    .folder-stack__preview {
      width: 48%;
      opacity: 0;
      visibility: visible;
      pointer-events: none;
      transition:
        opacity 100ms cubic-bezier(0.16, 1, 0.3, 1),
        transform 280ms cubic-bezier(0.16, 1, 0.3, 1) !important;
      will-change: auto;
    }

    .folder-stack__preview[data-preview-index='0'] {
      z-index: 3;
      opacity: 0;
      transform: translateX(calc(-50% + var(--preview-mobile-x))) translateY(calc(-96px + var(--preview-mobile-lift) + var(--preview-mobile-y-shift)))
        scale(0.995) rotate(var(--preview-mobile-rot));
    }

    .folder-stack__preview[data-preview-index='1'] {
      z-index: 1;
      opacity: 0;
      transform: translateX(calc(-50% + var(--preview-mobile-x) - var(--preview-mobile-spread)))
        translateY(calc(-84px + var(--preview-mobile-lift) + var(--preview-mobile-y-shift))) scale(0.88) rotate(calc(var(--preview-mobile-rot) - 4.2deg));
    }

    .folder-stack__preview[data-preview-index='2'] {
      z-index: 2;
      opacity: 0;
      transform: translateX(calc(-50% + var(--preview-mobile-x) + calc(var(--preview-mobile-spread) * 0.92)))
        translateY(calc(-76px + var(--preview-mobile-lift) + var(--preview-mobile-y-shift))) scale(0.84) rotate(calc(var(--preview-mobile-rot) + 4.6deg));
    }

    .folder-stack__item[data-preview-open='true'] .folder-stack__preview[data-preview-index='0'] {
      opacity: 1 !important;
      transform: translateX(calc(-50% + var(--preview-mobile-x))) translateY(calc(-132px + var(--preview-mobile-y-shift))) scale(1)
        rotate(var(--preview-mobile-rot)) !important;
    }

    .folder-stack__item[data-preview-open='true'] .folder-stack__preview[data-preview-index='1'] {
      opacity: 1 !important;
      visibility: visible !important;
      transform: translateX(calc(-50% + var(--preview-mobile-x) - var(--preview-mobile-spread)))
        translateY(calc(-114px + var(--preview-mobile-y-shift))) scale(0.9) rotate(calc(var(--preview-mobile-rot) - 4.2deg)) !important;
    }

    .folder-stack__item[data-preview-open='true'] .folder-stack__preview[data-preview-index='2'] {
      opacity: 1 !important;
      visibility: visible !important;
      transform: translateX(calc(-50% + var(--preview-mobile-x) + calc(var(--preview-mobile-spread) * 0.92)))
        translateY(calc(-104px + var(--preview-mobile-y-shift))) scale(0.86) rotate(calc(var(--preview-mobile-rot) + 4.6deg)) !important;
    }

    .folder-stack__item[data-preview-count='2'] .folder-stack__preview[data-preview-index='0'] {
      transform: translateX(calc(-50% + var(--preview-mobile-x))) translateY(calc(-86px + var(--preview-mobile-lift) + var(--preview-mobile-y-shift)))
        scale(0.995) rotate(var(--preview-mobile-rot));
    }

    .folder-stack__item[data-preview-count='2'] .folder-stack__preview[data-preview-index='1'] {
      transform: translateX(calc(-50% + var(--preview-mobile-x) - calc(var(--preview-mobile-spread) * 0.86)))
        translateY(calc(-74px + var(--preview-mobile-lift) + var(--preview-mobile-y-shift))) scale(0.9) rotate(calc(var(--preview-mobile-rot) - 3.8deg));
    }

    .folder-stack__item[data-preview-count='2'][data-preview-open='true'] .folder-stack__preview[data-preview-index='0'] {
      transform: translateX(calc(-50% + var(--preview-mobile-x))) translateY(calc(-122px + var(--preview-mobile-y-shift))) scale(1)
        rotate(var(--preview-mobile-rot)) !important;
    }

    .folder-stack__item[data-preview-count='2'][data-preview-open='true'] .folder-stack__preview[data-preview-index='1'] {
      opacity: 1 !important;
      transform: translateX(calc(-50% + var(--preview-mobile-x) - calc(var(--preview-mobile-spread) * 0.86)))
        translateY(calc(-102px + var(--preview-mobile-y-shift))) scale(0.91) rotate(calc(var(--preview-mobile-rot) - 3.8deg)) !important;
    }

    .folder-stack__preview-frame {
      transition: none !important;
      padding: 4px;
      padding-bottom: 8px;
      background: var(--color-bg);
      border: 1px solid color-mix(in srgb, var(--color-text) 6%, transparent);
      border-radius: 4px;
    }

    .folder-stack__preview-img {
      filter: saturate(0.96) contrast(0.98);
    }

    .folder-stack__tail-mask {
      display: none;
    }
  }

  .folder-stack__preview-frame {
    width: 100%;
    height: 100%;
    padding: 4px;
    padding-bottom: 8px;
    background: var(--color-bg);
    border: 1px solid color-mix(in srgb, var(--color-text) 6%, transparent);
    border-radius: 4px;
  }

  .folder-stack__preview-media {
    position: relative;
    width: 100%;
    height: 100%;
    overflow: hidden;
    border-radius: 2px;
    background: color-mix(in srgb, var(--color-bg) 86%, var(--color-text) 14%);
  }

  .folder-stack__preview-img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    opacity: 0;
    transition: opacity 120ms cubic-bezier(0.16, 1, 0.3, 1);
    background: color-mix(in srgb, var(--color-bg) 88%, var(--color-text) 12%);
  }

  .folder-stack__preview-img[src] {
    opacity: 1;
  }

  .folder-stack__preview[data-preview-open='true'] {
    visibility: visible;
  }

  /* Active (touch) also lifts (no tilt on mobile scroll-active) */
  .folder-stack__item[data-active='true'] :is(.folder-stack__card, .folder-stack__hit) {
    transform: translate3d(0, calc(-1 * var(--folder-lift)), 0) rotateX(0deg) rotateY(0deg) rotateZ(0deg)
      scale(1.004);
  }

  /* Hover tilt only on devices that truly hover (and only inside the clipped hit area) */
  @media (hover: hover) and (pointer: fine) {
    .folder-stack__hit:hover,
    .folder-stack__hit:hover ~ .folder-stack__card,
    .folder-stack__item[data-hovered-preview] .folder-stack__hit,
    .folder-stack__item[data-hovered-preview] .folder-stack__card {
      transform: translate3d(0, calc(-1 * var(--folder-lift)), var(--folder-hover-z))
        rotateX(var(--folder-hover-rx)) rotateY(var(--folder-hover-ry)) rotateZ(var(--folder-hover-rz))
        scale(1.0005);

      transition-duration: 200ms;
      transition-timing-function: cubic-bezier(0.16, 1, 0.3, 1);
    }

    /* Hover fill nudge (desktop only) */
    .folder-stack__hit:hover ~ .folder-stack__card [data-folder],
    .folder-stack__item[data-hovered-preview] [data-folder] {
      --folder-fill: var(--folder-hover-fill, color-mix(in srgb, var(--color-bg) 92%, var(--color-text) 8%));
      --folder-shadow-filter:
        drop-shadow(0 -8px 16px color-mix(in srgb, var(--folder-shadow-ink, var(--color-text)) 2.1%, transparent))
        drop-shadow(0 -2px 5px color-mix(in srgb, var(--folder-shadow-ink, var(--color-text)) 0.9%, transparent));
    }
  }

  /* Keyboard focus tilt (desktop only — tap focus on mobile triggers this unwantedly) */
  @media (hover: hover) and (pointer: fine) {
    .folder-stack__item:focus-within :is(.folder-stack__card, .folder-stack__hit) {
      transform: translate3d(0, calc(-1 * var(--folder-lift)), var(--folder-hover-z))
        rotateX(var(--folder-hover-rx)) rotateY(var(--folder-hover-ry)) rotateZ(var(--folder-hover-rz))
        scale(1.0005);

      transition-duration: 200ms;
      transition-timing-function: cubic-bezier(0.16, 1, 0.3, 1);
    }
  }


  .folder-stack__item[data-preview-open='true'] .folder-stack__preview[data-preview-index='0'] {
    opacity: 1;
    visibility: visible;
    transform: translateX(calc(-50% + var(--preview-center-hover-x))) translateY(var(--preview-center-hover-y))
      scale(0.58) rotate(var(--preview-center-hover-rot));
  }

  .folder-stack__item[data-preview-open='true'] .folder-stack__preview[data-preview-index='1'] {
