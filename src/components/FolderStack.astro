---
interface Props {
  /**
   * How much each folder overlaps the previous one.
   * (Bigger = tighter stack)
   */
  overlap?: string;
  /** Small positive spacing added back so the stack can breathe. */
  gap?: string;
  /** Lift amount on hover/focus/active */
  lift?: string;
}

const { overlap, gap, lift } = Astro.props;

const styleParts: string[] = [];
if (overlap) styleParts.push(`--folder-overlap:${overlap}`);
if (gap) styleParts.push(`--folder-gap:${gap}`);
if (lift) styleParts.push(`--folder-lift:${lift}`);

const style = styleParts.length ? styleParts.join('; ') : undefined;
---

<ul
  class="folder-stack"
  data-folder-stack
  style={style}
>
  <slot />
</ul>

<style is:global>
  /* Folder stack: overlapping pile with subtle randomness + micro-interactions */
  .folder-stack {
    /* Defaults (can be overridden by inline CSS vars via props) */
    --folder-overlap: 260px;
    --folder-gap: 38px;
    /* Separate more on hover */
    --folder-lift: 14px;

    /* How much “tighter” the stack starts before it relaxes into place */
    --stack-compress-step: 12px;

    /* Make this an offset context so item.offsetTop is stable & transform-independent. */
    position: relative;

    list-style: none;
    padding: 0;
    margin: 0;
  }

  @media (max-width: 640px) {
    .folder-stack {
      --folder-overlap: 230px;
      --folder-gap: 30px;
      --folder-lift: 12px;
      --stack-compress-step: 10px;
    }
  }

  @media (max-width: 420px) {
    .folder-stack {
      --folder-overlap: 210px;
      --folder-gap: 26px;
      --folder-lift: 10px;
      --stack-compress-step: 8px;
    }
  }

  /* Shadow: almost invisible while stacked (avoid a dark band), comes alive on hover. */
  .folder-stack [data-folder] {
    /* Near-transparent at rest: should read as “almost none”. */
    --folder-shadow-filter:
      drop-shadow(0 -3px 8px color-mix(in srgb, var(--color-text) 0.45%, transparent))
      drop-shadow(0 -1px 2px color-mix(in srgb, var(--color-text) 0.18%, transparent));
  }

  .folder-stack__item {
    position: relative;

    /* No tilt / no sideways drift */
    --stack-x: 0px;
    --stack-y: 0px;
    --stack-rot: 0deg;
  }

  .folder-stack__item + .folder-stack__item {
    margin-top: calc(-1 * var(--folder-overlap) + var(--folder-gap));
  }

  /* The stack relaxation happens on the LI (so hover lift on the link never fights it). */
  .folder-stack__item {
    transform: translate3d(0, 0, 0);
    will-change: transform;
  }

  /* Pre-state: start a bit tighter before the list animates in. */
  .folder-stack.is-pre .folder-stack__item {
    transform: translate3d(0, calc(-1 * (var(--stack-compress-step) * var(--i, 0))), 0);
  }

  @keyframes folder-stack-relax {
    0% {
      transform: translate3d(0, calc(-1 * (var(--stack-compress-step) * var(--i, 0))), 0);
    }

    72% {
      transform: translate3d(0, 2px, 0);
    }

    100% {
      transform: translate3d(0, 0, 0);
    }
  }

  /* Run once: while relaxing */
  .folder-stack.is-relaxing .folder-stack__item {
    animation: folder-stack-relax 720ms cubic-bezier(0.22, 1, 0.36, 1) both;
    animation-delay: calc(var(--i, 0) * 75ms);
  }

  .folder-stack__link {
    display: block;
    text-decoration: none;

    /* Hover lift lives here, separate from stack relax */
    transform: translate3d(0, 0, 0) scale(1);
    transform-origin: 50% 90%;

    transition: transform 200ms cubic-bezier(0.23, 1, 0.32, 1);
    will-change: transform;
    backface-visibility: hidden;
  }

  /* Active (touch) also lifts */
  .folder-stack__item[data-active='true'] .folder-stack__link {
    transform: translate3d(0, calc(-1 * var(--folder-lift)), 0) scale(1.004);
  }

  /* Hover + focus lift only on devices that truly hover */
  @media (hover: hover) and (pointer: fine) {
    .folder-stack__item:hover .folder-stack__link {
      transform: translate3d(0, calc(-1 * var(--folder-lift)), 0) scale(1.004);
    }
  }

  .folder-stack__item:focus-within .folder-stack__link {
    transform: translate3d(0, calc(-1 * var(--folder-lift)), 0) scale(1.004);
  }

  .folder-stack__link:active {
    transform: translate3d(0, calc(-1 * (var(--folder-lift) - 2px)), 0) scale(1.002);
  }

  /* Delight: subtle fill nudge + shadow ramps up only when a folder is “picked up”. */
  .folder-stack__item:hover [data-folder],
  .folder-stack__item:focus-within [data-folder],
  .folder-stack__item[data-active='true'] [data-folder] {
    --folder-fill: color-mix(in srgb, var(--color-bg) 95%, var(--color-text) 5%);
    --folder-shadow-filter:
      drop-shadow(0 -8px 16px color-mix(in srgb, var(--color-text) 3.2%, transparent))
      drop-shadow(0 -2px 5px color-mix(in srgb, var(--color-text) 1.4%, transparent));
  }

  @media (prefers-reduced-motion: reduce) {
    .folder-stack__item {
      animation: none !important;
      transform: none !important;
    }

    .folder-stack__link {
      transition: none;
      transform: none !important;
    }
  }
</style>

<script>
  import '../scripts/folder-stack-client';
</script>
