---
interface Props {
  title: string;
  description?: string;
  className?: string;
}

const { title, description, className = '' } = Astro.props;
---

<div class={`relative ${className}`} data-folder>
  <div data-folder-shell class="relative">
    <svg
      data-folder-svg
      height="400"
      class="block w-full"
      aria-hidden="true"
      preserveAspectRatio="none"
    >
      <!-- Fill only -->
      <path data-folder-fill-path fill="var(--folder-fill, var(--color-bg))"></path>
    </svg>

    <!-- Text overlay (doesn't affect layout; JS will grow the SVG when needed) -->
    <div data-folder-text-layer class="pointer-events-none absolute inset-0">
      <div
        data-folder-label
        class="absolute left-[24px] top-[20px] text-text font-display text-2xl sm:text-3xl md:text-4xl leading-[1.1] tracking-tight font-normal whitespace-nowrap"
      >
        {title}
      </div>

      {
        description && (
          <div
            data-folder-description
            class="absolute left-[24px] top-[78px] md:top-[92px] right-[24px] text-muted font-sans text-base leading-[1.55]"
          >
            {description}
          </div>
        )
      }
    </div>
  </div>
</div>

<style>
  [data-folder] {
    /* Minimum folder height; JS can grow it beyond this based on content wrapping */
    --folder-min-h: 400px;
  }

  @media (max-width: 640px) {
    [data-folder] {
      --folder-min-h: 360px;
    }
  }

  @media (max-width: 420px) {
    [data-folder] {
      --folder-min-h: 340px;
    }
  }

  /* Clip: permite que la sombra salga por arriba y a los lados,
     pero corta cualquier blur que intente “caer” debajo del folder. */
  [data-folder-shell] {
    /* Deja respirar la sombra arriba y a los lados, pero la mantiene “apretada”. */
    clip-path: inset(-56px -88px 0 -88px);
  }

  [data-folder-fill-path] {
    transition: fill 220ms cubic-bezier(0.2, 0, 0, 1);
  }

  /* Sombra hacia arriba (overrideable from outside via --folder-shadow-filter) */
  [data-folder-svg] {
    transition: filter 220ms cubic-bezier(0.2, 0, 0, 1);
    will-change: filter;

    filter: var(
      --folder-shadow-filter,
      drop-shadow(0 -7px 13px color-mix(in srgb, var(--color-text) 5%, transparent))
        drop-shadow(0 -2px 4px color-mix(in srgb, var(--color-text) 2.5%, transparent))
    );
  }

  @media (prefers-reduced-motion: reduce) {
    [data-folder-fill-path],
    [data-folder-svg] {
      transition: none;
    }
  }
</style>

<script is:inline>
  (function () {
    // Run once per page.
    if (window.__folderShapesInit) return;
    window.__folderShapesInit = true;

    const config = {
      flapHeight: 60,
      bottomPadding: 26,

      // Geometry tuned for the wide desktop container.
      desktop: {
        padding: 56,
        flapCurve: 72,
        topLeftRadius: 48,
        rightInset: 56,
        rightDrop: 44,
      },

      // Mobile gets a tighter curve + less padding so the flap can fit inside
      // narrow containers *without* making the SVG viewBox wider than the element.
      // (If the viewBox is wider, the SVG scales down but the HTML label doesn't,
      // and the flap stops lining up with the text.)
      mobile: {
        padding: 34,
        flapCurve: 52,
        topLeftRadius: 44,
        rightInset: 46,
        rightDrop: 40,
      },
    };

    function updateShape(root) {
      const label = root.querySelector('[data-folder-label]');
      const description = root.querySelector('[data-folder-description]');
      const svg = root.querySelector('[data-folder-svg]');
      const fillPath = root.querySelector('[data-folder-fill-path]');
      if (!label || !svg || !fillPath) return;

      // --- Height (grow based on content) ---
      const styles = getComputedStyle(root);
      const minH = Number.parseFloat(styles.getPropertyValue('--folder-min-h')) || 200;

      const labelBottom = label.offsetTop + label.offsetHeight;
      const descriptionBottom = description ? description.offsetTop + description.offsetHeight : 0;
      const contentBottom = Math.max(labelBottom, descriptionBottom);

      const desiredSvgHeight = Math.max(minH, Math.ceil(contentBottom + config.bottomPadding));
      const prevHeight = Number(svg.getAttribute('height')) || 0;
      if (desiredSvgHeight !== prevHeight) {
        svg.setAttribute('height', String(desiredSvgHeight));
      }

      // --- Width / shape ---
      const flapStart = 24;

      // IMPORTANT: the SVG is `w-full` (scaled to the container) while the title is
      // HTML text positioned in CSS pixels. If the SVG viewBox is wider than the
      // rendered element, the SVG scales down but the label doesn't → the flap
      // width/position stops matching the title (most noticeable on mobile).
      const rootWidth = Math.round(root.getBoundingClientRect().width) || 0;
      if (!rootWidth) return;

      const m = rootWidth <= 640 ? config.mobile : config.desktop;

      // Ensure the flap fits *inside* the element.
      const minFlapEnd = flapStart + m.topLeftRadius + m.flapCurve + 14;
      const maxFlapEnd = Math.max(minFlapEnd, rootWidth - m.rightInset - m.flapCurve);
      const maxLabelWidth = Math.max(48, maxFlapEnd - flapStart - m.padding);

      // Keep the label bounded so its measured width can't force an impossible flap.
      // (Titles here are short; this mainly protects edge cases.)
      label.style.maxWidth = `${maxLabelWidth}px`;
      label.style.overflow = 'hidden';
      label.style.textOverflow = 'ellipsis';

      const textWidth = Math.min(label.offsetWidth, maxLabelWidth);
      const flapEnd = Math.max(minFlapEnd, flapStart + textWidth + m.padding);

      // 1 SVG unit == 1 CSS pixel (prevents scaling mismatch with the HTML overlay).
      const totalWidth = rootWidth;
      const svgHeight = Number(svg.getAttribute('height')) || desiredSvgHeight;
      svg.setAttribute('viewBox', `0 0 ${totalWidth} ${svgHeight}`);

      // Bottom equals SVG height. (We keep the flap height fixed; the body grows.)
      const bottomY = svgHeight;

      // Curve control points derived from flapCurve (keeps proportions consistent).
      const c1 = Math.round(m.flapCurve * 0.56);
      const c2 = Math.round(m.flapCurve * 0.17);
      const c3 = Math.round(m.flapCurve * 0.06);
      const c4 = Math.round(m.flapCurve * 0.25);
      const c5 = Math.round(m.flapCurve * 0.5);

      const dFill = `
        M0 ${config.flapHeight}

        Q0 0 ${m.topLeftRadius} 0
        H ${flapEnd - m.flapCurve}

        C ${flapEnd - c1} 0,
          ${flapEnd - c2} 6,
          ${flapEnd + c3} 20

        C ${flapEnd + c4} 34,
          ${flapEnd + c5} ${config.flapHeight - 4},
          ${flapEnd + m.flapCurve} ${config.flapHeight}

        H ${totalWidth - m.rightInset}

        Q ${totalWidth} ${config.flapHeight}
          ${totalWidth} ${config.flapHeight + m.rightDrop}

        V ${bottomY}
        H 0
        Z
      `;

      fillPath.setAttribute('d', dFill);
    }

    function initAll() {
      const roots = document.querySelectorAll('[data-folder]');

      roots.forEach((root) => {
        if (root.dataset.folderInit === 'true') return;
        root.dataset.folderInit = 'true';

        const run = () => updateShape(root);
        run();

        const label = root.querySelector('[data-folder-label]');
        const description = root.querySelector('[data-folder-description]');

        const ro = new ResizeObserver(run);
        if (label) ro.observe(label);
        if (description) ro.observe(description);
        ro.observe(root);

        // store for potential future cleanup
        root.__folderResizeObserver = ro;

        window.addEventListener('resize', run);
      });
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', initAll, { once: true });
    } else {
      initAll();
    }

    document.addEventListener('astro:page-load', initAll);
  })();
</script>
