---
interface Props {
  title: string;
  description?: string;
  className?: string;
}

const { title, description, className = '' } = Astro.props;
const folderPath = 'M0 60 Q0 0 12 0 H34 C45 0 45 35 58 60 H86 Q100 60 100 104 V392 Q100 400 98 400 H2 Q0 400 0 392 V60 Z';
---

<div class={`relative ${className}`} data-folder>
  <div data-folder-shell class="relative">
    <svg
      data-folder-svg
      height="400"
      viewBox="0 0 100 400"
      class="block w-full"
      aria-hidden="true"
      preserveAspectRatio="none"
    >
      <!-- Fill only -->
      <path data-folder-fill-path fill="var(--folder-fill, var(--folder-base-fill, var(--color-bg)))" d={folderPath}></path>
    </svg>

    <!-- Text overlay sits above the static folder shape. -->
    <div data-folder-text-layer class="pointer-events-none absolute inset-0 z-[2]">
      <div
        data-folder-label
        class="absolute left-[var(--folder-pad-x)] top-[20px] text-text font-sans text-xl sm:text-2xl md:text-3xl leading-[1.1] tracking-tight font-normal whitespace-nowrap pointer-events-auto select-text transition-colors duration-200"
      >
        {title}
      </div>

      {
        description && (
          <div
            data-folder-description
            class="absolute left-[var(--folder-pad-x)] top-[72px] md:top-[82px] right-[var(--folder-pad-x)] text-muted font-sans text-base leading-[1.55] pointer-events-auto select-text transition-colors duration-200"
          >
            {description}
          </div>
        )
      }
    </div>
  </div>
</div>

<style>
  [data-folder] {
    /* Minimum folder height; JS can grow it beyond this based on content wrapping */
    --folder-min-h: 400px;
  }

  @media (max-width: 640px) {
    [data-folder] {
      --folder-min-h: 360px;
    }
  }

  @media (max-width: 420px) {
    [data-folder] {
      --folder-min-h: 340px;
    }
  }

  @media (max-width: 768px) {
    [data-folder-shell] {
      clip-path: none;
    }
  }

  /* Clip: permite que la sombra salga por arriba y a los lados,
     pero corta cualquier blur que intente "caer" debajo del folder. */
  [data-folder-shell] {
    /* Deja respirar la sombra arriba y a los lados, pero la mantiene "apretada". */
    position: relative;
    z-index: 2;
    clip-path: inset(-56px -88px 0 -88px);
  }



  [data-folder-fill-path] {
    /* Hover color change only; theme switching is disabled globally in Base.astro */
    transition: fill 150ms ease;
  }

  /* Sombra hacia arriba (overrideable from outside via --folder-shadow-filter) */
  [data-folder-svg] {
    height: var(--folder-min-h);
    transition: filter 180ms cubic-bezier(0.23, 1, 0.32, 1);

    filter: var(
      --folder-shadow-filter,
      drop-shadow(0 -7px 13px color-mix(in srgb, var(--folder-shadow-ink, var(--color-text)) 5%, transparent))
        drop-shadow(0 -2px 4px color-mix(in srgb, var(--folder-shadow-ink, var(--color-text)) 2.5%, transparent))
    );
  }

  @media (max-width: 768px) {
    [data-folder-fill-path],
    [data-folder-svg] {
      transition: none !important;
    }

    [data-folder-svg] {
      filter: none !important;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    [data-folder-fill-path],
    [data-folder-svg] {
      transition: none;
    }
  }
</style>

