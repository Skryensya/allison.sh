---
const currentPath = Astro.url.pathname;
const isHome = currentPath === '/' || currentPath === '';
---

<header id="site-header" class="w-full sticky top-0 z-[200] pointer-events-none">
  <nav id="site-nav" aria-label="Navegación principal" class="max-w-[42rem] mx-auto px-3 md:px-8 flex justify-between items-center pt-3 pb-4 md:py-8 pointer-events-none">
    <div id="nav-logo" class="font-sans text-xl font-normal tracking-tight shrink-0">
      <!-- Desktop: link with hover effect -->
      <a href="/" class="hidden md:block text-text pointer-events-auto">
        <span class="name-wrapper">
          <span class="name-normal">Allison Peña</span>
          <span class="name-hover" id="hover-name">
            A<span class="glitch-char" data-char="/">/</span><span class="glitch-char" data-char="/">/</span>ison Peña
          </span>
        </span>
      </a>
      <!-- Mobile: button that triggers glitch on home page -->
      <button
        type="button"
        id="mobile-home-btn"
        class="md:hidden text-text pointer-events-auto bg-transparent border-none cursor-pointer inline-flex items-center justify-start min-h-11 min-w-11 -ml-2 pl-2 pr-2 rounded-md motion-safe:active:scale-[0.96] motion-safe:transition-transform"
        data-is-home={isHome ? 'true' : 'false'}
      >
        <span class="name-wrapper">
          <span class="name-normal">Allison Peña</span>
          <span class="name-hover" id="mobile-hover-name">
            A<span class="mobile-glitch-char" data-char="/">/</span><span class="mobile-glitch-char" data-char="/">/</span>ison Peña
          </span>
        </span>
      </button>
    </div>
    <div id="nav-links" class="flex items-center gap-4 md:gap-6 pointer-events-auto">
      <a href={isHome ? '#proyectos' : '/#proyectos'} class="hidden md:inline-flex font-sans text-[0.98rem] font-normal tracking-[0.01em] text-muted hover:text-text">work</a>
      <a href="/#sobre-mi" class="hidden md:inline-flex font-sans text-[0.98rem] font-normal tracking-[0.01em] text-muted hover:text-text">about</a>
      <a href="/#contacto" class="hidden md:inline-flex font-sans text-[0.98rem] font-normal tracking-[0.01em] text-muted hover:text-text">contact</a>
    </div>
  </nav>
</header>
