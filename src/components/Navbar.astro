---
interface Props {
  showBack?: boolean;
}

const { showBack = false } = Astro.props;
---

<header id="site-header" class="w-full sticky top-0 z-[200] pointer-events-none">
  <nav id="site-nav" aria-label="Navegación principal" class="max-w-[58ch] mx-auto px-6 md:px-8 flex justify-between items-center py-4 md:py-8 pointer-events-none">
    <div id="nav-logo" class="font-sans text-xl font-normal tracking-tight shrink-0">
      <a href="/" class="text-text pointer-events-auto">
        <span class="name-wrapper">
          <span class="name-normal">Allison Peña</span>
          <span class="name-hover" id="hover-name">
            A<span class="glitch-char" data-char="/">/</span><span class="glitch-char" data-char="/">/</span>ison Peña
          </span>
        </span>
      </a>
    </div>
    <div id="nav-links" class="flex items-center gap-4 md:gap-6 pointer-events-auto">
      <a href="/#proyectos" class="hidden md:inline-flex font-sans text-base font-normal tracking-[0.01em] text-text">work</a>
      <a href="/#sobre-mi" class="hidden md:inline-flex font-sans text-base font-normal tracking-[0.01em] text-text">about</a>
      <a href="/#contacto" class="hidden md:inline-flex font-sans text-base font-normal tracking-[0.01em] text-text">contact</a>
    </div>
  </nav>
</header>
