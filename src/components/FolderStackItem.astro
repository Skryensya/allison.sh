---
interface Props {
  href: string;
  index: number;
  ariaLabel?: string;
  previewSrcs?: string[];
  previewAlt?: string;
}

const { href, index, ariaLabel, previewSrcs = [], previewAlt } = Astro.props;
const previewCount = Math.min(previewSrcs.length, 3);
---

<li class="folder-stack__item" data-folder-stack-item data-preview-count={previewCount} style={`--i:${index}`}>
  <a
    href={href}
    class="folder-stack__hit"
    data-folder-hit
    aria-label={ariaLabel ?? 'Open project'}
  ></a>

  {
    previewSrcs.length > 0 && (
      <div class="folder-stack__preview-stack">
        {previewSrcs.slice(0, 3).map((src, i) => (
          <a
            href={href}
            class="folder-stack__preview"
            data-preview-index={i}
            aria-label={ariaLabel ?? `Open project preview ${i + 1}`}
          >
            <div class="folder-stack__preview-frame">
              <div class="folder-stack__preview-media">
                <img
                  class="folder-stack__preview-img"
                  data-folder-preview-img
                  data-src={src}
                  alt={previewAlt ?? ''}
                  loading="lazy"
                  decoding="async"
                />
              </div>
            </div>
          </a>
        ))}
      </div>
    )
  }

  <div class="folder-stack__card" data-folder-card>
    <slot />
  </div>
</li>
