---
interface Props {
  href: string;
  index: number;
  /** Optional label for screen readers (falls back to generic) */
  ariaLabel?: string;
}

const { href, index, ariaLabel } = Astro.props;
---

<li class="folder-stack__item" data-folder-stack-item style={`--i:${index}`}
>
  <!--
    Hit-area overlay.
    We clip this link to the actual folder SVG path (set by folder-shapes-client.ts)
    so clicks/hover only register on the visible folder, and empty corners
    pass through to the folders below.

    NOTE: This element has no visuals; it won't clip shadows.
  -->
  <a
    href={href}
    class="folder-stack__hit"
    data-folder-hit
    aria-label={ariaLabel ?? 'Open project'}
  ></a>

  <div class="folder-stack__card" data-folder-card>
    <slot />
  </div>
</li>
