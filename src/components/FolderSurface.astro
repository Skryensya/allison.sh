---
interface Props {
  title: string;
  description?: string;
  titleTag?: 'div' | 'h1' | 'h2';
  className?: string;
  rootClassName?: string;
  titleClassName?: string;
  descriptionClassName?: string;
  gradient?: boolean;
  gradientClassName?: string;
  minHeight?: string;
  active?: boolean;
  year?: string;
  metaSlotClassName?: string;
  gradientId?: string;
}

const {
  title,
  description,
  titleTag = 'div',
  className = '',
  rootClassName = '',
  titleClassName = '',
  descriptionClassName = '',
  gradient = false,
  gradientClassName = '',
  minHeight,
  active = false,
  year,
  metaSlotClassName = '',
  gradientId = `folder-surface-fill-${Math.random().toString(36).slice(2, 10)}`,
} = Astro.props;

const TitleTag = titleTag;
const styleParts: string[] = [];
if (minHeight) styleParts.push(`--folder-min-h:${minHeight}`);
const style = styleParts.length ? styleParts.join('; ') : undefined;

const yearTopClass = description ? 'top-[128px] md:top-[136px]' : 'top-[84px] md:top-[92px]';
const folderPath = 'M0 60 Q0 0 12 0 H34 C45 0 45 35 58 60 H86 Q100 60 100 104 V392 Q100 400 98 400 H2 Q0 400 0 392 V60 Z';
---

<div class={`folder-surface ${rootClassName} ${className}`.trim()} data-folder data-active={active ? 'true' : undefined} style={style}>
  {gradient && <div class={`folder-surface__gradient ${gradientClassName}`.trim()} aria-hidden="true"></div>}

  <div data-folder-shell class="folder-surface__shell relative">
    <svg
      data-folder-svg
      height="400"
      viewBox="0 0 100 400"
      class="folder-surface__svg block w-full"
      aria-hidden="true"
      preserveAspectRatio="none"
    >
      <defs>
        <linearGradient id={gradientId} x1="0" y1="0" x2="0" y2="1">
          <stop offset="0%" style={`stop-color:${active ? 'var(--folder-hover-fill-top, var(--folder-fill-top, var(--folder-base-fill, var(--color-bg))))' : 'var(--folder-fill-top, var(--folder-base-fill, var(--color-bg)))'}`} />
          <stop offset="100%" style={`stop-color:${active ? 'var(--folder-hover-fill-bottom, var(--folder-fill-bottom, var(--folder-base-fill, var(--color-bg))))' : 'var(--folder-fill-bottom, var(--folder-base-fill, var(--color-bg)))'}`} />
        </linearGradient>
      </defs>
      <path data-folder-fill-path fill={`url(#${gradientId})`} d={folderPath}></path>
    </svg>

    <div data-folder-text-layer class="folder-surface__text-layer pointer-events-none absolute inset-0 z-[2]">
      <TitleTag
        data-folder-label
        class={`folder-surface__title absolute left-[var(--folder-pad-x)] top-[22px] text-text font-sans text-[1.45rem] sm:text-[1.72rem] md:text-[2.15rem] leading-[1.04] tracking-[-0.03em] font-normal whitespace-nowrap pointer-events-auto select-text ${titleClassName}`.trim()}
      >
        {title}
      </TitleTag>

      {
        description && (
          <div
            data-folder-description
            class={`folder-surface__description absolute left-[var(--folder-pad-x)] top-[76px] md:top-[86px] right-[var(--folder-pad-x)] text-muted font-sans text-[0.98rem] md:text-[1rem] leading-[1.72] tracking-[-0.005em] pointer-events-auto select-text text-pretty ${descriptionClassName}`.trim()}
          >
            {description}
          </div>
        )
      }

      {year && (
        <p
          class={`folder-surface__meta absolute left-[var(--folder-pad-x)] ${yearTopClass} font-mono text-[0.72rem] uppercase tracking-[0.16em] text-subtle ${metaSlotClassName}`.trim()}
        >
          {year}
        </p>
      )}

    </div>
  </div>
</div>

<style>
  .folder-surface {
    --folder-base-fill: var(--color-bg);
    --folder-accent-default: var(--color-link);
    --folder-fill-top: var(--folder-base-fill);
    --folder-fill-bottom: var(--folder-base-fill);
    --folder-hover-fill-top: color-mix(in srgb, var(--folder-base-fill) 82%, var(--folder-accent, var(--folder-accent-default)) 18%);
    --folder-hover-fill-bottom: color-mix(in srgb, var(--folder-base-fill) 93%, var(--folder-accent, var(--folder-accent-default)) 7%);
    --folder-min-h: 400px;
  }

  .folder-surface__shell {
    position: relative;
    z-index: 2;
    clip-path: inset(-56px -88px 0 -88px);
  }

  .folder-surface__gradient {
    position: absolute;
    left: -10%;
    right: -10%;
    bottom: 0;
    width: 120%;
    height: 100%;
    background: linear-gradient(
      to bottom,
      transparent 0%,
      transparent 40%,
      color-mix(in srgb, var(--color-bg) 40%, transparent) 55%,
      color-mix(in srgb, var(--color-bg) 80%, transparent) 70%,
      var(--color-bg) 80% 100%
    );
    pointer-events: none;
    z-index: 26;
  }

  .folder-surface__title,
  .folder-surface__description {
    transition: color 150ms ease;
  }

  .folder-surface [data-folder-fill-path] {
    transition: fill 150ms ease;
  }

  .folder-surface [data-folder-svg] {
    height: var(--folder-min-h);
    transition: filter 180ms cubic-bezier(0.23, 1, 0.32, 1);
    filter: var(
      --folder-shadow-filter,
      drop-shadow(0 -7px 13px color-mix(in srgb, var(--folder-shadow-ink, var(--color-text)) 5%, transparent))
        drop-shadow(0 -2px 4px color-mix(in srgb, var(--folder-shadow-ink, var(--color-text)) 2.5%, transparent))
    );
  }

  .folder-surface__title {
    max-width: calc(100% - var(--folder-pad-x) * 2 - 3.5rem);
  }

  .folder-surface[data-active],
  .folder-surface[data-active='true'] {
    --folder-fill-top: var(--folder-hover-fill-top, var(--folder-fill-top));
    --folder-fill-bottom: var(--folder-hover-fill-bottom, var(--folder-fill-bottom));
  }

  @media (max-width: 640px) {
    .folder-surface {
      --folder-min-h: 360px;
    }
  }

  @media (max-width: 420px) {
    .folder-surface {
      --folder-min-h: 340px;
    }
  }

  @media (max-width: 768px) {
    .folder-surface [data-folder-fill-path],
    .folder-surface [data-folder-svg] {
      transition: none !important;
    }

    .folder-surface [data-folder-svg] {
      filter: none !important;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .folder-surface__title,
    .folder-surface__description,
    .folder-surface [data-folder-fill-path],
    .folder-surface [data-folder-svg] {
      transition: none !important;
    }
  }
</style>
